## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Tt]emp/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Files built by Visual Studio
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.log
*.lib
*.sbr
*.tlb
*.tli
*.tlh

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# TFS
$tf/

# Visual Studio code coverage results
*.coverage
*.coveragexml

# Publish outputs
*.Publish.xml
*.azurePubxml
publish/
_PublishedWebsites/
*.publishsettings

# Web workbench (sass, compass)
.sass-cache/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode
.JustCode

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# Packages (NuGet)
packages/
*.nupkg
# Uncomment if using NuGet.exe locally
# !packages/build/

# Azure
.csx/
*.build.csdef

# Windows Store app package
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt

# Visual Studio database projects
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publish.xml

# SQL Server files
*.mdf
*.ldf

# IIS Express
/.vs/
applicationhost.config

# Rider
.idea/

# VS Code
.vscode/

# SVN folders
.svn/

# Others
*.swp
*.bak
*.tmp
*.log
*.vspscc
*.vssscc
*.dbmdl
*.jfm
*.docstates
