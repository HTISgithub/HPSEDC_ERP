                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>              
Select fiPurchaseOrderID,fdPurchaseOrderDate,P1.fvPONO,S1.fvPONO as fvSaleOrderNo,S1.fdSaleOrderDate,P1.fnTotalAmount,P1.fnIGSTAmount,
P1.fnCGSTAmount,P1.fnSGSTAmount,P1.fnNetAmount,P1.fnRoundOffAmount,
A.AccountName, CBA.BillAddress,CBA.BillGSTIN,CSC.CityName,CSC.StateName,CBA.PostalCode,
SPA.ShippingAddress ,SPA.ShipGSTIN ,SCSC.CityName as ShipCity,SCSC.StateName ShipState,SPA.PostalCode as ShipPostalCode,'' fvEmployeeName,'' fvEmployeeCode,'' AmountInwords,A.EMail,A.MobileNo,P1.fvReferanceNo,P1.fdReferanceDate       
FROM tbPurchaseOrderPart1  P1 
JOIN tblAccounts A ON P1.fiSupplierId =A.Accountid 
Left Join tbSaleOrderPart1 S1 ON P1.fiSaleOrderId =S1.fiSaleOrderId 
Left Join tblCustomerBillAddress CBA ON P1.BillingId =CBA.ID And P1.fiSupplierId =CBA.fiCustomerId 
Left Join CountryStateCity CSC ON CBA.CityId =CSC.fiCityID 
Left Join tblCustomerShippingAddress SPA ON P1.ShippingId  =SPA.ID And P1.fiSupplierId =SPA.fiCustomerId 
Left Join CountryStateCity SCSC ON SPA.CityId =SCSC.fiCityID 
Where 1=2</CommandText>
