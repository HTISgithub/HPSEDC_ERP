        <script src="../../Scripts/pikaday.js" type="text/javascript"></script>
        <script>
            var picker1 = new Pikaday(
            {
                field: document.getElementById('AMDate'),
                firstDay: 1,
                minDate: new Date('01-1-1945'),
                maxDate: new Date('31-12-2090'),
                yearRange: [1945, 2090],
                onSelect: function () {
                    var date = document.createTextNode(this.getMoment().format('DD-MMM-YYYY') + ' ');
                    document.getElementById('AMDate').appendChild(date);
                }
            });

            picker1.setMoment(moment().dayOfYear(Date));

            _getEmployee();
            function _getEmployee() {
                $.post('/Home/GetEmployee', {
                }, function (result) {
                    $('#fiEmployeeID').html(result);

                });
            }

            function _createQuery() {
                //if ($('#AMDate').val() == '' || $('#Title').val() == '' || $('#Announcement').val() == '' || $('#fiClassId').val() == '') {
                //    alert("Please fill all fields");
                //    return;
                //}

                $.post('/Home/_QuerySave', {
                    'fiEmployeeID': $('#fiEmployeeID').val(),
                    'AMDate': $('#AMDate').val(),
                    'Title': $('#Title').val(),
                    'fvQuery': $('#fvQuery').val()
                }, function (data) {
                    GridQuery();
                    alert(data);
                });
            }
            GridQuery();
            function GridQuery() {
                $.post('/Home/GridQuery', {
                },
                function (result) {
                    $('#GridQuerys').html(result);
                });
            }
        </script>

