@using System.Data
@{
    string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
    int sr = 0;
    commonFunctions comfun = new commonFunctions();
}

<div class="dt-responsive">
    <table class="table table-striped table-bordered" id="myTable">
        <thead>
            <tr>
                <th>S No.</th>
                <th>Group Code</th>
                <th>Group Name</th>
                <th class="editcol text-center">User Mapping</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Rows)
            {
                sr = sr + 1;
            <tr>
                <td>@sr</td>
                <td>@item["GroupCode"]</td>
                <td>@item["GroupName"]</td>
                <td><a href="#" onclick="_UpdateHelpdeskGroupMapping(@(item["GroupId"].ToString()))">Mapping</a></td>
            </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function _UpdateHelpdeskGroupMapping(GroupId) {
        debugger;
        $('#myModal').modal('show');
        $('.modal-title').html('<b>Update Group Mapping for </b>');
        $('#_view').html('<img src="/content/ajax-loader.gif" class="loaderimg" />');
        $("#myModal").one('shown.bs.modal', function () {
            $.post('/Admin/_UpdateHelpDeskMapping', {
                'HelpdeskGroupId': GroupId
            }, function (data) {
                $('#_view').html(data);
            });
        });
    }
</script>