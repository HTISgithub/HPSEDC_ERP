@{
    int sno = 0;
    commonFunctions comfun = new commonFunctions();
}
<div class="dt-responsive">
    <table class="table table-striped table-bordered" id="myTable">
        <thead>
            <tr>
                <th class="widthsr">Sr.No.</th>                
                <th>Employee Id</th>
                <th>Name</th>
                <th>Department</th>
                <th>Designation</th>
                <th class="editcol text-center">View</th>                
                <th class="editcol text-center">Edit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Rows)
            {
                sno = sno + 1;
            <tr>
                <td>@sno</td>
                <td>@item["EmployeeCode"]</td>
                <td>@Html.Raw(item["EmployeeName"])</td>
                <td>@item["DepartmentName"]</td>
                <td>@item["DesignationName"]</td>
                <td class="text-center">
                    <a href="#" onclick="_GeoFenceMappingDisplayViaId(@(item["GeoFenceMappingId"]))" class="img-circle">
                        <i class="fa fa-eye fa-2x"></i>
                    </a>
                </td>
                <td class="text-center">
                    <a href="#" onclick="_Edit(@(item["GeoFenceMappingId"]))" class="img-circle">
                        <i class="fa fa-pencil-square fa-2x"></i>
                    </a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function _GeoFenceMappingDisplayViaId(GeoFenceMappingId) {
        $('#myModal').modal('show');
        $('.modal-title').html('<b>GeoFence User Mapping Details</b>');
        //$('#_view').html('');
        $('#_view').html('<img src="/content/ajax-loader.gif" class="loaderimg" />');
        $("#myModal").one('shown.bs.modal', function () {
            $.post('/Admin/_GeoFenceMappingDisplayViaId', {
                'GeoFenceMappingId': GeoFenceMappingId
            }, function (data) {
                $('#_view').html(data);
            });
        });
    }
    function _Edit(GeoFenceMappingId) {
        $('#myModal').modal('show');
        $('.modal-title').html('<b>Update GeoFence User Mapping</b>');
        $('#_view').html('<img src="/content/ajax-loader.gif" class="loaderimg" />');
        $("#myModal").one('shown.bs.modal', function () {
            $.post('/Admin/_GeoFeneceUserMappingEdit', {
                'GeoFenceMappingId': GeoFenceMappingId
            }, function (data) {
                $('#_view').html(data);
            });
        });
    }
</script> 