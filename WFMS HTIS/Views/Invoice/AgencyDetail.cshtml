<h3 style=" color: #00476a;text-align:center"> Agency Details</h3>
<div class="page-content">


    @*********Page Title************@

    <div class="page-header">
        <h1>
            @ViewBag.PageTitle
            <a class="btn btn-primary pull-right" onclick="OpenAddModel()"><i class="fa fa-plus"></i> Create Agency</a>
        </h1>
    </div>
    @*********Page End************@

    @*********Page Content************@

    <div class="row">
        <div class="col-xs-12">
            &nbsp;
            <div id="_CustomerTypeList">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th style="width:15px;">Sr.No.</th>
                                <th>Agency Name</th>
                                <th>Category</th>
                                <th>Proprietor/MD Name</th>
                                <th>Official Email</th>
                                <th>Official Phone</th>
                                <th>Empanelment Date</th>
                                <th>Empanelment Expiry Date</th>
                                <th>Empanelment Letter</th>
                                <th>Biparty File</th>
                                <th class="editcol actionedit">Edit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>
</div>

<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#00476a;color:white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label for="AgencyName">Agency Name</label><span class="error-message">*</span>
                            <input type="text" id="AgencyNameId" class="form-control cleartxt required" placeholder="Agency Name" />

                        </div>

                        <div class="col-md-4">

                            <label for="Category">Category</label><span class="error-message">*</span>
                            <select id="CategoryId" class="form-control clearddl" placeholder="Category">
                                <option value="0">--Select Category--</option>
                                <option value="Category A">Category A</option>
                                <option value="Category B">Category B</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="ProprietorMDName">Proprietor/MD Name</label><span class="error-message">*</span>
                            <input type="text" class="form-control cleartxt required" id="ProprietorMdId" placeholder="Proprietor/MD Name" />

                        </div>

                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label for="RegistrationNumber"> Registration Number</label><span class="error-message">*</span>
                            <input type="text" class=" form-control cleartxt required" id="RegistrationId" placeholder=" Registration Number" />

                        </div>
                        <div class="col-md-4">
                            <label for="CompanyType">Company Type</label><span class="error-message">*</span>
                            <select id="CompanyId" class="form-control clearddl" placeholder="Company Type">
                                <option value="0">--Company Type Status--</option>
                                <option value="MSME">MSME</option>
                                <option value="Start Up">Start Up</option>
                                <option value="Both">Both</option>
                            </select>

                        </div>
                        <div class="col-md-4">
                            <label for="PanNumber">PAN Number</label><span class="error-message">*</span>
                            <input type="text" class="form-control cleartxt required" id="PanId" placeholder="PAN Number" maxlength="10" />

                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label for="EPF">PF Code No.</label><span class="error-message">*</span>
                            <input type="text" class="form-control cleartxt required" id="EPFId" placeholder="PF Code No." />

                        </div>
                        <div class="col-md-4">
