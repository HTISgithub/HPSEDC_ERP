                                    </div>
                                    <div class="col-md-4">
                                        <label for="PhoneNumber1">Phone Number1</label><span class="error-message"></span>
                                        <input type="text" class="form-control cleartxt required" id="PhoneNumber1" placeholder="Phone Number1" maxlength="12" />


                                    </div>
                                    <div class="col-md-4">
