                            <input type="text" class="form-control cleartxt required" id="ESICId" placeholder="Establishment Code No." />

                        </div>


                        <div class="col-md-4">
                            <label for="GST">GST Registration No.</label><span class="error-message">*</span>
                            <input type="text" class="form-control cleartxt required" id="Gst" placeholder="GST Registration No." />

                        </div>

                    </div>

                    <div class="form-group row">
                        <div class="col-md-4">
                            <label for="LabourLicense">Labour License</label><span class="error-message">*</span><br />
                            <form style="margin-top: -14px;">
                                <label class="radio-inline">
                                    <input type="radio" name="LabourLicenseId" id="Yes" value="Yes" onclick="Showdata()">Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="LabourLicenseId" id="No" onclick="HideData()" value="No">No
                                </label>

                            </form>

                        </div>

                        <div class="col-md-4">
                            <label for="LicenseNo">License No.</label><span class="error-message">*</span>
                            <input type="text" class="form-control cleartxt required" id="LicenseNoId" placeholder="License No" />
                        </div>


                        <div class="col-md-4">
                            <label for="EPF">Empanelment Date</label><span class="error-message">*</span>
                            <input type="text" class="datepicker form-control cleartxt required" name="datepicker" placeholder="Empanelment Date" id="EmpanelmentDate" />

                        </div>



                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <div>Empanelment Letter</div>
                            <div>
                                <input type="file" name="file" id="EmpanelmentFile" multiple="" @*onclick="HideFile()"*@ />
                                @*<input onchange="readURL(this)" type="file" class="filName" name="files[]" id="Imageupload" multiple="">*@
                            </div>
                        </div>


                        <div class="col-md-4">
                            <div>Biparty Agreement</div>
                            <div>
                                <input type="file" name="file" id="TripartiteFile" multiple="" />
                                @*<input onchange="readURL(this)" type="file" class="filName" name="files[]" id="Imageupload" multiple="">*@
                            </div>

                        </div>
                        <div class="col-md-4">
                            <label for="EPF">BiParty Expire Date</label><span class="error-message">*</span>
                            <input type="text" class="datepicker form-control cleartxt required" name="datepicker" placeholder="BiParty Expire Date" id="BiPartyExpireDate" />

                        </div>
                    </div>

                </div>



                <div class="panel-group">
                    <div class="panel panel-default">
                        <div class="panel-heading" style="background-color:#00476A;">
                            <h4 class="panel-title">
                                <a data-toggle="collapse" href="#collapse5" style="color:white">Contact Details</a>
                                <a data-toggle="collapse" href="#collapse5"> <span class="pull-right clickable" style="color:white"><i class="glyphicon glyphicon-chevron-down"></i></span></a>
                            </h4>
                        </div>
