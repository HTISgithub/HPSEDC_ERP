                                        <input type="text" class="form-control cleartxt required" id="PhoneNumber2" placeholder="Phone Number2" maxlength="12" />


                                    </div>


                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-group">
                    <div class="panel panel-default">
                        <div class="panel-heading" style="background-color:#00476A;">
                            <h4 class="panel-title">
                                <a data-toggle="collapse" href="#collapse3" style="color:white">Financial Details</a>
