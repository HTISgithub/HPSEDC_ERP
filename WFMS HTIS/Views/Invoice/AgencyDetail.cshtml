                                    </div>
                                    <div class="col-md-2">
                                        <label for="Date">Date</label><span class="error-message">*</span>
                                        <input type="text" class="datepicker form-control cleartxt required" name="datepicker" placeholder="Date" id="Date" />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="Method">Method</label><span class="error-message">*</span>
                                        <select id="MethodId" class="form-control clearddl" placeholder="Method">
                                            <option value="0">--Select Method--</option>
                                            <option value="RTGS">RTGS</option>
                                            <option value="NEFT">NEFT</option>
                                            <option value="DD">DD</option>
                                            <option value="Cheqe">Cheque</option>
                                            <option value="Bank Gurantee">Bank Guarantee</option>
                                            <option value="FDR">FDR</option>
                                        </select>

                                    </div>

                                </div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <label for="EMD">EMD Amount</label>
                                        <input type="text" id="EMDAmountId" class="form-control cleartxt required" placeholder="EMD Amount" />
                                    </div>

                                    <div class="col-md-3">
                                        <label for="EMDStatus">EMD Status</label><span class="error-message">*</span>
                                        <select id="EMDStatusId" class="form-control clearddl" placeholder="EMD Status">
                                            <option value="0">--EMD Status--</option>
                                            <option value="Paid">Paid</option>
                                            <option value="Return Requested">Return Requested</option>
                                        </select>

                                    </div>

                                    <div class="col-md-2">
                                        <label for="RefNo">Ref No.</label><span class="error-message">*</span>
                                        <input type="text" class="form-control cleartxt required" id="RefNoid1" placeholder="Ref No" />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="Date">Date</label><span class="error-message">*</span>
                                        <input type="text" class="datepicker form-control cleartxt required" name="datepicker" placeholder="Date" id="Date1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="Method">Method</label><span class="error-message">*</span>
                                        <select id="MethodId1" class="form-control clearddl" placeholder="Method">
                                            <option value="0">--Select Method--</option>
                                            <option value="RTGS">RTGS</option>
                                            <option value="NEFT">NEFT</option>
                                            <option value="DD">DD</option>
                                            <option value="Cheqe">Cheque</option>
                                            <option value="Bank Gurantee">Bank Guarantee</option>
                                            <option value="FDR">FDR</option>
                                        </select>

                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <label for="PBG">PBG Amount</label>
                                        <input type="text" id="PBGAmountId" class="form-control cleartxt required" placeholder="PBG Amount" />

                                    </div>

                                    <div class="col-md-3">
                                        <label for="PBGStatus">PBG Status</label><span class="error-message">*</span>
                                        <select id="PBGStatusId" class="form-control clearddl" placeholder="PBG Status">
                                            <option value="0">--PBG Status--</option>
                                            <option value="Submitted">Submitted</option>
                                            <option value="Not Submitted">Not Submitted</option>
                                        </select>

                                    </div>

                                    <div class="col-md-2">
                                        <label for="RefNo">Ref No.</label><span class="error-message">*</span>
                                        <input type="text" class="form-control cleartxt required" id="RefNoid2" placeholder="Ref No" />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="Date">Date</label><span class="error-message">*</span>
                                        <input type="text" class="datepicker form-control cleartxt required" name="datepicker" placeholder="Date" id="Date2" />
                                    </div>
                                    <div class="col-md-2">
                                        <label for="Method">Method</label><span class="error-message">*</span>
                                        <select id="MethodId2" class="form-control clearddl" placeholder="Method">
                                            <option value="0">--Select Method--</option>
                                            <option value="RTGS">RTGS</option>
                                            <option value="NEFT">NEFT</option>
                                            <option value="DD">DD</option>
                                            <option value="Cheqe">Cheque</option>
