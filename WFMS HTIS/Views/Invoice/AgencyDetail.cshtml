                            </h4>
                        </div>
                        <div id="collapse3" class="panel-collapse collapse">
                            <div class="panel-body">

                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <label for="AccountHolderName">Account Holder Name</label><span class="error-message">*</span>
                                        <input type="text" class="form-control cleartxt required" id="AccountHolderName" placeholder="Account Holder Name" />


                                    </div>
                                    <div class="col-md-4">
                                        <label for="AccountNumber">Account Number</label><span class="error-message">*</span>
                                        <input type="text" class="form-control cleartxt required" id="AccountNumber" placeholder="Account Number" />


                                    </div>
                                    <div class="col-md-4">
                                        <label for="IFSC">IFSC Code</label><span class="error-message">*</span>
                                        <input type="text" class="form-control cleartxt required" id="IFSC" placeholder="IFSC Code" />


                                    </div>


                                </div>

                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <label for="BranchDetail">Branch Detail</label><span class="error-message">*</span>
                                        <textarea rows="3" cols="30" height="" id="BranchDetail" placeholder="Branch Detail Describe Here..."></textarea>
                                        @*<input type="text" class="VendorHQAddress form-control" id="VendorHQAddId" placeholder="Vendor HQ Address" />*@

                                    </div>

                                </div>



                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <label for="EmpanelmentFees"> Empanelment Fees Amount</label><span class="error-message">*</span>
                                        <input type="text" class="form-control cleartxt required" id="EmpanelmentFeesId" placeholder=" Empanelment Fees" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="Empanelment">Empanelment Fees Status</label><span class="error-message">*</span>
                                        <select id="EmpanelmentStatusId" class="form-control clearddl" placeholder="Empanelment Fees Status">
