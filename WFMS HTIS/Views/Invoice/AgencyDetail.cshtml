                                            <option value="FDR">FDR</option>
                                        </select>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>


            </div>


        </div>
        <div class="modal-footer">
            <div class="row">
                <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                <div class="col-md-8">
                    <div class="modelalert"></div>
                </div>
                <div class="col-md-2">
                    <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                </div>
            </div>
        </div>
    </div>
</div>


<script>

    var pageSize=@pageSize;
    var mSupplierId = 0;
    //var mBillCountryId = 0;
    //var mBillStateId = 0;
    //var mBillCityId = 0;
    var sr = 0;
    var IsActive = 'Y';
    var tableRow;


    $(document).ready(function () {
        TableManageDefault.init();
        _AgencyDetailList();
        //Showdata();
      //_CustomerSocialAddressddl();
      //  _CustomerEntityddl();
    });

    $('.btnModalSubmit').click(function () {
        _AgencyDetailSubmit();
    });

    $('.modal-footer').show();

    function changeActiveStatus(id) {
        var status = 'N';
        if ($('#' + id).is(':checked')) {
            status = 'Y';
        }
        switcStatus('/Pm/_CustomerDetailStatusUpdate', id, status);
    }

    function changestatus() {
        console.log('chk');
    }


    function _AgencyDetailList() {


        $('#ProgressImg').show();
        $.post('/TimeSheet/_AgencyDetailList', {
            'AgencyId':mSupplierId,

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            /* alert(obj[0].Id);*/
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                //Document Download Link//
                if (value.EmpanelmentFileDocument == '' || value.EmpanelmentFileDocument == null) {
                    Doc = '<label class="text-center">-</label>';
                }
                else {
                    Doc = '<a href="/ImageHPSEDC/' + value.EmpanelmentFileDocument + '" target="_blank" data-toggle="tooltip" title="Download file" style="text-align:center; font-size:30px;"><i class="fa fa-download"></i></a>';
                }

                if (value.TripartiteFileDocument == '' || value.TripartiteFileDocument == null) {
                    Docm = '<label class="text-center">-</label>';
                }
                else {
                    Docm = '<a href="/ImageHPSEDC/' + value.TripartiteFileDocument + '"  target="_blank" data-toggle="tooltip" title="Download file" style="text-align:center; font-size:30px;"><i class="fa fa-download"></i></a>';
                }
                // alert(value.Id);
                var btnStatus = '<label><input name="switch-field-1" id=' + value.AgencyId + '  class="ace ace-switch ace-switch-2 chk" onchange="changeActiveStatus(id)"  type="checkbox" ' + (value.IsActive == "Y" ? "checked='checked'" : "") + ' /><span class="lbl"></span></label> ';

                msr = msr + 1;
                var btnEdit = '<a href="#" onclick="OpenUpdateModel(' + value.AgencyId + ',this,\'' + value.IsActive + '\',' + value.AgencyId + ')" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';
                var btnDelete = '<a href="#" onclick="RemoveEntry($(this),\'' + value.Id + '\')" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';

                //if (!accessRights.Edit) { btnEdit = '<i data-toggle="tooltip" title="You Are Not Authorized" class="fa fa-ban fa-2x"></i>'; }
                //if (!accessRights.Status) { btnStatus = '<i data-toggle="tooltip" title="You Are Not Authorized" class="fa fa-ban fa-2x"></i>'; }
                var elmntArray = [
                    msr,
                    value.AgencyName,
                    value.Category,
                    value.ProprietorMDName,
                    value.OfficialEmail,
                    value.OfficialPhone,
                    value.AEmpanelmentDate,
                    value.EmpanelmentExpireDate,
                    Doc,
                    Docm,
                    btnEdit

                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }

    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('.cleartxt').val('');
        $('.clearddl').val('0');
        $('.clearchk').val('');
    }



    function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("General Details");
        $('#myModal').modal({
            show: 'false'
        });

        mSupplierId = 0;
        isActive = 'Y';

    }


    function HideData() {

        $('#LicenseNoId').prop('disabled', true);
        $('#LicenseNoId').val('');

    }
    function Showdata() {

        $('#LicenseNoId').prop('disabled', false);
    }
    //function HideFile() {
    //    document.getElementById('Imageupload1').disabled = 'disabled';

    //}

    function _AgencyDetailSubmit() {


        if ($('#AgencyNameId').val().trim() == '') {
            $('.modelalert').html('Please Enter Agency Name');

           return;

        }

        if ($('#CategoryId').val().trim() == '0') {
            $('.modelalert').html('Please Choose Category');

            return;
        }

        if ($('#ProprietorMdId').val().trim() == '') {
            $('.modelalert').html('Please Enter ProprietorMDName');
            return;
        }
        if ($('#RegistrationId').val().trim() == '') {
            $('.modelalert').html('Please Enter Registration Number');
            return;

        }
        if ($('#CompanyId').val().trim() == '0') {
            $('.modelalert').html('Please Choose Company');

            return;

        }

        if ($('#PanId').val().trim() == '') {
            $('.modelalert').html('Please Enter PAN Number');

            return;
        }

        if ($('#EPFId').val().trim() == '') {
            $('.modelalert').html('Please Enter PF Code No');
            return;

        }
        if ($('#ESICId').val().trim() == '') {
            $('.modelalert').html('Please Enter  Establishment Code No ');
            return;
        }

        if ($('#Gst').val().trim() == '') {
            $('.modelalert').html('Please Enter  GST Registration No ');
           return;
        }

        if ($('#EmpanelmentDate').val().trim() == '') {
            $('.modelalert').html('Please Enter Empanelment Date');
            return;
        }

        if ($('#BiPartyExpireDate').val().trim() == '') {
            $('.modelalert').html('Please Enter BiParty Expire Date');
            return;
        }


        if ($('#VendorHQAddressId').val().trim() == '') {
            $('.modelalert').html('Please Enter Vendor HQ Address');
            return;
        }
        if ($('#VendorHPAddressId').val().trim() == '') {
            $('.modelalert').html('Please Enter Vendor HP Address');
            return;

        }





        if ($('#AccountHolderName').val().trim() == '') {
            $('.modelalert').html('Please Enter Account Holder Name');
            return;
        }
        if ($('#AccountNumber').val().trim() == '') {
            $('.modelalert').html('Please Enter Account Number');
            return;

        }

        if ($('#IFSC').val().trim() == '') {
            $('.modelalert').html('Please Enter IFSC Code');
