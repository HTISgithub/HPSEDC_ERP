<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var mAgencyId;
    $(document).ready(function () {
        TableManageDefault.init();
        SubMonthlyReport();
    });


    function SubMonthlyReport() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        $.post('/Invoice/_NewInvoiceList', {
            MonthId: month,
            AgencyBillId: '0',
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;
                let content = value.SaleBillNo + "<br>PurchaseBill No. " + value.Billno;
                var View = '<a href="#" onclick="OpenAddModel3(' + value.AgencyBillId + ')" class="img-circle"><center><i class="fa fa-eye fa-2x" aria-hidden="true"></i></center></a>';
               // var DeptPartialPayment = '<a href="#" onclick="OpenModelDeptPartialPayment(' + value.AgencyBillId + ')"  class="img-circle"><center><i class="btn btn-secondary" style="color:blue !important;">Partial Payment</center></i></a>';
                var elmntArray = [
                    msr,
                    value.DepartmentName,
                    value.DepartmentAddress,
                    value.AgencyName,
                    content,
                    value.SaleBillAmount,
                    value.SaleBillDate,
                   // DeptPartialPayment,
                    View
                ];

                table.row.add(elmntArray).draw(false);
            });
        });
    }
    var vIds;
    function OpenAddModel3(AgencyBillId) {
        //resetModal();
        //resetForm();
        $('.modal-title').html("View Payment Against Sale Bill");
        $('#myModal3').modal({
            show: 'false'
        });

        vId = AgencyBillId;

        IsActive = 'Y';
        _NewDeptPaymentList(AgencyBillId);
        root = '/Invoice/_NewDeptPaymentList';
    }
    function _NewDeptPaymentList(AgencyBillId) {

        $('#ProgressImg').show();
        $.post('/Invoice/_NewDeptPaymentList', {
            'AgencyBillId': AgencyBillId,
            'DepartmentBillId': 0,
            'ReceiptId': AgencyBillId,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable3').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;

                var elmntArray = [
                    msr,
                    //value.departmentName,
                    //value.DepartmentAddress,
                    value.AgencyName,
                    value.SaleBillNo,
                    value.BillAmount,
                    value.ModeOfPayment,
                    value.TransactionId,
                    value.ReceivedAmt + '<br>' + value.ReceivedDate,
                    value.GSTTds2 + '<br>' + value.Tds2,
                    value.Narration
                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }
</script>
