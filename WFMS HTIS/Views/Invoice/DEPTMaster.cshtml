@using System.Data
@{
    ViewBag.Title = "Department Address";
    ViewBag.PageTitle = "Department Billing Address";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();
}

@******************Breadcrumb Start**************@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>
        <li class="active">@ViewBag.PageTitle</li>
    </ul>
</div>
@******************Breadcrumb End**************@
<style>
    .modal-footer {
        display: block;
    }

    body {
        font-family: "Jost", sans-serif;
    }

    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    label {
        font-weight: 800;
    }

        label[for="IsActive"] {
            position: relative;
            padding-left: 35px;
            cursor: pointer;
            display: inline-block;
            font-size: 18px;
            color: #333;
        }

            label[for="IsActive"]:before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 22px;
                height: 22px;
                border: 2px solid #4CAF50;
                background-color: #fff;
                border-radius: 4px;
                transition: background-color 0.3s, border 0.3s;
            }

    #IsActive:checked + label[for="IsActive"]:before {
        background-color: #4CAF50;
        border-color: #4CAF50;
    }

    #IsActive:checked + label[for="IsActive"]:after {
        content: "✔";
        position: absolute;
        left: 4px;
        top: 0;
        color: white;
        font-size: 16px;
    }

    #IsActive {
        display: none;
    }
    .swal-ok-btn {
        font-size: 18px !important;
        padding: 10px 25px !important;
    }

</style>

<div class="page-content">
    @*********Page Title************@
    @if (user == "48")
    {
        <div class="page-header">
            <h1>
                @ViewBag.PageTitle
                <a class="btn btn-primary pull-right btnAddModal" onclick="OpenAddModel()"><i class="fa fa-plus"> </i>  ADD Work Order Details</a>
            </h1>
        </div>

    }
    @*********Page End************@

    @if (user == "39")
    {
        <div class="col-md-3" style=" margin-top: -83px; margin-left: 869px; ">
            <label for="Complaint">Agency</label><span class="error-message">*</span>
            <select id="ddlAgencyfilter" style="width: 20rem" onchange="_DEPTMasterListDept();">
                <option value="0">Select Agency</option>
            </select>
        </div>
        <div class="col-md-3" style=" margin-top: -83px; margin-left: 1150px; ">
            <label for="Complaint">Department</label><span class="error-message">*</span>
            <select id="DeptIdfilter" style="width: 20rem" onchange="_DEPTMasterListDept();">
                <option value="0">Select Department</option>
            </select>
        </div>
    }
    @*********Page Content************@
    <div class="row">
        <div class="col-md-12">
            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>Agency Name</th>
                                <th>Department Name</th>
                                <th>Work Order No.</th>
                                <th>Billing Address</th>
                                <th>No. Of Resources</th>
                                <th>Email Id</th>
                                <th>Is Employees Uploded</th>
                                <th class="editcol actionedit">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #0f1875; color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <div id="_view">
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Complaint">Agency</label>
                                <select id="ddlAgencynew" style="width:269px">
                                    <option value="0">Select Agency</option>
                                </select>
                            </div>
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Department">Department Name</label><span class="error-message">*</span>
                                <select id="DeptId" class="clearddl" style="width:269px" onchange="_BillingAddressddl()">
                                    <option value="0">--Select Department--</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Work">Work Order No.</label><span class="error-message">*</span>
                                <input type="text" id="Work" class="form-control cleartxt" placeholder="Work Order No." />
                            </div>
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="NoofResouserces">No. Of Resources</label><span class="error-message">*</span>
                                <input type="text" id="NoofResources" class="form-control cleartxt" placeholder="No. Of Resources" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Email">Department Email ID</label><span class="error-message">*</span>
                                <input type="text" id="Email" class="form-control cleartxt" placeholder="Email Id" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <div class="font">
                                    Billing Address <span class="error-message">*</span>
                                </div>
                                <div>
                                    <select id="BillingId" class="form-control" onchange="AddressBox()">
                                        <option value="S">--Select--</option>

                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-lg-12 col-md-12 col-sm-12" style="display:none;" id="addressDiv">
                                <div class="font">
                                    Enter Billing Address <span class="error-message">*</span>
                                </div>
                                <div>
                                    <textarea id="BillingAddress" placeholder="Billing Address" class="form-control textbox"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-2">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" />
                        </div>
                        <div class="col-md-8">
                            <div class="modelalert"></div>
                        </div>
                        <div class="col-md-2">
                            <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var vId = 0, mDistrictId = 0; var WorkOrderAgencyId = 0;
    var IsActive = 'Y';  var currentUser = '@user';
    $(document).ready(function () {
        TableManageDefault.init();
        //AddressBox();
        _DEPTMasterList();
        _DEPTMasterListDept();
        $('#ddlAgency').select2();
        $('#DeptId').select2();
       /* $('#BillingId').select2();*/
        $('#ddlAgencyfilter').select2();
        $('#DeptIdfilter').select2();
    });
    $('.btnModalSubmit').click(function () {
        _DepartmentAddressSubmit();
    });

    function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("Add Department Email & Billing Address");
        $('#myModal').modal({
            show: true
        });
    }

    function fillForm(WorkOrderAgencyId) {
        $('#ModalProgress').show();
        $('.modelalert').html('Please wait');
        $.post('/Invoice/_DEPTMasterListEdit', {
            'WorkOrderAgencyId': WorkOrderAgencyId,
        }, function (data) {
            $('#ModalProgress').hide();
            $('.modelalert').html('');
            var obj = $.parseJSON(data);
           // $('#ddlAgency').val(1);
            $('#ddlAgencynew').val(obj[0].AgencyId).trigger('change');
            $('#DeptId').val(obj[0].DeptId).trigger('change');
            $('#BillingId').val(obj[0].BillingId);
            $('#Work').val(obj[0].WorkOrderId);
            $('#NoofResources').val(obj[0].NoDeployedRes);
            $('#Email').val(obj[0].BillAddressEmail);
        });
    }

    function OpenUpdateModel(Id) {
        resetModal();
        resetForm();
        $('.modal-title').html("Update Department Email & Billing Address");
        $('#myModal').modal({
            show: 'false'
        });
        WorkOrderAgencyId = Id;
        fillForm(WorkOrderAgencyId);
        root = '/Invoice/_DEPTMasterList';
        $('.modal-footer').show();
    }
    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('#Work').val('');
        $('#NoofResources').val('');
        $('#Email').val('');
        $('#BillingAddress').val('');
        //$('#').val('0');
        $('#ddlAgency').val('0').trigger('change');
        $('#DeptId').val('0').trigger('change');
        $('#BillingId').val('0');
        $('.modelalert').html('');
    }
    function _DEPTMasterListDept() {
        if (currentUser !== "39") {
            return;
        }

        $('#ProgressImg').show();
        $.post('/Invoice/_DEPTMasterList',
            {
                'WorkOrderId': 0,
                'DeptId': $('#DeptIdfilter').val(),
                'AgencyId': $('#ddlAgencyfilter').val()
            },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var table = $('#myTable').DataTable();
                table.clear().draw();
                var msr = 0;
                $.each(obj, function (key, value) {
                    msr += 1;
                    var btnEdit = '<a href="#" onclick="OpenUpdateModel(\'' + value.WorkOrderAgencyId + '\', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';
                    var elmntArray = [
                        msr,
                        value.AgencyName,
                        value.DepartmentName,
                        value.WorkOrderId,
                        value.BillingAddress,
                        value.NoDeployedRes,
                        value.BillAddressEmail,
                        value.IsResourceUploaded,
                        btnEdit
                    ];
                    table.row.add(elmntArray).draw(false);
                });
            });
    }
    function _DEPTMasterList() {
        $('#ProgressImg').show();
        $.post('/Invoice/_DEPTMasterList',
            {
                'WorkOrderId': 0,
                'DeptId': $('#DeptId').val(),
                'AgencyId': $('#ddlAgencynew').val(),

            },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var table = $('#myTable').DataTable();
                table.clear().draw();
                var msr = 0;
                $.each(obj, function (key, value) {
                    msr += 1;
                    var btnEdit = '<a href="#" onclick="OpenUpdateModel(\'' + value.WorkOrderAgencyId + '\', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';
                    var elmntArray = [
                        msr,
                        value.AgencyName,
                        value.DepartmentName,
                        value.WorkOrderId,
                        value.BillingAddress,
                        value.NoDeployedRes,
                        value.BillAddressEmail,
                        value.IsResourceUploaded,
                        btnEdit
                    ];
                    table.row.add(elmntArray).draw(false);
                });
            });
    }
    
    function showWarning(message) {
        Swal.fire({
            icon: 'warning',
            title: message,
            customClass: {
                confirmButton: 'swal-ok-btn'
            },
            showClass: { popup: 'animate__animated animate__fadeInDown' },
            hideClass: { popup: 'animate__animated animate__fadeOutUp' }
        });
    }


    function _DepartmentAddressSubmit() {
        if ($('#ddlAgencynew').val() == '0') {
            showWarning('Please Select Agency');
            return;
        }

        if ($('#DeptId').val() == '0') {
            showWarning('Please Select Department');
            return;
        }

        if ($('#Work').val() == '') {
            showWarning('Please Enter Work Order No.');
            return;
        }

        if ($('#NoofResources').val() == '') {
            showWarning('Please Enter No. Of Resources');
            return;
        }

        if ($('#Email').val() == '') {
            showWarning('Please Enter Email Id');
            return;
        }

        var billingAddress = '';
        if ($("#BillingId").val() == '0') {
            billingAddress = $('#BillingAddress').val();
        } else {
            billingAddress = $("#BillingId option:selected").text();
        }

        $('.modelalert').html('');
        $('#ModalProgress').show();
        $('.btnModalSubmit').attr("disabled", "disabled");
        $.post('/Invoice/_DEPTMasterSubmit', {
            'WorkOrderAgencyId': WorkOrderAgencyId,
            'ddlAgency': $('#ddlAgencynew').val(),
            'DeptId': $('#DeptId').val(),
            'Work': $('#Work').val(),
            'NoofResources': $('#NoofResources').val(),
            'Email': $('#Email').val(),
            'BillingId': $('#BillingId').val(),
            'BillingAddress': billingAddress,
        }, function (data) {
            alert(data);
            $('#myModal').modal('hide');
            resetForm();
            $('.btnModalSubmit').removeAttr("disabled");
            $('#ModalProgress').hide();
            _DEPTMasterList();
        });
    }
    _Departmentddl();
    function _Departmentddl() {
        $.post('/Invoice/_AvoDepartmentddlNew2', { 'Id': 0 }, function (data) {
            var DeptId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptId += '<option value=' + value.DeptId + '>' + value.departmentName + '</option>';
            });
            $('#DeptId').html(DeptId);
        });
        $('#DeptId').select2({
            dropdownParent: $('#myModal')
        });
    }
    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl2', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
                $('#ddlAgencynew').html(DeploymentOfficeId);
            });
        });
    }
    function _BillingAddressddl() {

        $.post('/Invoice/_BillingAddressddl', { 'AgencyId': 0, 'DeptId': $("#DeptId").val() }, function (data) {
            var DeploymentOfficeId = '<option value="S">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AddressId + '>' + value.BillingAddress + '</option>'

            });
            console.log(DeploymentOfficeId);
            $('#BillingId').html(DeploymentOfficeId);

        });
    }
    _Agencyddl1();
    function _Agencyddl1() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgencyfilter').html(DeploymentOfficeId);
        });
    }
    _Departmentddl1();
    function _Departmentddl1() {
        $.post('/Invoice/_AvoDepartmentddlNew1', { 'Id': 0 }, function (data) {
            var DeptId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptId += '<option value=' + value.Id + '>' + value.EntityName + '</option>';
            });
            $('#DeptIdfilter').html(DeptId);
        });
    }
</script>