<style>
    .modal-footer {
        display: block;
    }

    .input-sm {
        margin-top: 30px;
    }

    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    #myTable_wrapper {
        margin-top: -89px;
    }


    .dt-buttons {
        display: none;
    }

    .select2-results__options {
        max-height: 400px !important;
        overflow-y: auto !important;
    }
</style>

<div class="page-content">
    @*********Page Title************@
    <div class="page-header">

    </div>
    @*********Page End************@

    @*********Page Content************@
    <div class="row">
        &nbsp;
        <div class="col-md-12">
            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-12">
                        <div class="col-md-3" style=" margin-top: -71px;">
                            <label for="Month">Month Year</label><span class="error-message">*</span>
                            <select id="ddlMonths" class="Month" onchange="_ResourceReport()">
                                <option>--Month--</option>
                                @for (int i = 1; i <= 12; i++)
                                {

                                    DateTime date = new DateTime(2020, i, 1);
                                    mon = date.ToString("MMM");
                                    <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                }
                            </select>
                            <select id="ddlYears" class="year" onchange="_ResourceReport()">
                                <option>--Year--</option>
                                @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                {
                                    if (i == DateTime.Now.Year)
                                    {
                                        <option value="@i" selected='selected'>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 280px; ">
                            <label for="Complaint">Agency</label><span class="error-message">*</span>
                            <select id="ddlAgency" style="width: 20rem" onchange="_ResourceReport()">
                                <option value="0">Select Agency</option>
                            </select>
                        </div>

                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 580px; ">
                            <label for="Complaint">Department</label><span class="error-message">*</span>
                            <select id="ddldepartment" style="width: 20rem" onchange="_ResourceReport()">
                                <option value="0">Select Department</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-1" style=" margin-top: -83px; margin-left: 1045px; display:flex;flex-direction:row ">
                        <button id="exportBtn" style="background-color: #337ab7; width: 4vw; color: white; font-size: 16px; padding: 8px 12px; border-radius: 5px; border: none; margin-left:10px " onclick="Excel()">Excel</button>
                    </div>
                </div>
            </div>
        </div>

        <div align="left" id="Zones">
            <div class="dt-responsive">
                <table class="table table-striped table-bordered" id="myTable">
                    <thead>
                        <tr>
                            <th class="widthsr">Sr.No.</th>
                            <th>Agency Name</th>
                            <th>Department Name</th>
                            <th>Department Address</th>
                            <th>No. of Resources</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>

    $(document).ready(function () {
        TableManageDefault.init();
        _ResourceReport();
    });


    function Excel() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();

        $.post('/Invoice/_ResourceReportList', {
            DeptId: $('#ddldepartment').val(),
            MonthId: month,
            AgencyId: $('#ddlAgency').val(),
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var dataForExport = [];

            dataForExport.push(["Total No. of Resource for Month " + $('#ddlMonths').find(':selected').text() + $('#ddlYears').find(':selected').text()]);
            dataForExport.push([]);


            dataForExport.push([
                "Sr. No.",
                "AGENCY NAME",
                "DEPARTMENT NAME",
                "DEPARTMENT ADDRESS",
                "No. Of RESOURCE",
                "REMARKS",
            ]);

            var msr = 0;
            $.each(obj, function (key, value) {
                msr++;
                dataForExport.push([
                    msr,
                    value.AgencyName,
                    value.DepartmentName,
                    value.DepartmentAddress,
                    value.TotalResources,
                    value.Narration,
                ]);
            });

            const ws = XLSX.utils.aoa_to_sheet(dataForExport);


            ws["!merges"] = [
                { s: { r: 0, c: 0 }, e: { r: 0, c: 5 } }
            ];

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Total Resource Report");
            XLSX.writeFile(wb, "Manpower Resource Report.xlsx");
        });
    }

    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').select2({
                dropdownAutoWidth: 'false',
            });
        });
    }

    _Departmentddl();
    function _Departmentddl() {
        $.post('/Invoice/_AvoDepartmentddlNew1', { 'Id': 0 }, function (data) {
            var DeptId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptId += '<option value=' + value.Id + '>' + value.EntityName + '</option>';
            });
            $('#ddldepartment').html(DeptId);
            $('#ddldepartment').select2({
                dropdownAutoWidth: 'false',
            });
        });
    }

    function _ResourceReport() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        $.post('/Invoice/_ResourceReportList', {
            DeptId: $('#ddldepartment').val(),
            MonthId: month,
            AgencyId: $('#ddlAgency').val(),
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();

            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;

                var elmntArray = [
                    msr,
                    value.AgencyName,
                    value.DepartmentName,
                    value.DepartmentAddress,
                    value.TotalResources,
                    value.Narration,
                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }

</script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
