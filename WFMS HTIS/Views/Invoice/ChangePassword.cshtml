@{
    ViewBag.Title = "Change Password";
    ViewBag.PageTitle = "Change Password";
}

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper input {
            padding-right: 35px;
        }

        .password-wrapper .toggle-password {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            cursor: pointer;
            color: #999;
        }
    .swal-ok-btn {
        font-size: 18px !important;
        padding: 10px 25px !important;
    }
</style>

<div class="container d-flex justify-content-center align-items-center vh-100" style=" margin-right: -130px;">
    <div class="card shadow p-4" style="width: 400px;">
        <h4 class="card-title text-center mb-4">@ViewBag.PageTitle</h4>

        <div class="form-group">
            <label>Old Password</label>
            <div class="password-wrapper">
                <input type="password" id="OldPassword" class="form-control" placeholder="Enter old password" />
                <i class="fa fa-eye toggle-password" data-target="#OldPassword"></i>
            </div>
        </div>

        <div class="form-group">
            <label>New Password</label>
            <div class="password-wrapper">
                <input type="password" id="password" class="form-control" placeholder="Enter new password" />
                <i class="fa fa-eye toggle-password" data-target="#password"></i>
            </div>
        </div>

        <div class="form-group">
            <label>Confirm Password</label>
            <div class="password-wrapper">
                <input type="password" id="confirmpassword" class="form-control" placeholder="Confirm new password" />
                <i class="fa fa-eye toggle-password" data-target="#confirmpassword"></i>
            </div>
        </div>

        <div class="text-center text-danger modelalert my-2"></div>

        <div class="text-center">
            <button type="button" class="btn btn-primary btnModalSubmit">Change Password</button>
            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display: none;" />
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).on('click', '.toggle-password', function () {
        var input = $($(this).data('target'));
        var type = input.attr('type') === 'password' ? 'text' : 'password';
        input.attr('type', type);
        $(this).toggleClass('fa-eye fa-eye-slash');
    });
    function showWarning(message) {
        Swal.fire({
            icon: 'warning',
            title: message,
            customClass: {
                confirmButton: 'swal-ok-btn'
            },
            showClass: { popup: 'animate__animated animate__fadeInDown' },
            hideClass: { popup: 'animate__animated animate__fadeOutUp' }
        });
    }

    $('.btnModalSubmit').click(function () {
        _changepassword();
    });

    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function _changepassword() {
        if ($('#OldPassword').val() == '') {
            showWarning('Please enter old password');
            return;
        }
        if ($('#password').val() == '') {
            showWarning('Please enter new password');
            return;
        }
        if ($('#confirmpassword').val() == '') {
            showWarning('Please confirm password');
            return;
        }
        if ($('#confirmpassword').val() != $('#password').val()) {
            showWarning('Password and confirm password do not match');
            return;
        }

        if (confirm("Are you sure to change password?")) {
            $('#ModalProgress').show();
            $('.btnModalSubmit').attr("disabled", "disabled");
            $.post('/Invoice/_ChangePasswordSubmit', {
                'OldPassword': $('#OldPassword').val(),
                'confirmpassword': $('#confirmpassword').val(),
            }, function (data) {
                $('.modelalert').html(data).delay(1000).queue(function () {
                    $('.modelalert').dequeue();
                    window.location = '/account/logout';
                });
                $('.btnModalSubmit').removeAttr("disabled");
                $('#ModalProgress').hide();
            });
        }
    }

    $(document).ready(function () {
        resetModal();
    });
</script>
