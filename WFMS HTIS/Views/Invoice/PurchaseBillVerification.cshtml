<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>
<script>
    var mAgencyId = 0, accessRights;
    var sr = 0;
    var IsActive = 'Y';
    var tableRow;
    $(document).ready(function () {
        TableManageDefault.init();
        $('#ddlAgency').select2();
         $('#DeptFilter').select2();
        _NEWTDSREPORTSList();
        $('#loader-overlay').hide();
    });
    _Agencyddl2();
    function _Agencyddl2() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').val(mAgencyId);
        });
    }

    function _NEWTDSREPORTSList() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        $.post('/Invoice/_PurchaseBillVerificationList', {
            'AgencyId': $('#ddlAgency').val(),
            AgencyBillId: 0,
            MonthId: month,
            DeptFilter: $('#DeptFilter').val(),
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;
                var Doc = (value.AttendanceCertificate) ?
