                var tds1 = 0, tds2 = 0;

                if (value.Tds1 == "Y") {
                    tds1 = manpowerAmt * 0.01;
                }
                if (value.Tds2 == "Y") {
                    tds2 = manpowerAmt * 0.02;
                }


                // Set the values in the respective input fields
                $('#GSTTDS1').val(gstTDS.toFixed(2));
                $('#TDS1').val(tds1.toFixed(2)); //PaymentAmount
                $('#TDS2').val(tds2.toFixed(2)); //PaymentAmount
                var totalpay = Math.round(totalAmountnew - (gstTDS + tds1 + tds2)).toFixed(2);
               // alert(totalpay);
                //'Total': Math.round($('#Total').val()),
                $('#PaymentAmount1').val(totalpay);



                var balance = (totalAmountnew - totalpay - (gstTDS + tds1 + tds2));
                $('#Balance1').val(balance.toFixed(2));


                // Calculate Balance dynamically based on PaymentAmount input
                // Calculate Balance Payment Due (INR) after subtracting PaymentAmount
                $('#PaymentAmount1').on('input', function () {
                    var paymentAmount = parseFloat($(this).val()) || 0;
                    balance = totalAmountnew - (paymentAmount + gstTDS + tds1 + tds2);
                    $('#Balance1').val(balance.toFixed(2));
                });
                $('#GSTTDS1').on('input', function () {

                    var PaymentAmount = parseFloat($('#PaymentAmount1').val()) || 0;
                    var GSTTDS = parseFloat($(this).val()) || 0;
                    var TDS1 = parseFloat($('#TDS1').val()) || 0;
                    var TDS2 = parseFloat($('#TDS2').val()) || 0;
                    var totalAmount = parseFloat($('#BillAmount3').val()) || 0;
                    var total = totalAmount - (PaymentAmount + GSTTDS + TDS1 + TDS2);
                    //var balance = totalAmount - (paymentAmount + GSTTDS + TDS);

                    $('#Balance1').val(total.toFixed(2));
                });
                $('#TDS1').on('input', function () {
                    var PaymentAmount = parseFloat($('#PaymentAmount1').val()) || 0;
                    var GSTTDS = parseFloat($('#GSTTDS1').val()) || 0;
                    var TDS1 = parseFloat($(this).val()) || 0;
                    var TDS2 = parseFloat($('#TDS2').val()) || 0;
                    var totalAmount = parseFloat($('#BillAmount3').val()) || 0;
                    var total = totalAmount - (PaymentAmount + GSTTDS + TDS1 + TDS2);
                    //var balance = totalAmount - (paymentAmount + GSTTDS + TDS);

                    $('#Balance1').val(total.toFixed(2));
                });
                $('#TDS2').on('input', function () {
                    var PaymentAmount = parseFloat($('#PaymentAmount1').val()) || 0;
                    var GSTTDS = parseFloat($('#GSTTDS1').val()) || 0;
                    var TDS2 = parseFloat($(this).val()) || 0;
                    var TDS1 = parseFloat($('#TDS1').val()) || 0;
                    var totalAmount = parseFloat($('#BillAmount3').val()) || 0;
                    var total = totalAmount - (PaymentAmount + GSTTDS + TDS1 + TDS2);
                    //var balance = totalAmount - (paymentAmount + GSTTDS + TDS);

                    $('#Balance1').val(total.toFixed(2));
                });

            });
        });

    }


