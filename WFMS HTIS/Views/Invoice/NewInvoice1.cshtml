        font-weight: 600;
        color: white;
        border-radius: 5px;
        font-size: 15px;
        background-color: #0f1875;
    }

    .hydrated {
        visibility: inherit;
        font-size: 5px !important;
    }

    td {
        font-family: "Jost", sans-serif;
        font-weight: 400;
    }

    .dt-buttons {
        display: none;
    }

    #myTable_wrapper {
        margin-top: -50px;
    }


    /* Create a custom checkbox square for only this specific checkbox */
    #loading {
        position: fixed;
        display: block;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        text-align: center;
        opacity: 0.7;
        background-color: #fff;
        z-index: 99;
    }

    #loading-image {
        width: 100px;
        left: 0%;
        position: relative;
        top: 50%;
    }
