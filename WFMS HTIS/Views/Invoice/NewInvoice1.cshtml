    function _PurchaseBillFill(AgencyBillId) {

        $.post('/Invoice/_NewInvoiceList1', {
            'AgencyBillId': AgencyBillId,
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                $('#WorkOrderNo').val(value.WorkOrderNo);
