        if ($('#ModePayment2').val() == '0') {
            $('.modelalert').html('Please Select Mode Of Payment');
            return;
        }

        if ($('#Transaction1').val() == '') {
            $('.modelalert').html('Please Enter Transaction Id');
            return;
        }


        if ($('#PaymentDate1').val() == '') {
            $('.modelalert').html('Please Choose PaymentDate');
            return;
        }
        if ($('#Remarks1').val() == '') {
            $('.modelalert').html('Please Enter Narration');
            return;
        }


        $('.modelalert').html('');
        $('#ModalProgress').show();
        $.post('/Invoice/_NewAgencytPaySubmit', {
            'PaymentId': 0,
            'AgencyBillId': vId,
            'Transaction1': $('#Transaction1').val(),
            'ModePayment2': $('#ModePayment2').val(),
            'Remarks1': $('#Remarks1').val(),
            'PaymentDate1': $('#PaymentDate1').val(),
            'PaymentAmount1': $('#PaymentAmount1').val(),

            'GSTTDS1': $('#GSTTDS1').val(),
            'TDS1': $('#TDS1').val(),
            'TDS2': $('#TDS2').val(),

            /*'Balance1': $('#Balance1').val(),*/

        }, function (data) {
            alert(data);
            vId = 0;

            $('#myModal4').modal('hide');
            $('.btnModalSubmit3').removeAttr("disabled");
            $('#ModalProgress').hide();
            _NewInvoiceList1(1);


        });
    }

    function _NewAgencyPaymentList(AgencyBillId) {

        $('#ProgressImg').show();
        $.post('/Invoice/_NewAgencyPaymentList', {
            'AgencyBillId': AgencyBillId,
            'PaymentId': 0,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable8').DataTable();
            table.clear().draw(); 
            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;

                var elmntArray = [
                    msr,
                    value.TransactionId,
                    value.ModeOfPayment,
                    value.Narration,
                    value.totalReceivedAmt,

                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }

    function OpenAddModel8(AgencyBillId) {
        resetModal();
        resetForm();
        $('.modal-title').html("View Payment Against Purchase Invoice");
        $('#myModal8').modal({
            show: 'false'
        });

        vId = AgencyBillId;

        IsActive = 'Y';
        _NewAgencyPaymentList(AgencyBillId);
        root = '/Invoice/_NewAgencyPaymentList';
    }
</script>
