                $('#NoOfResource').val(value.NoOfResource);
                $('#BillDate').val(value.BillDate);
                $('#DepartmentAddress').val(value.DepartmentAddress);
                $('#Description').val(value.Description);
                $('#Narration').val(value.Narration);

                $('#AgencyBill').val(value.AgencyBillAmt);
                $('#Admin').val(value.AdminAmt);
                $('#Libary').val(value.LibaryAmt);
                $('#cgst').val(value.cgstAmt);
