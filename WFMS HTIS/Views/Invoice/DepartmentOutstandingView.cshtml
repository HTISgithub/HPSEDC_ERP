@{
    ViewBag.Title = "Agency Billing";
    ViewBag.PageTitle = "Agency Billing";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}
<style>
    body {
        font-family: Arial;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 41px;
            transition: 0.3s;
            font-size: 15px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
    }

    .modal-footer {
        display: block;
    }

    div.dataTables_wrapper div.dataTables_filter {
        text-align: right;
    }
</style>
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>
        @*<li>
                <a href="#"></a>
            </li>*@
        <li class="active">@ViewBag.PageTitle</li>
    </ul><!-- /.breadcrumb -->

</div>
@******************Breadcrumb End**************@



<div class="page-content">
    @*********Page Title************@
    @*********Page End************@
    @*********Page Content************@
    <div>
        <div class="panel panel-default">
            <div class="panel-heading"><b>Agency Billing</b></div>
            <div class="panel-body">
                <div class="container-fluid" id="show">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group row">
                            <div class="col-md-3" style="display:none;">
                                <label for="Complaint">Agency</label><span class="error-message">*</span></br>
                                <select id="ddlAgency" class="ddlAgency" style="width: 30rem" onchange=" _Departmentddl();">
                                    <option value="0">Select Agency</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="Complaint">Department</label><span class="error-message">*</span></br>
                                <select id="DeptId1" style="width: 30rem" onchange="_NewBiillingAdress();">
                                    <option value="0">Select</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label for="Billing">Billing Address</label><span class="error-message">*</span><br />
                                <select id="BillingId" class="clearddl" style="width: 652px; height: 34px" onchange="_DEPTMasterList();">
                                    <option value="0">Select Billing Address</option>
                                </select>
                            </div>


                        </div>
                        <div class="form-group row" style="display:none;">
                            <div class="col-md-3">
                                <label for="Complaint">Merged Into Work Order No.</label><span class="error-message">*</span>
                                <select id="Work" class="clearddl" style="width: 30rem" onchange="">
                                    <option value="0">--Select Work Order--</option>
                                </select>
                            </div>
                            <div class="col-md-3" style="display:none;">
                                <label for="NoofResouserces">No. Of Resources</label><span class="error-message">*</span>
                                <input type="text" id="NoofResources" style="width: 30rem" class="form-control cleartxt" placeholder="No. Of Resources" readonly />
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="row">
                                <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                                <div class="col-md-8">
                                    <div class="modelalert"></div>
                                </div>
                                <div class="col-md-2" style="display:none;">
                                    <input type="submit" id="Submit" style="width: 130px; margin-left:57px;" class="btn btn-primary cleartxt" value="Submit" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <div class="row">
                            &nbsp;
                            <div class="col-md-12">
