            </div>
        </div>
    </div>

</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var accessRights;
    var vId = 0;
    var sr = 0;
    var sId = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();
        _DEPTMasterList();
        $('#ddlAgency').select2();
        $('#DeptId1').select2();
        $('#BillingId').select2();
        $('#Work').select2();

    });


    function resetForm() {
        $('#NoofResources').val('');
        $('#ddlAgency').val('0');
        $('#DeptId').val('0');
        $('#Upload').val('');
        $('#BillnoPurchase').val('');
        $('#DescriptionPurchase').val('');
        $('#NarrationPurchase').val('');
        $('#AgencyBillPurchase').val('');
        $('#IGSTPurchase').val('');
        $('#cgstPurchase').val('');
        $('#SGSTPurchase').val('');
        $('#TotalPurchase').val('');
    }

    $('#Submit').click(function () {
        _NewDeptAttendanceSubmit();
    });

    $('.btnModalSubmit1').click(function () {
        _PurchaseInvoiceSubmit();
    });
    _AgencyNewAttendanceDdl();
    function _AgencyNewAttendanceDdl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0, 'DeptId': $("#DeptId1").val() }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
        });
    }
    _Departmentddl();
    function _Departmentddl() {
        $.post('/Invoice/_AvoDepartmentddlNew2', { 'Id': 0 }, function (data) {
            var DeptIdvar = '<option value="0">---select---</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptIdvar += '<option value=' + value.DeptId + '>' + value.departmentName + '</option>';
            });
            $('#DeptId1').html(DeptIdvar);
        });
    }

    function _NewBiillingAdress() {
        $.post('/Invoice/AddressDDlnew', {
            'AgencyId': 0,
            'DeptId': $("#DeptId1").val(),
            'WorkOrderAgencyId': 0,
        }, function (data) {
            var DeploymentOfficeId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AddressId + '>' + value.BillingAddress + '</option>'
            });
            $('#BillingId').html(DeploymentOfficeId);
        });
    }



    function _DEPTMasterList() {
        $('#ProgressImg').show();
        $.post('/Invoice/DepartmentOutstandingViewList',
            {
                'BillId': 0,
                'MonthId':0,
                'BillingAddress': $("#BillingId").val(),

            },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var table = $('#myTable').DataTable();
                table.clear().draw();
                var msr = 0;
                $.each(obj, function (key, value) {
                    msr += 1;
                    var printSale = '<a href="#" onclick="openPopupInvoice(' + value.AddressId + ')" class="img-circle"style="text-align:center; font-size:16px;">Print HPSEDC OutStanding Letter<ion-icon name="document"></ion-icon></a>';

                    var elmntArray = [
                        msr,
                        value.departmentName,
                        value.BillingAddress,
                        value.totalInv,
                        value.TotalAmt,
                        value.PaymentAmt,
                        value.GSTTds2,
                        value.Tds2,
                        parseFloat(value.BalanceAmt).toFixed(2),
                        printSale
                    ];
                    table.row.add(elmntArray).draw(false);
                });
            });
    }
    function openPopupInvoice(id) {
    var popupUrl = '@Url.Action("HpsedcOutStandingLetter", "Invoice")' + '?BillingId=' + id;
    var features = 'width=600,height=400,status=no,toolbar=no,menubar=no,location=no';
    window.open(popupUrl, '_blank');
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>