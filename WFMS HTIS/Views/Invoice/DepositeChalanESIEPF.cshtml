

@{
    ViewBag.Title = "Deposit Challan";
    ViewBag.PageTitle = "Deposit Challan";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        font-family: Arial;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 41px;
            transition: 0.3s;
            font-size: 15px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
    }

    .modal-footer {
        display: block;
    }

    #Submit {
        width: 120px;
        margin-left: 57px;
        margin-top: -12rem;
        margin-left: 57px;
        font-size: 16px;
        border-radius: 8px !important;
    }
</style>

<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>
        @*<li>
                <a href="#"></a>
            </li>*@
        <li class="active">@ViewBag.PageTitle</li>
    </ul><!-- /.breadcrumb -->

</div>
@******************Breadcrumb End**************@

<div class="page-content">

    @*********Page Content************@
    <div>
        <div class="panel panel-default">
            <div class="panel-heading"><b>DEPOSIT CHALLAN ENTRY</b></div>

            <div class="panel-body" id="form">
                <div class="container-fluid" id="show">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group row">
                            <div class="col-md-3">

                                <label for="Month">Month Year</label><span class="error-message">*</span><br />
                                <div class="" style="display:flex">
                                    <select id="ddlMonths" class="Month" style="width: 15rem;" onchange="">
                                        <option>--Month--</option>
                                        @for (int i = 1; i <= 12; i++)
                                        {

                                            DateTime date = new DateTime(2020, i, 1);
                                            mon = date.ToString("MMM");
                                            <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                        }
                                    </select>
                                    <select id="ddlYears" class="year" style="width: 15rem;" onchange="">
                                        <option>--Year--</option>
                                        @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                        {
                                            if (i == DateTime.Now.Year)
                                            {
                                                <option value="@i" selected='selected'>@i</option>
                                            }
                                            else
                                            {
                                                <option value="@i">@i</option>
                                            }
                                        }
                                    </select>

                                </div>

                            </div>
                            <div class="col-md-3">
                                <label for="AgencyName">Agency Name</label><span class="error-message">*</span></br>
                                <select id="ddlAgency" style="width: 30rem">
                                    <option value="0">--Select Agency--</option>
                                </select>
                            </div>

                            <div class="col-md-3" hidden>
                                <label for="BankName">Bank Name</label><span class="error-message">*</span></br>
                                <select id="BankId" style="width: 30rem" onchange="">
                                    <option value="0">--Select Bank--</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="Chalan">Challan Type</label><span class="error-message">*</span></br>
                                <select id="Challanfor" style="width: 30rem" onchange="">
                                </select>
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label for="ChalanNo">Challan No.</label><span class="error-message">*</span>
                                <input type="text" id="ChallanNo" style="width: 30rem" class="form-control cleartxt" placeholder="Chalan Number" />

                            </div>
                            <div class="col-md-3">
                                <label for="ChalanDate">Challan Date</label><span class="error-message">*</span><br />
                                <input type="text" data-date-format="d-M-yyyy" value="@DateTime.Now.ToString("d-MMM-yyyy")" class="datepicker datepickertxt form-control readonly" name="BillDate" id="ChalanDate" readonly="readonly" />

                            </div>
                            <div class="col-md-3">
                                <label for="No.of Resouserces">No.of HPSEDC Resources</label><span class="error-message">*</span>
                                <input type="text" id="NoofResources" style="width: 30rem" class="form-control cleartxt" placeholder="No. Of Resources" />
                            </div>

                            <div class="col-md-3">
                                <label for="Challan">Challan Amount</label><span class="error-message">*</span>
                                <input type="text" id="ChallanAmount" style="width: 30rem;" placeholder="Total Amount" class="form-control cleartxt" />
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label for="Upload">Upload Challan Payment Confirmation Recipt</label><span class="error-message">*</span>
                                <input type="file" name="file" id="EsiChallanDoc" style="width: 30rem; height: 34px;" multiple="" />
                                <small style="color: red;">* Only PDF files are allowed</small>
                                <a onclick="ViewDocument()" id="ChallanAttachment" style="font-size: 14px; margin-left: 20px;">View Doc.</a><br />

                            </div>
                            <div class="col-md-3">
                                <label for="Upload">Upload Employee Details(ECR)</label><span class="error-message">*</span>
                                <input type="file" name="file" id="ChallanDetailsDoc" style="width: 30rem; height: 34px;" multiple="" />
                                <small style="color: red;">* Only PDF files are allowed</small>
                                <a onclick="ViewDocument2()" id="ChallanAttachment2" style="font-size: 14px; margin-left: 20px;">View Doc.</a><br />

                            </div>
                            <div class="col-md-6">
                                <input type="checkbox" id="DeclerationCheckbox">
                                <label for="DeclerationCheckbox">
                                    Declaration
                                </label>
                                <br />
                                I/We hereby declare that the submitted ESIC and EPF challan details and the corresponding uploaded documents are genuine, accurate, and in full compliance with all statutory requirements. We accept full responsibility for the veracity of this information and understand that our agency is liable for any inaccuracies or delays in statutory payments.
                                <br>
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="row">
                                <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                                <div class="col-md-8">
                                    <div class="modelalert"></div>
                                </div>
                                <div class="col-md-2">
                                    <input type="submit" id="Submit" class="btnModalSubmit btn btn-primary " value="Submit" disabled style="margin-top: -14px; margin-left: -49px;" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div>
                <div class="panel panel-default">
                    <div class="panel-body">

                        <div class="row">
                            &nbsp;
                            <div class="col-md-12">
                                <div align="left" id="">
                                    <div class="dt-responsive">
                                        <table class="table table-striped table-bordered" id="myTable">
                                            <thead>
                                                <tr>
                                                    <th class="widthsr">Sr.No.</th>
                                                    <th>Month Year</th>
                                                    <th>Agency Name</th>
                                                    <th>Challan Type</th>
                                                    <th>Challan Number</th>
                                                    <th>Challan Date</th>
                                                    <th>No.of HPSEDC Resources</th>
                                                    <th>Total Challan Amount</th>
                                                    <th>View Payment <br />Recipt & ECR</th>
                                                    <th>View Employee <br />Details</th>
                                                    <th>Edit</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>

</div>



<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var accessRights;
    var vId = 0;
    var sr = 0;
    var IsActive = 'Y';
    var tableRow;
    //var user = @Session["RoleId"];


    $(document).ready(function () {
        TableManageDefault.init();
        _ChallanBankddl();
        _AgencyNameDDL();
        ChalanForddl();
        $('#ddlAgency').select2();
        _ChallanEsiEpfList();


    });


    $('#DeclerationCheckbox').change(function () {
        if ($(this).is(':checked')) {
            $('#Submit').prop('disabled', false);
        } else {
            $('#Submit').prop('disabled', true);
        }
    });


    //DepositeChallanESIEPF

    function _ChallanBankddl() {
        var Challanbanklist = '<option value="0">--Select--</option>';
        $.post('/Invoice/_ChallanBankddl',
            {},
            function (data) {
                var obj = $.parseJSON(data);
                $.each(obj, function (key, value) {
                    Challanbanklist += '<option value=' + value.Id + '>' + value.BankName + '</option>';
                });
                $('#BankId').html(Challanbanklist);

            }
        );
    }


    function _AgencyNameDDL() {
        $.post('/Invoice/_AgencyNameDDL', { 'AgencyId': 0 }, function (data) {
            var AgencyName = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                AgencyName += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(AgencyName);
           // $('#ddlAgency').val(mAgencyId);


        });

        $('#ddlAgency').select2({
            dropdownParent: $('#update-Country')
        });
    }

    $('.btnModalSubmit').click(function () {
        _DepositeChallanEsiEpfSubmit();
    });
    function _DepositeChallanEsiEpfSubmit() {

        var monthyear = $('#ddlMonths').val() + $('#ddlYears').val();

        if ($('#ddlMonths').val() == "--Month--" || $('#ddlYears').val() == "--Year--") {
            $('.modelalert').html('Please select Month and Year.');
            return;
        }
        if ($('#ddlAgency').val() == '0') {
            alert('Please select Agency.');
            return;
        }

        if ($('#Challanfor').val() == '0') {
            alert('Please select ChallanFor');
            return;
        }
        if ($('#ChallanNo').val() == '') {
            alert('Please Enter Challan No.');
            return;
        }
        if ($('#NoofResources').val()=='') {
            alert('Please enter No. of Resources');
            return;
        }
        if ($('#ChallanAmount').val() == '') {
            alert('Please enter Challan Amount');
            return;
        }
        if ($('#EsiChallanDoc')[0].files.length === 0) {
            alert("Please Upload Challan Document");
            return;
        }
        if ($('#ChallanDetailsDoc')[0].files.length === 0) {
            alert("Please Upload Challan Details Document");
            return;
        }
       // $('#loader-overlay').show();

        var ChallanFiles = $('#EsiChallanDoc')[0].files[0];

        var ChallanNo = $('#ChallanNo').val().trim().replace(/\s+/g, '_');
        var Challanfor = $('#Challanfor').val();

        var timestamp = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);
        var attachmentfileExtension = ChallanFiles.name.split('.').pop();
        var newAttachmentFileName = `Challan_${Challanfor}_${ChallanNo}_${timestamp}.${attachmentfileExtension}`;
        var renamedEsiChallanFile = new File([ChallanFiles], newAttachmentFileName, { type: ChallanFiles.type });



        var ChallanDetailsFiles = $('#ChallanDetailsDoc')[0].files[0];

        var ChallanNo = $('#ChallanNo').val().trim().replace(/\s+/g, '_');
        var timestamp = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);
        var attachmentfileExtension = ChallanDetailsFiles.name.split('.').pop();
        var newAttachmentFileName = `Challan_EmpDetails_${ChallanNo}_${timestamp}.${attachmentfileExtension}`;
        var renamedChallanDetailsFile = new File([ChallanDetailsFiles], newAttachmentFileName, { type: ChallanDetailsFiles.type });


        var formData = new FormData();
        formData.append("EsiChallanDoc", renamedEsiChallanFile);
        formData.append("ChallanDetailsDoc", renamedChallanDetailsFile);


        // Add other form data
        formData.append("ChallanId", vId);
        formData.append("BillForMonth", monthyear);
        formData.append("AgencyId", $("#ddlAgency").val());
        formData.append("BankName", 0);
        formData.append("ChallanFor", $("#Challanfor").val());
        formData.append("ChallanNumber", $("#ChallanNo").val());
        formData.append("ChallanDate", $("#ChalanDate").val());
        formData.append("NoOfResource",$("#NoofResources").val());
        formData.append("Amount", $("#ChallanAmount").val());
        formData.append("IsDeclaration", 'Y');

        $.ajax({
            type: "POST",
            url: "/Invoice/_DepositeChallanEsiEpfSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
              //  $('#loader-overlay').hide();
                alert(data);
                _ChallanEsiEpfList();
                $('.cleartxt').val('');
                $('#ddlAgency').val("0").trigger('change');
                //$('#BankId').val('0').trigger('change');
                $('#Challanfor').val('0').trigger('change');
                $('#EsiChallanDoc').val('');
                $('#ChallanDetailsDoc').val('');
                $('#DeclerationCheckbox').prop('cheked', false);


            },

        });
    }
    function ChalanForddl() {
        $.post('/Invoice/ChalanForddl',
            {},
            function (data) {
                var chalanfor = '<option value="0">---Select---</option>';
                var obj = $.parseJSON(data);
                $.each(obj, function (key, value) {
                    chalanfor += '<option value=' + value.TypeId + '>' + value.TypeName + '</option>'
                });
                $('#Challanfor').html(chalanfor);
            });
    }

    var ChallanDocument = '';
    var ChallanDocument2 = '';



    function ViewDocument() {
        window.open(`/ChallanDoc/${ChallanDocument}`, target = "_blank");
    }
    function ViewDocument2() {
        window.open(`/ChallanDetailsDoc/${ChallanDocument2}`, target = "_blank");
    }
    function fillForm(ChallanId) {

       // $('#ModalProgress').show();

       // $('.modelalert').html('Please wait');

        $.post('/Invoice/_ChallanEsiEpfEdit', {

            'ChallanId': vId,

        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                //$('#ModalProgress').hide();

                // $('.modelalert').html('');

                //var obj = $.parseJSON(data);

                $('#ddlAgency').val(value.AgencyId).trigger('change');

                $('#Challanfor').val(value.ChallanFor);
                $('#ChallanNo').val(value.ChallanNumber);
                $('#ChalanDate').val(value.ChallanDate);
                $('#NoofResources').val(value.NoOfResource);
                $('#ChallanAmount').val(value.Amount);


                $('#ddlMonths').val(value.BillForMonth.toString().substring(0, 1));
                $('#ddlYears').val(value.BillForMonth.toString().substring(1));

                ChallanDocument = value.AttacheChallan;
                ChallanDocument2 = value.AttacheChallanDetails;


               // $('#EsiChallanDoc').attr('href', '/ChallanDoc/' + value.AttacheChallan);;
                //DeliveryAttachment = value.DeliveryAttachment;
               // DeliveryAttachment = value.AttacheChallan;

                //$('#DeptId').val(value1.DeptId).trigger('change');

            });

        });

    }

    var vId;
    function OpenUpdateModel(ChallanId) {

        alert(ChallanId);

       // $('.modal-title').html("Update Department Email & Billing Address");

        //$('#form').modal({

        //    show: 'false'

        //});

        vId = ChallanId;

        fillForm(vId);

        //sr = tableRowColumnsData[0];

        root = '/Invoice/_DepositeChallanEsiEpfSubmit';

        //$('.modal-footer').show();

    }

    //var ChallanId;
    function _ChallanEsiEpfList() {
        //var monthyear = $('#ddlMonths').val() + $('#ddlYears').val();

        $('#ProgressImg').show();
        $.post('/Invoice/_ChallanEsiEpfList', {
            'ChallanId': vId,
            'AgencyId': 0,//$("#ddlAgency").val(),
            'MonthYear': 0,
            'ChallanType':0

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;
                var ChallanDocument;
                var ChallanDocument2

                if (value.AttacheChallan == '' || value.AttacheChallan == null) {
                    ChallanDocument = '<label class="text-center" >-</label>';
                }
                else {
                    ChallanDocument = '<a href="/ChallanDoc/' + value.AttacheChallan + '"target="_blank" data-toggle="tooltip" title="Download file" style="text-align:center; font-size:30px;"><i class="fa fa-download"></i></a>';
                }

                if (value.AttacheChallanDetails == '' || value.AttacheChallanDetails == null) {
                    ChallanDocument2 = '<label class="text-center" >-</label>';
                }
                else {
                    ChallanDocument2 = '<a href="/ChallanDetailsDoc/' + value.AttacheChallanDetails + '"target="_blank" data-toggle="tooltip" title="Download file" style="text-align:center; font-size:30px;"><i class="fa fa-download"></i></a>';
                }

                var btnEdit = '<a href="#" onclick="OpenUpdateModel(\'' + value.ChallanId + '\', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';


                var elmntArray = [
                    msr,
                    value.BillForMonth,
                    value.AgencyName,
                    value.ChallanType,
                    value.ChallanNumber,
                    value.ChallanDate,
                    value.NoOfResource,
                    value.Amount.toFixed(2),
                    ChallanDocument,
                    ChallanDocument2,
                    btnEdit

                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }

</script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>