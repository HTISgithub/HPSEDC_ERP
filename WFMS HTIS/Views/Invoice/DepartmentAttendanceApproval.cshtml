                            <input type="text" id="Branch" class="form-control" placeholder="Department">
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Customer/Vendor  </label>
                        <div class="col-md-6">
