                        <label class="col-md-4 control-label">Month Year<i class="text-danger">*</i></label>
                        <div class="col-md-6">
                            <div>


                                <select id="ddlMonth" class="Month">
                                    <option>--Month--</option>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        mon = new DateTime(DateTime.Now.Year, i, 1).ToString("MMM", CultureInfo.InvariantCulture);
                                        <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                    }
                                </select>
                                <select id="ddlYear" class="year">
                                    <option>--Year--</option>
                                    @for (int i = 2018; i <= DateTime.Now.Year; i++)
                                    {
                                        if (i == DateTime.Now.Year)
                                        {
                                            <option value="@i" selected='selected'>@i</option>
                                        }
                                        else
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                </select>

                                <!--<input placeholder="From Date" data-date-format="M-yyyy" class="form-control datepicker readonly" readonly="readonly" id="FromDate" value="@DateTime.Now.ToString("MMM-yyyy")">-->
                                @*<span class="input-group-addon">to</span>
                                    <input placeholder="Upto Date" autocomplete="off" class="form-control text-box single-line datepicker" id="ToDate" type="datetime" value="">*@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Department </label>
                        <div class="col-md-6">
