                            row.find('.LeaveDays').val('0');
                            row.find('.Weekoff').val('0');
                            row.find('.Holidays').val('0');
                        }
                    });
                    $('.Weekoff').change(function () {
                        var row = $(this).closest("tr");
                        //var Absent = row.find('.AbsentDays').val();
                        var Days = row.find('.Days').text();
                        var PresentDay = row.find('.PresentDays').val();
                        var LeaveDays = row.find('.LeaveDays').val();
                        var WeekOff = row.find('.Weekoff').val();
                        var Holidays = row.find('.Holidays').val();
                        row.find('.AbsentDays').val(Days - (parseInt(PresentDay) + parseInt(LeaveDays) + parseInt(Holidays) + parseInt(WeekOff)));
                        // alert(parseInt(PresentDay + LeaveDays + WeekOff + Holidays));
                        row.find('.PayDays').text(parseInt(PresentDay) + parseInt(LeaveDays) + parseInt(WeekOff) + parseInt(Holidays));
                        if (parseInt(PresentDay) + parseInt(LeaveDays) + parseInt(WeekOff) + parseInt(Holidays) > Days) {
                            row.find('.PayDays').text(row.find('.Days').text());
                            row.find('.PresentDays').val(row.find('.Days').text());
                            row.find('.LeaveDays').val('0');
                            row.find('.Weekoff').val('0');
                            row.find('.Holidays').val('0');
                        }
                    });
                    $('.Holidays').change(function () {
                        var row = $(this).closest("tr");
                        //var Absent = row.find('.AbsentDays').val();
                        var Days = row.find('.Days').text();
                        var PresentDay = row.find('.PresentDays').val();
