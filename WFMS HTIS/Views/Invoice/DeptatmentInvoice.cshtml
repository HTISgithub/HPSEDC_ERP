    BankListpp();
    function BankListpp() {
        var banklist1 = '<option value="0">--Select--</option>';
        $.post('/Invoice/BankListpp',
            {},
            function (data) {
                var obj = $.parseJSON(data);
                $.each(obj, function (key, value) {
                    banklist1 += '<option value=' + value.Id + '>' + value.BankName + '</option>';
                });
                $('#bankNamepp').html(banklist1);

            }
        );
    }
    _PaymentModeddlpp();
    function _PaymentModeddlpp() {
        $.post('/Invoice/_PaymentModeddlpp', { 'Id': 0 }, function (data) {
            var ModePaymentpp = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                ModePaymentpp += '<option value=' + value.Id + '>' + value.ModeofPayment + '</option>'
            });
            $('#ModePaymentpp').html(ModePaymentpp);

        });
    }

    function _DeptPartialPaySubmit() {

        if ($('#Transactionpp').val() == '') {
            $('.modelalert').html('Please Enter Transaction Id');
            return;
        }
        if ($('#ModePaymentpp').val() == '0') {
            $('.modelalert').html('Please Select Mode Of Payment');
            return;
        }
        if ($('#bankNamepp').val() == '0') {
            $('.modelalert').html('Please Select Bank');
            return;
        }
        if ($('#PaymentDatepp').val() == '') {
            $('.modelalert').html('Please Choose Payment Date');
            return;
        }

        if ($('#Remarkspp').val() == '') {
            $('.modelalert').html('Please Enter Remarks');
            return;
        }


        $('.modelalert').html('');
        $('#ModalProgress').show();
        $.post('/Invoice/_DeptPartialPaySubmit', {
            'DeptBillId': 0,
            'AgencyBillId': AgencyBilldept,
            'BankNameId': $('#bankNamepp').val(),
            'ModePayment': $('#ModePaymentpp').val(),
            'Transaction': $('#Transactionpp').val(),
            //'PaymentAmount': $('#PaymentAmount').val(),
            'PaymentAmount': Math.round($('#PaymentAmountpp').val()),
            'Balance': $('#Balancepp').val(),
            'GSTTDS': $('#GSTTDSpp').val(),
            'TDS': $('#TDSpp').val(),
            'PaymentDate': $('#PaymentDatepp').val(),
            'Remarks': $('#Remarkspp').val(),

        }, function (data) {
            alert(data);
            // vId = 0;
            //$('#myModalDeptPatialPayment').modal('hide');
            // $('.btnModalSubmit6').removeAttr("disabled");
            $('#ModalProgress').hide();
            _deptPartialPayList(AgencyBilldept);
        });
    }

    $('.btnModalSubmit6').click(function () {
        $('#myModalDeptPatialPayment').modal('hide');

    });
    function _deptPartialPayList(AgencyBillId) {

        // console.log(SaleOrderId)
        $('#ProgressImg').show();
        $.post('/Invoice/_deptPartialPayList',
            {
                'AgencyBillId': AgencyBillId

            },
            function (data) {
                console.log(data)
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var PartialPaymentTable = $('#PartialPaymentTable').DataTable(
                    {
                        destroy: true,
                        scrollY: "130px",
                        scrollX: true,
                        //scrollCollapse: true,
                        //paging: false
                    });

                PartialPaymentTable.clear().draw();
                var msr = 0;
                $.each(obj, function (key, value) {

                    msr += 1;
                    var elmntArray = [
                        msr,
                        value.TransactionId,
                        value.ModeofPayment,
                        value.BankName,
                        value.ReceivedAmt,
                        value.GSTTds2 + '<br>' + value.GSTTds2,
                        value.BalanceAmt


                    ];
                    PartialPaymentTable.row.add(elmntArray).draw(false);
                });
            });
    }


