    function calculateAdminCharge2() {
        var basicAmount = parseFloat(document.getElementById("AgencyBillPurchase").value) || 0;
        var adminCharge = (basicAmount * 2.5) / 100;
        document.getElementById("AdminPurchase").value = adminCharge.toFixed(2);

        var libaryChargeInput = document.getElementById("LibaryPurchase");
        var libaryCharge = parseFloat(libaryChargeInput.value) || 0;

        // Jab Library Charge blank ho, tab usme '0' show ho
        if (libaryChargeInput.value.trim() === "") {
            libaryChargeInput.value = "0";
        }

        // Total Before GST (Agar Library Charge > 0 hai tabhi add ho)
        var totalBeforeTax = basicAmount + adminCharge + libaryCharge;

        // GST Calculation
        var cgst = (totalBeforeTax * 9) / 100;
        var sgst = (totalBeforeTax * 9) / 100;

        document.getElementById("cgstPurchase").value = cgst.toFixed(2);
        document.getElementById("SGSTPurchase").value = sgst.toFixed(2);
        document.getElementById("IGSTPurchase").value = "0"; // Default IGST = 0

        var totalAmount = totalBeforeTax + cgst + sgst;
        document.getElementById("TotalPurchase").value = totalAmount.toFixed(2);
    }

    // IGST Checkbox Event Listener
    document.getElementById("showIGST").addEventListener("change", function () {
        var igstInput = document.getElementById("igstInputContainer");
        if (this.checked) {
            igstInput.style.display = "block";

            var sgstValue = parseFloat(document.getElementById("SGSTPurchase").value) || 0;
            var igst = sgstValue * 2;

            document.getElementById("IGSTPurchase").value = igst.toFixed(2);
            document.getElementById("SGSTPurchase").value = "0";
            document.getElementById("cgstPurchase").value = "0";
        } else {
            igstInput.style.display = "none";
            document.getElementById("IGSTPurchase").value = "0";
            calculateAdminCharge2();
        }
    });

    // Library Charge Input Event
    document.getElementById("LibaryPurchase").addEventListener("input", function () {
