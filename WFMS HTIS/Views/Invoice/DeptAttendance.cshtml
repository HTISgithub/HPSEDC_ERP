    function _AgencyUploadAttendanceSubmit() {

        var Anneexture = $("#Uploadannexure1").get(0);
        var AnnexureFiles = Anneexture.files;

        var AgencyBillAtt = $("#UploadAgencyBill1").get(0);
        var AgencyBillFiles = AgencyBillAtt.files;



        // Annexure file validation

        if (AnnexureFiles.length === 0) {
            alert('Please upload an Annexure file.');
            return;
        } else {
            for (let i = 0; i < AnnexureFiles.length; i++) {
                if (AnnexureFiles[i].type !== "application/pdf") {
                    alert('Only PDF files are allowed for Annexure file.');
                    return;
                }
                if (AnnexureFiles[i].name.includes(" ")) {
                    alert('File name for Annexure file should not contain spaces.');
                    return;
                }
            }
        }


        // Agency Bill File Validation

        if (AgencyBillFiles.length === 0) {
            alert('Please upload an Agency Bill file.');
            return;
        } else {
            for (let i = 0; i < AgencyBillFiles.length; i++) {
                if (AgencyBillFiles[i].type !== "application/pdf") {
                    alert('Only PDF files are allowed for Agency Bill.');
                    return;
                }
                if (AgencyBillFiles[i].name.includes(" ")) {
                    alert('File name for Agency Bill should not contain spaces.');
                    return;
                }
            }
        }


        $('.btnModalSubmit3').attr("disabled", "disabled");
        $('#ModalProgress').show();

        var formData = new FormData();

        // Get current date and time for file name
        var now = new Date();
        var formattedDate = now.getFullYear().toString()
            + String(now.getMonth() + 1).padStart(2, '0')
            + String(now.getDate()).padStart(2, '0');
        var formattedTime = String(now.getHours()).padStart(2, '0')
            + String(now.getMinutes()).padStart(2, '0');
        var timestamp = `${formattedDate}_${formattedTime}`;

        // Get dynamic values for filename
        var Deptt = $('#deptt1').val().replace(/\s+/g, '');
        //var month = $('#monthyear1').val();
        var agency = $('#agencyId1').val().replace(/\s+/g, '');
        var baseFileName = `DEPT_${Deptt}_AGY_${agency}_${timestamp}`;

        // Rename function
        function renameFile(originalFile, newName) {
            return new File([originalFile], newName, {
                type: originalFile.type,
                lastModified: originalFile.lastModified,
            });
        }

                //Add Annexure file(s)
        $.each(AnnexureFiles, function (key, value) {
            var ext = value.name.split('.').pop();
            var newFile = renameFile(value, `${baseFileName}_Annexure.${ext}`);
            formData.append("UploadAnnexureFile", newFile);
        });

         //Add Agency Bill file(s)
        $.each(AgencyBillFiles, function (key, value) {
            var ext = value.name.split('.').pop();
            var newFile = renameFile(value, `${baseFileName}_AgencyBill.${ext}`);
            formData.append("UploadAgencyBill", newFile);
        });

        // Add other form data
        formData.append("Id", vvId);
        $.ajax({
            type: "POST",
            url: "/Invoice/_AgencyUploadAttendanceSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                alert(data);
                resetForm();
                $('.btnModalSubmit3').removeAttr("disabled");
                $('#ModalProgress').hide();
                _GstReportList();
                $('#myModalUpload').modal('hide');
                $('.modelalert').html('');
            },
            error: function () {
                $('.modelalert').html('An error occurred while submitting the form.');
                $('.btnModalSubmit3').removeAttr("disabled");
                $('#ModalProgress').hide();
            }
        });
    }
