    function _NewDeptAttendanceSubmit() {
        var WorkOfferAtt = $("#Upload").get(0);
        var WorkOfferFiles = WorkOfferAtt.files;

        var Anneexture = $("#Uploadannexure").get(0);
        var AnnexureFiles = Anneexture.files;

        var AgencyBillAtt = $("#UploadAgencyBill").get(0);
        var AgencyBillFiles = AgencyBillAtt.files;

        var monthyeardept = $('#ddlMonthsdept').val() + $('#ddlYearsdept').val();

        if ($('#ddlMonths').val() == "--Month--" || $('#ddlYears').val() == "--Year--") {
            $('.modelalert').html('Please select Month and Year.');
            return;
        }
        if ($('#DeptId1').val() == '0') {
            alert('Please select Department.');
            return;
        }
        if ($('#ddlAgency').val() == '0') {
            alert('Please select Agency.');
            return;
        }
        if ($('#Work').val() == '0') {
            alert('Please select Work Order No.');
            return;
        }
        if ($('#BillingId').val() === '0') {
            alert('Please select Billing Address');
            return;
        }
        if ($('#UpladNoOfResource').val().trim() == '') {
            alert('Please enter No. of Resources to give Attendance.');
            return;
        }

        // Attendance file validation
        if (WorkOfferFiles.length === 0) {
            alert('Please upload an Attendance file.');
            return;
        } else {
            for (let i = 0; i < WorkOfferFiles.length; i++) {
                let file = WorkOfferFiles[i];
                let allowedTypes = ["application/pdf", "image/jpeg"];
                if (!allowedTypes.includes(file.type)) {
                    alert('Only PDF or JPG files are allowed for Attendance file.');
                    return;
                }
                if (file.name.includes(" ")) {
                    alert('File name for Attendance file should not contain spaces.');
                    return;
                }
            }
        }

        // Annexure file validation

            if (AnnexureFiles.length === 0) {
                alert('Please upload an Annexure file.');
                return;
            } else {
                for (let i = 0; i < AnnexureFiles.length; i++) {
                    if (AnnexureFiles[i].type !== "application/pdf") {
                        alert('Only PDF files are allowed for Annexure file.');
                        return;
                    }
                    if (AnnexureFiles[i].name.includes(" ")) {
                        alert('File name for Annexure file should not contain spaces.');
                        return;
                    }
                }
            }


        // Agency Bill File Validation

            if (AgencyBillFiles.length === 0) {
                alert('Please upload an Agency Bill file.');
                return;
            } else {
                for (let i = 0; i < AgencyBillFiles.length; i++) {
                    if (AgencyBillFiles[i].type !== "application/pdf") {
                        alert('Only PDF files are allowed for Agency Bill.');
                        return;
                    }
                    if (AgencyBillFiles[i].name.includes(" ")) {
                        alert('File name for Agency Bill should not contain spaces.');
                        return;
                    }
                }
            }


        $('#Submit').attr("disabled", "disabled");
        $('#ModalProgress').show();

        var formData = new FormData();

        // Get current date and time for file name
        var now = new Date();
        var formattedDate = now.getFullYear().toString()
            + String(now.getMonth() + 1).padStart(2, '0')
            + String(now.getDate()).padStart(2, '0');
        var formattedTime = String(now.getHours()).padStart(2, '0')
            + String(now.getMinutes()).padStart(2, '0');
        var timestamp = `${formattedDate}_${formattedTime}`;

        // Get dynamic values for filename
        var dept = $('#DeptId1 option:selected').text().replace(/\s+/g, '');
       // var month = $('#ddlMonthsdept').val();
        var agency = $('#ddlAgency option:selected').text().replace(/\s+/g, '');
        var baseFileName = `DEPT_${dept}_AGY_${agency}_${timestamp}`;

        // Rename function
        function renameFile(originalFile, newName) {
            return new File([originalFile], newName, {
                type: originalFile.type,
                lastModified: originalFile.lastModified,
            });
        }

        // Add Attendance file(s)
        $.each(WorkOfferFiles, function (key, value) {
            var ext = value.name.split('.').pop();
            var newFile = renameFile(value, `${baseFileName}_Attendance.${ext}`);
            formData.append("UploadFile", newFile);
        });

        // Add Annexure file(s)
        $.each(AnnexureFiles, function (key, value) {
            var ext = value.name.split('.').pop();
            var newFile = renameFile(value, `${baseFileName}_Annexure.${ext}`);
            formData.append("UploadAnnexureFile", newFile);
        });

        // Add Agency Bill file(s)
        $.each(AgencyBillFiles, function (key, value) {
            var ext = value.name.split('.').pop();
            var newFile = renameFile(value, `${baseFileName}_AgencyBill.${ext}`);
            formData.append("UploadAgencyBill", newFile);
        });

        // Add other form data
        formData.append("WorkOrderNo", $('#Work').val());
        formData.append("NoOfResources", $('#NoofResources').val());
        formData.append("Agency", $('#ddlAgency').val());
        formData.append("Department", $('#DeptId').val());
        formData.append("UpladNoOfResource", $('#UpladNoOfResource').val());
        formData.append("MonthYear", monthyeardept);

        $.ajax({
            type: "POST",
            url: "/Invoice/_NewDeptAttendanceSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                alert(data);
                resetForm();
                $('#Submit').removeAttr("disabled");
                $('#ModalProgress').hide();
                _GstReportList();
                $('#myModal').modal('hide');
                $('.modelalert').html('');
            },
            error: function () {
                $('.modelalert').html('An error occurred while submitting the form.');
                $('#Submit').removeAttr("disabled");
                $('#ModalProgress').hide();
            }
        });
    }


