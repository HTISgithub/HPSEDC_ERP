
@{
    ViewBag.Title = "Department Attendance";
    ViewBag.PageTitle = "Department Attendance";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}
<style>
    body {
        font-family: Arial;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 41px;
            transition: 0.3s;
            font-size: 15px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
    }

    .modal-footer {
        display: block;
    }
</style>
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>
        @*<li>
                <a href="#"></a>
            </li>*@
        <li class="active">@ViewBag.PageTitle</li>
    </ul><!-- /.breadcrumb -->

</div>
@******************Breadcrumb End**************@



<div class="page-content">
    @*********Page Title************@

    @*<div class="page-header">
            <h1>
                @ViewBag.PageTitle
                <a class="btn btn-primary pull-right" onclick="OpenAddModel()"><i class="fa fa-plus"></i> Add New</a>
            </h1>
        </div>*@
    @*********Page End************@

    @*********Page Content************@
    <div>
        <div class="panel panel-default">
            <div class="panel-heading"><b>Department Attendance</b></div>

            <div class="panel-body">
                <div class="container-fluid" id="show">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group row">
                            <div class="col-md-3">

                                <label for="Month">Month Year</label><span class="error-message">*</span><br />

                                <select id="ddlMonthsdept" class="Month" style="width: 15rem;" onchange="_GstReportList()">
                                    <option>--Month--</option>
                                    @for (int i = 1; i <= 12; i++)
                                    {

                                        DateTime date = new DateTime(2020, i, 1);
                                        mon = date.ToString("MMM");
                                        <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                    }
                                </select>
                                <select id="ddlYearsdept" class="year" style="width: 15rem;" onchange="_GstReportList()">
                                    <option>--Year--</option>
                                    @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                    {
                                        if (i == DateTime.Now.Year)
                                        {
                                            <option value="@i" selected='selected'>@i</option>
                                        }
                                        else
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="Complaint">Department</label><span class="error-message">*</span></br>
                                <select id="DeptId1" style="width: 30rem" onchange="_AgencyNewAttendanceDdl();">
                                    <option value="0">Select</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="Complaint">Agency</label><span class="error-message">*</span></br>
                                <select id="ddlAgency" style="width: 30rem" onchange="_WorkOrderDetails();">
                                    <option value="0">Select Agency</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="Complaint">Work Order No.</label><span class="error-message">*</span>
                                <select id="Work" class="clearddl" style="width: 30rem" onchange="_NewBiillingAdress();">
                                    <option value="0">--Select Work Order--</option>
                                </select>
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-6">
                                <label for="Billing">Billing Address</label><span class="error-message">*</span><br />
                                <select id="BillingId" class="clearddl" style="width: 652px; height: 34px" onchange="_NoOfResources();">
                                    <option value="0">Select Billing Address</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="NoofResouserces">No. Of Resources</label><span class="error-message">*</span>
                                <input type="text" id="NoofResources" style="width: 30rem" class="form-control cleartxt" placeholder="No. Of Resources" readonly />
                            </div>
                            <div class="col-md-3">
                                <label for="UplodedResources">No. Of Present Resources</label><span class="error-message">*</span>
                                <input type="text" id="UpladNoOfResource" style="width: 30rem;" placeholder="No Of Resources" class="form-control cleartxt" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label for="Upload">Upload Attendance File</label><span class="error-message">*</span>
                                <input type="file" id="Upload" style="width: 30rem; height: 34px;" class="form-control cleartxt" />
                                <small style="color: red;">* Only PDF files are allowed</small>
                            </div>


                            @if (user == "48")
                            {
                                <div class="col-md-3">
                                    <label for="Upload">Upload Annexure File (5%)</label><span class="error-message">*</span>
                                    <input type="file" id="Uploadannexure" style="width: 30rem; height: 34px;" class="form-control cleartxt" />
                                    <small style="color: red;">* Only PDF files are allowed</small>
                                </div>
                                <div class="col-md-3">
                                    <label for="Upload">Upload Agency (Bill+Annexure 2.5%)</label><span class="error-message">*</span>
                                    <input type="file" id="UploadAgencyBill" style="width: 30rem; height: 34px;" class="form-control cleartxt" />
                                    <small style="color: red;">* Only PDF files are allowed</small>
                                </div>
                            }

                        </div>

                        @if (user == "48")
                        {


                            <div class="form-group row">
                                <div class="row">
                                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                                    <div class="col-md-8">
                                        <div class="modelalert"></div>
                                    </div>
                                    <div class="col-md-2">
                                        <input type="submit" id="Submit" style="width: 130px; margin-left: 57px; margin-top: -12rem;" class="btn btn-primary cleartxt" value="Submit" />
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-group row">
                                <div class="row">
                                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                                    <div class="col-md-8">
                                        <div class="modelalert"></div>
                                    </div>
                                    <div class="col-md-2">

                                        <input type="button" id="Submitdept" style="width: 130px; margin-left: 57px; margin-top: -12rem;" class="btnModalSubmit2 btn btn-success " value="Submit" onclick="_DepttAttendanceSubmit()" />
                                    </div>
                                </div>
                            </div>
                        }



                    </div>
                </div>
            </div>

            <div>

                <fieldset style="border: 2px solid #ccc; padding: 1rem;">
                    <legend><strong>Filter Criteria</strong></legend>
                    <div class="panel panel-default">

                        @*<div class="panel-heading">Panel Heading</div>*@
                        <div class="panel-body">
                            <div class="col-md-3" style=" margin-top: -48px; margin-left: 0px; display: none;">
                                <label for="Complaint">Agency</label><span class="error-message">*</span>
                                <select id="ddlAgencyfilter" style="width: 20rem" onchange="_GstReportList();">
                                    <option value="0">Select Agency</option>
                                </select>
                            </div>
                            <div class="col-md-3" style=" margin-top: -48px; margin-left: 281px; display:none;">
                                <label for="Complaint">Department</label><span class="error-message">*</span>
                                <select id="DeptIdfilter" style="width: 20rem" onchange="_GstReportList();">
                                    <option value="0">Select Department</option>
                                </select>
                            </div>
                            <div class="col-md-6" style=" margin-top: -48px; margin-left: 0px; ">

                                <label style="color:blue" for="Month">Month Year</label><span class="error-message">*</span>

                                <select id="ddlMonths1" style="color:blue" class="Month" onchange="_GstReportList()">
                                    <option>--Month--</option>
                                    @for (int i = 1; i <= 12; i++)
                                    {

                                        DateTime date = new DateTime(2020, i, 1);
                                        mon = date.ToString("MMM");
                                        <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                    }
                                </select>
                                <select id="ddlYears1" class="year" style="color:blue" onchange="_GstReportList()">
                                    <option>--Year--</option>
                                    @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                    {
                                        if (i == DateTime.Now.Year)
                                        {
                                            <option value="@i" selected='selected'>@i</option>
                                        }
                                        else
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                </select>

                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div align="left" id="_DocumentCategoryList">
                                        <div class="dt-responsive">
                                            <div style="overflow-x :auto" ;>
                                                <table class="table table-striped table-bordered" id="myTable">
                                                    <thead>
                                                        <tr>
                                                            <th class="widthsr">Sr.No.</th>
                                                            <th>Department Name</th>
                                                            <th>Agency Name</th>
                                                            <th>
                                                                Work Order No.<br />
                                                                <span style="font:bold">Agency Bill No.</span>
                                                            </th>
                                                            <th>Total No.Of Resources</th>
                                                            <th>No.Of Present Resources</th>
                                                            <th>Month Year</th>
                                                            <th>View Attendance</th>
                                                            <th>View Annexure</th>
                                                            @*<th>Delete Attandance</th>*@

                                                            @if (user == "48")
                                                            {
                                                                <th>View Bill</th>
                                                                <th>Upload Annexure &<br />Bill</th>
                                                                <th>Delete Attandance</th>
                                                                <th>Bill Verification Status</th>
                                                                <th>Remarks</th>
                                                                <th>Agency Invoice Entry</th>

                                                            }
                                                            else if (user == "39")
                                                            {
                                                                <th>View Bill</th>
                                                                <th>Upload Annexure &<br />Bill</th>
                                                            }
                                                            else if (user == "57")
                                                            {
                                                                @*@<th>View Bill</th>
                                                                    <th>Upload Annexure &<br />Bill</th>*@
                                                                <th>Delete Attandance</th>
                                                                @*@<th>Purchase Entry</th>*@

                                                            }



                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </fieldset>


            </div>

        </div>

    </div>

</div>
@*Purchase Model*@
<div class="modal fade" id="myModalPurchase" role="dialog">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#00476a;color:white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
                    <div class="table-responsive">
                        <!-- Pehla bordered div -->
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-bottom: 20px;">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="BillDate">Agency Bill Date</label><span class="error-message">*</span>
                                    <input placeholder="Bill Date" class="form-control text-box single-line datepicker cleardate" data-val="true" id="BillDatePurchase" type="datetime" value="@DateTime.Now.ToString("dd-MMM-yyyy")">
                                </div>
                                <div class="col-md-4">
                                    <label for="Work">Work Order No.</label>
                                    <input id="WorkOrderNoPurchase" placeholder="WorkOrderNo" class="form-control cleartxt required" readonly>
                                </div>
                                <div class="col-md-4">
                                    <label for="Billno">Agency Bill No.</label><span class="error-message">*</span>
                                    <input id="BillnoPurchase" class="form-control cleartxt required" placeholder="Bill No.">
                                </div>

                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="Complaint">Agency</label><span class="error-message">*</span>
                                    <input type="text" id="ddlAgencyPurchase" class="form-control cleartxt" readonly>
                                    <input type="text" id="ddlAgencyPurchase1" class="form-control cleartxt" style="display:none;">
                                    @*<select id="ddlAgencyPurchase" class="clearddl" style="width:270px">
                                         <option value="0">Select Agency</option>
                                        </select>*@
                                </div>
                                <div class="col-md-4">
                                    <label for="Complaint">Department</label><span class="error-message">*</span>
                                    <input type="text" id="DeptIdPurchase" class="form-control cleartxt" readonly>
                                    <input type="text" id="DeptIdPurchase1" class="form-control cleartxt" style="display:none;">
                                    @*<select id="DeptIdPurchase" class="clearddl" style="width:269px">
                                            <option value="0">Select Department</option>
                                        </select>*@
                                </div>

                                <div class="col-md-4">
                                    <label for="No">No. Of Resource</label><span class="error-message">*</span>
                                    <input type="text" class="form-control cleartxt required" id="NoOfResourcePurchase" placeholder="No. Of Resource" readonly>

                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-8" style=" display:flex;flex-direction:column">
                                    <div>
                                        <label>Department Full Name With Billing Address</label><span class="error-message">*</span>
                                    </div>
                                    <div>
                                        <textarea style="width: 560px; height: 50px" id="DepartmentAddressPurchase" class="cleartxt" placeholder="Department Full Name With Address" disabled></textarea>
                                        <input id="BillingId1" class="form-control cleartxt" placeholder="Agency Bill">
                                    </div>
                                </div>

                                <div class="col-md-4" style=" display:flex;flex-direction:column">
                                    <div>
                                        <label>BillForMonth</label><span class="error-message">*</span>
                                    </div>

                                    <div>
                                        <select id="ddlMonthspb" class="Month" disabled>
                                            <option>--Month--</option>
                                            @for (int i = 1; i <= 12; i++)
                                            {

                                                DateTime date = new DateTime(2020, i, 1);
                                                mon = date.ToString("MMM");
                                                <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                            }
                                        </select>
                                        <select id="ddlYearspb" class="year" disabled>
                                            <option>--Year--</option>
                                            @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                            {
                                                if (i == DateTime.Now.Year)
                                                {
                                                    <option value="@i" selected='selected'>@i</option>
                                                }
                                                else
                                                {
                                                    <option value="@i">@i</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label for="Complaint">Description</label><span class="error-message">*</span>
                                    <textarea rows="2" cols="51" id="DescriptionPurchase" class="cleartxt" style="width: 425px; height: 31px;" placeholder="Description"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="Complaint">Narration</label><span class="error-message">*</span>
                                    <textarea rows="2" cols="51" id="NarrationPurchase" class="cleartxt" style="width: 419px; height: 31px;" placeholder="Narration"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Doosra bordered div -->
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-top: 20px;">
                            <div class="form-group row">
                                @*<div>
                                        <input type="checkbox" class="clearchk" id="NoAdminCharge" style=" margin-left: 14px; " />
                                        <label for="NoAdminCharge">No Admin Charge</label>
                                    </div>*@

                                <div class="col-md-4">
                                    <label for="AgencyBill">Basic Bill Amount</label>
                                    <input id="AgencyBillPurchase" class="form-control cleartxt required" placeholder="Agency Bill" onchange="calculateAdminCharge2()">
                                </div>
                                <div class="col-md-4">
                                    <label for="Admin">Admin Charge@2.5%</label>
                                    <input id="AdminPurchase" class="form-control cleartxt" placeholder="Agency Bill">
                                </div>
                                <div class="col-md-4">
                                    <label for="Libary">Livery Charge</label>
                                    <input id="LibaryPurchase" class="form-control clearddl" value="0" placeholder="Livery Charge">
                                </div>
                            </div>
                            <div class="form-group row">
                                <div>
                                    <input type="checkbox" class="clearchk" id="showIGST" style=" margin-left: 14px; " />
                                    <label for="showIGST">Show IGST Input</label>
                                </div>

                                <div class="col-md-3" id="igstInputContainer" style="display:none;">
                                    <label for="Igst">Input IGST@18%</label>
                                    <input id="IGSTPurchase" class="form-control clearddl required" placeholder="IGST" readonly>
                                </div>

                                <div class="col-md-3">
                                    <label for="Cgst">Input CGST@9%</label>
                                    <input id="cgstPurchase" class="form-control clearddl required" placeholder="CGST" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label for="SGST">Input SGST@9%</label>
                                    <input id="SGSTPurchase" class="form-control clearddl required" placeholder="SGST" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label for="Total">Total Amount</label>
                                    <input id="TotalPurchase" class="form-control cleartxt required" placeholder="Total" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="modal-footer">

                <div class="row">

                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>

                    <div class="col-md-8">

                        <div class="modelalert"></div>

                    </div>

                    <div class="col-md-2">

                        <input type="button" class="btnModalSubmit1 btn btn-primary" value="Submit" />

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
