<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var accessRights;
    var vId = 0;
    var sr = 0;
    var sId = 0;
    var AttendanceV = 0;

    var IsActive = 'Y';
    var tableRow;
    //var user = @Session["RoleId"];


    $(document).ready(function () {
        TableManageDefault.init();
        $('#ddlAgency').select2();
        $('#DeptId1').select2();
        $('#ddlAgencyfilter').select2();
        $('#DeptIdfilter').select2();
        $('#Work').select2();
        $('#BillingId').select2();
        _GstReportList();

    });


    function resetForm() {
        $('#NoofResources').val('');
        $('#ddlAgency').val('0');
        $('#DeptId').val('0');
        $('#Upload').val('');
        $('#UpladNoOfResource').val('');
        $('#Uploadannexure').val('');
        $('#UploadAgencyBill').val('');

        $('#BillnoPurchase').val('');
        $('#DescriptionPurchase').val('');
        $('#NarrationPurchase').val('');
