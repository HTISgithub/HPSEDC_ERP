<script>
    var vId = 0;
    var sr = 0;

    $(document).ready(function () {
        TableManageDefault.init();
        _EInvoiceList();
    });

    function _EInvoiceList() {
        $('#ProgressImg').show();
        $.post('/Invoice/_EInvoiceList', {
            'AgencyBillId': vId,

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
             var RoleId = '@Session["RoleId"]';
            var msr = 0; var btn=''
            $.each(obj, function (key, value) {
                msr = msr + 1;
                var GenerateEInvoice = '<button onclick="GenerateEinvoice(' + value.ID +')" class="btn btn-primary">Generate Einvoice</button>';

                    var elmntArray = [
                        msr,
                        value.DepartmentName,
                        value.DepartmentAddress,
                        value.AgencyName,
                        value.SaleBillNo,
                        value.SaleBillAmount,
                        value.SaleBillDate,
                        GenerateEInvoice

                    ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }


    function GenerateEinvoice(Id) {
        $('#ProgressImg').show();
        $.post('/Invoice/Generate_IRN', {
            'id': Id,
        }, function (data) {
            alert(data);
            $('#ProgressImg').hide();
        });
    }

</script>
