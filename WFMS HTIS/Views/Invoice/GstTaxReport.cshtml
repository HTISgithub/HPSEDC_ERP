<style>
    .modal-footer {
        display: block;
    }

    .input-sm {
        margin-top: 30px;
    }

    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    #myTable_wrapper {
        margin-top: -89px;
    }


    .dt-buttons {
        display: none;
