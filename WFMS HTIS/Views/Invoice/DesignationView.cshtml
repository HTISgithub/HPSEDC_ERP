@using System.Data
@{
    // string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
    ViewBag.Title = "";
    ViewBag.PageTitle = "";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();
}

@******************Breadcrumb Start**************@

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>


<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>

        <li class="active">@ViewBag.PageTitle</li>
    </ul>
</div>
@******************Breadcrumb End**************@
<style>
    .modal-footer {
        display: block;
    }


    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    label {
        font-weight: 800;
    }

        label[for="IsActive"] {
            position: relative;
            padding-left: 35px;
            cursor: pointer;
            display: inline-block;
            font-size: 18px;
            color: #333;
        }

            /* Create a custom checkbox square for only this specific checkbox */
            label[for="IsActive"]:before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 22px;
                height: 22px;
                border: 2px solid #4CAF50;
                background-color: #fff;
                border-radius: 4px;
                transition: background-color 0.3s, border 0.3s;
            }

    /* Checkbox checked state */
    #IsActive:checked + label[for="IsActive"]:before {
        background-color: #4CAF50;
        border-color: #4CAF50;
    }

    /* Checkmark (visible when checked) */
    #IsActive:checked + label[for="IsActive"]:after {
        content: "✔";
        position: absolute;
        left: 4px;
        top: 0;
        color: white;
        font-size: 16px;
    }

    #IsActive {
        display: none;
    }
</style>
<div class="page-content">
    @*********Page Title************@
    <div class="page-header">
        <h1>
            @ViewBag.PageTitle

            <!-- Left side button -->
            <a class="btn btn-success pull-left" style="margin-left:1100px;" onclick="DesignationExcel()">
                <i class="fa fa-download"></i> Download
            </a>

            <!-- Right side button (visible only if user != 48) -->
            @if (user != "48")
            {
                <a class="btn btn-primary pull-right btnAddModal" onclick="OpenAddModel()">
                    <i class="fa fa-plus"></i> ADD Designation
                </a>
            }
        </h1>
    </div>


    @*********Page End************@

    @*********Page Content************@
    <div class="row">
        <div class="col-md-12">
            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>FiDesignation Id</th>
                                <th>Designation Name</th>
                                <th class="editcol actionstatus">Is Active</th>
                                <th class="editcol actionedit">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <!-- Modal -->
    <div class="modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #0f1875; color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <div id="_view">
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Tittle">Designation Name</label><span class="error-message">*</span>
                                <input type="text" id="DesignationId" class="form-control" style="width: 578px; height: 28px" placeholder="Designation Name">
                            </div>


                        </div>

                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">

                                <input type="checkbox" id="IsActive">
                                <label for="IsActive" style=" margin-top: 1rem;">Is Active</label>
                            </div>

                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                        <div class="col-md-8">
                            <div class="modelalert"></div>
                        </div>
                        <div class="col-md-2">
                            <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<script src="~/Scripts/jquery.js"></script>
<script src="~/Scripts/your-custom-js.js"></script>
<script>
    var vId = 0;
    var fvIsActive = 'Y';
    var accessRights;

    $(document).ready(function () {
        TableManageDefault.init();
        DesignationList();
    });

    $('.btnModalSubmit').click(function () {
        _DesignationSubmit();
    });

    function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("Add Designation");
        $('#myModal').modal({
            show: true
        });

        vId = 0;
        fvIsActive = 'Y';
    }

    function fillForm() {
        $('#ModalProgress').show();
        $('.modelalert').html('Please wait');
        $.post('/Invoice/_DesigantionNameEdit', {
            'Id': vId,
        }, function (data) {
            $('#ModalProgress').hide();
            $('.modelalert').html('');
            var obj = $.parseJSON(data);
            console.log(obj);
            $('#CompanyName').val(obj[0].CompanyName);
            $('#Description').val(obj[0].Description);


            if (obj[0].IsActive == 'Y') {
                $('#IsActive').prop('checked', true);
            } else {
                $('#IsActive').prop('checked', false);
            }
            IsActive = 'Y';
        });
    }

    function OpenUpdateModel(Id, atag, status) {
        resetModal();
        resetForm();
        $('.modal-title').html("Update Designation");
        $('#myModal').modal({
            show: 'false'
        });
        tableRow = $(atag).parents('tr');
        var tableRowColumnsData = $('#myTable').DataTable().row(tableRow).data();

        vId = Id;
        fillForm();
        sr = tableRowColumnsData[0];
        root = '/Invoice/DesignationList';
        $('.modal-footer').show();

    }


    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('#Tittle').val('');
        $('#Description').val('');
        $('#IsActive').prop('checked', false);
        $('.modelalert').html('');
    }

    function DesignationList() {
        $('#ProgressImg').show();
        $.post('/Invoice/DesignationList',
            {
                'fiDesignationID': 0
            },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var table = $('#myTable').DataTable();
                table.clear().draw();
                var msr = 0;
                $.each(obj, function (key, value) {

                    msr += 1;
                    var btnStatus = '<label><input name="switch-field-1" id="chk_' + value.fiDesignationID + '" class="ace ace-switch ace-switch-2 chk" onchange="changeActiveStatus(' + value.fiDesignationID + ')" type="checkbox" ' + (value.fvIsActive == "Y" ? "checked" : "") + ' /><span class="lbl"></span></label>';

                    //var btnStatus = '<label><input name="switch-field-1" id=' + value.fiDesignationID + ' class="ace ace-switch ace-switch-2 chk" onchange="changeActiveStatus(' + value.fiDesignationID + ')" type="checkbox" ' + (value.fvIsActive == "Y" ? "checked='checked'" : "") + ' /><span class="lbl"></span></label>';
                    var btnEdit = '<a href="#" onclick="OpenUpdateModel(' + value.Id + ', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';

                    var elmntArray = [
                        msr,
                        value.fiDesignationID,
                        value.fvDesignationName,
                        btnStatus,
                        btnEdit

                    ];
                    table.row.add(elmntArray).draw(false);
                });
            });
    }

    function switchStatus(url, fiDesignationID, status) {
        $.ajax({
            url: "/Invoice/DesignationListUpdate",
            type: 'POST',
            data: {
                fiDesignationID: fiDesignationID,
                fvIsActive: status
            },
            success: function (response) {
                console.log('Status updated successfully');
            },
            error: function (xhr, status, error) {
                console.error('Error updating status:', error);
                alert('Status update failed.');
            }
        });
    }

    function changeActiveStatus(fiDesignationID) {
        var checkbox = $('#chk_' + fiDesignationID);
        var status = checkbox.is(':checked') ? 'Y' : 'N';
        console.log(status);
        switchStatus('/Invoice/DesignationListUpdate', fiDesignationID, status);
    }




    function _DesignationSubmit() {

        if ($('#DesignationId').val() == '') {
            alert('Please Enter Designation');
            return;
        }

        var IsActive = $("#IsActive").is(":checked") ? "Y" : "N";

        if (IsActive == "N") {
            alert("Please check IsActive");
            return;
        }

        var formData = new FormData();
        formData.append("DesignationId", $("#DesignationId").val());
        formData.append("IsActive", IsActive);
        // formData.append("Id", 0);

        $.ajax({
            type: "POST",
            url: "/Invoice/DesignationSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                if (data.indexOf('Error') > -1) {
                    $('.modelalert').html(data);
                }

                else {
                    $('#myModal').modal('hide');
                    alert(data);
                    resetForm();
                    DesignationList();
                }
            }
        });
    }

    function DesignationExcel() {
        $('#ProgressImg').show();
        $.post('/Invoice/DesignationList',
            {
                'fiDesignationID': 0
            },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var msr = 0;
                var dataForExport = [];

                // Heading
                dataForExport.push(["DESIGNATION LIST"]);
                dataForExport.push([]);

                // Column headers
                dataForExport.push([
                    "Sr. No.",
                    "Designation ID",
                    "Designation Name"
                ]);

                // Rows
                $.each(obj, function (key, value) {
                    msr++;
                    dataForExport.push([
                        msr,
                        value.fiDesignationID,
                        value.fvDesignationName
                    ]);
                });

                // Generate Excel
                const ws = XLSX.utils.aoa_to_sheet(dataForExport);

                // Merge heading (3 columns = 0 to 2)
                ws["!merges"] = [
                    { s: { r: 0, c: 0 }, e: { r: 0, c: 2 } }
                ];

                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Designation List");
                XLSX.writeFile(wb, "Designation_List.xlsx");
            });
    }

</script>

