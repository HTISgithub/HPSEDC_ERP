<style>
    .modal-footer {
        display: block;
    }

    .input-sm {
        margin-top: 30px;
    }

    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    #myTable_wrapper {
        margin-top: -89px;
    }


    .dt-buttons {
        display: none;
    }
</style>

<div class="page-content">

    @*********Page Title************@
    <div class="page-header">

    </div>
    @*********Page End************@

    @*********Page Content************@
    <div class="container-fluid" style="margin-top:-2.5vw">
        &nbsp;
        <div class="row">
            <div class="col-md-12">
                <div>
                    <div class="row">
                        <!-- Month and Year Selection -->
                        <div class="col-md-2 col-sm-4 mb-2">
                            <label for="Month">Month Year</label><span class="error-message">*</span>
                            <div style="display:flex;flex-direction:row">
                                <select id="ddlMonths" class="form-control" onchange="_NewInvoiceList()" style="margin-right:0.5vw; width:8rem">
                                    <option>--Month--</option>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        DateTime date = new DateTime(2020, i, 1);
                                        mon = date.ToString("MMM");
                                        <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                    }
                                </select>
                                <select id="ddlYears" class="form-control" onchange="_NewInvoiceList()" style=" width: 8rem">
                                    <option>--Year--</option>
                                    @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                    {
                                        if (i == DateTime.Now.Year)
                                        {
                                            <option value="@i" selected='selected'>@i</option>
                                        }
                                        else
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Agency Selection -->
                        <div class="col-md-2 col-sm-4 mb-2">
                            <label for="Complaint">Agency</label><span class="error-message">*</span>
                            <select id="ddlAgency" class="form-control" style="width: 20rem" onchange="_NewInvoiceList()">
                                <option value="0">Select Agency</option>
                            </select>
                        </div>

                        <!-- Department Selection -->
                        <div class="col-md-2 col-sm-4 mb-2">
                            <label for="Complaint">Department</label><span class="error-message">*</span>
                            <select id="ddldepartment" class="form-control" style="width: 20rem" onchange="_NewInvoiceList()">
                                <option value="0">Select Department</option>
                            </select>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-2" style="display: flex; flex-direction: row;">
                            <!-- Payment Received -->
                            <div style="display: flex; flex-direction: row; width:12vw">
                                <div style="display: flex; flex-direction: row; margin-top:2vw">
                                    <label for="PReceived">Payment Received</label><span class="error-message">*</span>
                                </div>
                                <div style="margin-left: 0.5vw; margin-top:1.5vw">
                                    <input type="checkbox" class="form-control clearchk" id="PReceived" onchange="_NewInvoiceList()">
                                </div>
                            </div>

                            <!-- Payment Released -->
                            <div style="display: flex; flex-direction: row; width: 12vw">
                                <div style="display: flex; flex-direction: row; margin-top: 2vw">
                                    <label for="PReleased">Payment Released</label><span class="error-message">*</span>
                                </div>
                                <div style="margin-left: 0.5vw; margin-top: 1.5vw">
                                    <input type="checkbox" class="form-control clearchk" id="PReleased" onchange="_NewInvoiceList()">
                                </div>
                            </div>

                            <div style="display: flex; flex-direction: row; width: 9vw">
                                <div style="display: flex; flex-direction: row; margin-top: 2vw">
                                    <label for="Balance"> Balance</label><span class="error-message">*</span>
                                </div>
                                <div style="margin-left: 0.5vw; margin-top: 1.5vw">
                                    <input type="checkbox" class="form-control clearchk1" id="Balance" onchange="_NewInvoiceList()">
                                </div>
                            </div>
                            <!-- Buttons -->
                            <div style="margin-top:1.5vw">
                                <button id="printData" class="btn btn-primary mr-2" onclick="print()">Print</button>
                                <button id="exportBtn" class="btn btn-primary" onclick="Excel()">Excel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>



    <div align="left" id="Zones">
        <div class="dt-responsive">
            <table class="table table-striped table-bordered" id="myTable">
                <thead>
                    <tr>
                        <th></th>
                        <th class="widthsr">Sr.No.</th>
                        <th>Department Address</th>
                        <th>Agency Bill No./<br />Date</th>
                        <th>ESIC & EPF Verification<br />Status</th>
                        <th>Amount Detail</th>
                        <th>HPSEDC Bill no./ <br />Sale Bill Date</th>
                        <th>HPSEDC Bill Amount</th>
                        <th>Amount Received <br />From Deptt.</th>
                        <th>View Partial Payment</th>
                        <th>Payment Released <br />To Agency</th>
                        <th>Balance Amt. <br />Release To Agency</th>
                        <th>TDS Status</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>

</div>
    <div class="modal fade" id="myModal1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #0f1875; color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
               

                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-2">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" />
                        </div>
                        <div class="col-md-8">
                            <div class="modelalert"></div>
                        </div>
                        <div class="col-md-2">
                            <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

<script>
    var mAgencyId = 0, accessRights;
    var vId = 0;
    var sr = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();
        _NewInvoiceList();
        $('#ddlAgency').select2();
        $('#ddldepartment').select2();
    });


    function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("Add Department Email & Billing Address");
        $('#myModal').modal({
            show: true
        });
    }

    var checkedBills = [];
    $('#myTable').on('change', 'input[type="checkbox"]', function () {
        if ($(this).prop('checked')) {
            checkedBills.push($(this).val());
        } else {
            var index = checkedBills.indexOf($(this).val());
            if (index !== -1) {
                checkedBills.splice(index, 1);
            }
        }
    });

    function Excel() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();

        if ($('#PReceived').prop('checked')) {
            var Preceived = 'Y';
        }
        else {
            var Preceived = 'N';
        }
        if ($('#PReleased').prop('checked')) {
            var Preleased = 'Y';
        }
        else {
            var Preleased = 'N';
        }
        if ($('#Balance').prop('checked')) {
            var Balance = 'Y';
        }
        else {
            var Balance = 'N';
        }

        $('#ProgressImg').show();
        $.post('/Invoice/_invoiceReportList', {
            DeptId: $('#ddldepartment').val(),
            MonthId: month,
            AgencyId: $('#ddlAgency').val(),
            PReceived: Preceived,
            SaleBillNo: '',
            PReleased: Preleased,
            Balance: Balance,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var msr = 0;
            var Totalbalance = 0;
            var TBGSTTds = 0;
            var TBTds = 0;
            var NetTotalBalanceAmt = 0;
            var GstTdsType = 0;

            var agencyname = ($('#ddlAgency').val() == 0) ? "All Agency" : $('#ddlAgency option:selected').text();

            var dataForExport = [];
            var dataForExport1 = [];
            $.each(obj, function (key, value) {
                msr = msr + 1;

                var BillDetail = value.Billno;
                var BillDate = value.PBilldate;
                var purchaseAmount = parseFloat(value.PAmount).toFixed(2);
                var PCGST = parseFloat(value.PcgstAmt).toFixed(2);
                var Psgst = parseFloat(value.PSGSTAtm).toFixed(2);
                var Pigst = parseFloat(value.IGSTAmt).toFixed(2);
                var TotalAmount1 = parseFloat(value.TotalAmt).toFixed(2);
                var SaleAmount = parseFloat(value.SAmount).toFixed(2);
                var SCGST = parseFloat(value.cgstAmt).toFixed(2);
                var Sscgst = parseFloat(value.SGSTAtm).toFixed(2);
                var TotalsaleAmount = parseFloat(value.TotalAmt1).toFixed(2);
                var ReceivedAmount = parseFloat(value.ReceivedAmt).toFixed(2);
                var RTDS = parseFloat(value.Tds2).toFixed(2);
                var RGSTDS = parseFloat(value.GSTTds2).toFixed(2);
                var TotalRecive = parseFloat(value.TReceivedAmount).toFixed(2);
                var ReleasedAmount = parseFloat(value.ReleasedAmount).toFixed(2);
                var ReTDS = parseFloat(value.Tds).toFixed(2);
                var ReGSTDS = parseFloat(value.GSTTds).toFixed(2);
                var ReTotal = parseFloat(value.TReleasedAmount).toFixed(2);
                var BalanceAmount = parseFloat(value.BalanceAmt).toFixed(2);
                var BTDS = parseFloat(value.BTds).toFixed(2);
                var BGSTTDS = parseFloat(value.BGSTTds).toFixed(2);
                var BTotal = + parseFloat(parseFloat(value.TBalanceAmt).toFixed(0)).toFixed(2);

                Totalbalance += parseFloat(parseFloat(value.BalanceAmt).toFixed(2));
                TBGSTTds += parseFloat(parseFloat(value.BGSTTds).toFixed(2));
                TBTds += parseFloat(parseFloat(value.BTds).toFixed(2));
                NetTotalBalanceAmt += parseFloat(parseFloat(value.TBalanceAmt).toFixed(0));
                GstTdsType = value.GSTTdsType;

                var TdsStatusCol = '';
                if (value.TdsStatus === 'D') {
                    TdsStatusCol = 'TDS Deposited - ₹' + parseFloat(value.ItTds).toFixed(2);
                } else if (value.TdsStatus === 'V') {
                    TdsStatusCol = 'TDS Deducted but Yet to be Deposit - ₹' + parseFloat(value.ItTds).toFixed(2);
                } else if (value.TdsStatus === 'N') {
                    TdsStatusCol = 'TDS Not Deducted - ₹' + parseFloat(value.ItTds).toFixed(2);
                } else {
                    TdsStatusCol = 'Status Unknown - ₹' + parseFloat(value.ItTds).toFixed(2);
                }


                dataForExport.push({
                    "Sr. No.": msr,
                    "Agency Name": value.AgencyName,
                    "Department Address": value.DepartmentAddress,
                    "Agency Bill No": BillDetail,
                    "Date": BillDate,
                    "Base Amount (Amt1)": purchaseAmount,
                    "Purchase CGST": PCGST,
                    "Purchase SGST": Psgst,
                    "Purchase IGST": Pigst,
                    "Total Purchse Amount (TA1)": TotalAmount1,
                    "HPSEDC Bill no": value.SaleBillNo,
                    "Sale Bill Date": value.SaleBillDate,
                    "HPSEDC Base Amount (Amt2)": SaleAmount,
                    "Sale CGST": SCGST,
                    "Sale SGST": Sscgst,
                    "Total Sale Amount": TotalsaleAmount,
                    "Amount Received (Amt3)": ReceivedAmount,
                    "Dpt.TDS": RTDS,
                    "Dpt. GSTTDS": RGSTDS,
                    "Total Recived (TA3)": TotalRecive,
                    "Payment Released (Amt4)": ReleasedAmount,
                    "Agency TDS": ReTDS,
                    "Agency GSTTDS": ReGSTDS,
                    "Agency Total (TA4)": ReTotal,
                    "Balance Amt. (Amt5)": BalanceAmount,
                    "Balance TDS": BTDS,
                    "Balance GSTTDS": BGSTTDS,
                    "Balance TotalAmount (TA5)": BTotal,
                    "TDS Status": TdsStatusCol
                });
            });

            let rowsData = [
                { description: 'Total Amount', amount: parseFloat(Totalbalance).toFixed(2) },
                { description: 'GST TDS (2%)', amount: parseFloat(TBGSTTds).toFixed(2) },
                { description: 'TDS (' + GstTdsType + '%)', amount: parseFloat(TBTds).toFixed(2) },
                { description: 'Total Amount to be Paid', amount: parseFloat(NetTotalBalanceAmt).toFixed(2) }
            ];

            rowsData.forEach((row, index) => {
                dataForExport1.push({
                    "Sr. No.": index + 1,
                    "Item": row.description,
                    "Amount": row.amount
                });
            });

            let exportData = [
                {
                    rows: [
                        { label: 'Amt1', description: 'Agency Base Amount(including 2.5% Administrative charges)' },
                        { label: 'TA1', description: 'Amt1 + CG + SG' },
                        { label: '', description: '' },

                        { label: 'Amt2', description: 'HPSEDC Base Amount(including 5% Administrative charges)' },
                        { label: 'TA2', description: 'Amt2 + CG + SG' },
                        { label: '', description: '' },

                        { label: 'Amt3', description: 'Payment Received from Department' },
                        { label: 'GTD', description: '2% Amt2' },
                        { label: 'TDS', description: '2% Amt2' },
                        { label: 'TA3', description: 'Amt3 + GTD + TDS' },
                        { label: '', description: '' },

                        { label: 'Amt4', description: 'Payment Released to Agency' },
                        { label: 'GTD', description: '2% Amt1' },
                        { label: 'TDS', description: '2/1% Amt1' },
                        { label: 'TA4', description: 'Amt4 + GTD + TDS' },
                        { label: '', description: '' },

                        { label: 'Amt5', description: 'TA1 - TA4' },
                        { label: 'GTD', description: '2% Amt1' },
                        { label: 'TDS', description: '2/1% Amt1' },
                        { label: 'TA5', description: 'Amt5 - GTD - TDS' },
                        { label: '', description: '' }
                    ]
                }
            ];

            let dataForExport2 = [];
            exportData.forEach((tableData) => {
                tableData.rows.forEach((row) => {
                    dataForExport2.push([row.label, row.description]);
                });
            });


            const ws = XLSX.utils.json_to_sheet(dataForExport);
            const ws1 = XLSX.utils.json_to_sheet(dataForExport1);
            const ws2 = XLSX.utils.aoa_to_sheet(dataForExport2, { header: [] });
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Sheet1");
            XLSX.utils.book_append_sheet(wb, ws1, "Sheet2");
            XLSX.utils.book_append_sheet(wb, ws2, "Sheet3");
            XLSX.writeFile(wb, "Invoice_Report.xlsx");
        });
    }


    function print() {
        var checkedBillsString = checkedBills.join(',') || '';
        var month = $('#ddlMonths').val() + $('#ddlYears').val();

        if ($('#PReceived').prop('checked')) {
            var Preceived = 'Y';
        }
        else {
            var Preceived = 'N';
        }
        if ($('#PReleased').prop('checked')) {
            var Preleased = 'Y';
        }
        else {
            var Preleased = 'N';
        }

        if ($('#Balance').prop('checked')) {
            var Balance = 'Y';
        }
        else {
            var Balance = 'N';
        }

        $('#ProgressImg').show();
        $.post('/Invoice/_invoiceReportList', {
            DeptId: $('#ddldepartment').val(),
            MonthId: month,
            AgencyId: $('#ddlAgency').val(),
            PReceived: Preceived,
            PReleased: Preleased,
            Balance: Balance,

            SaleBillNo: checkedBillsString
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var msr = 0;

            if ($('#ddlAgency').val() == 0) {
                var agencyname = "All Agency";
            }
            else {
                var agencyname = $('#ddlAgency option:selected').text();
            }
            var printContent = `
                <div style="display: flex; justify-content: space-between;"><div style="text-align: left;">
                 <h2>${agencyname}</h2>
                          </div>
                            <div style="text-align: right;">
                             <h2>Month: ${$('#ddlMonths option:selected').text()} ${$('#ddlYears option:selected').text()}</h2></div></div>`;


            printContent += "<style>";
            printContent += "#myTable1, #myTable1 th, #myTable1 td {";
            printContent += "border: 1px solid black;";
            printContent += "border-collapse: collapse;";
            printContent += "}";
            printContent += "#myTable1 th, #myTable1 td {";
            printContent += "padding: 3px;";
            printContent += "text-align: center;";
            printContent += "}";
            printContent += "#myTable1 td {";
            printContent += "font-size: 10px";
            printContent += "}";
            printContent += "#myTable1 th {";
            printContent += "font-size: 12px";
            printContent += "}";
            printContent += "</style>";

            printContent += "<table id='myTable1'><tr><th>Sr.<br />No.</th><th>Department Address</th><th>Agency<br />Bill No./<br />Date</th><th style='width: 100px !important'>Amount Detail</th><th>HPSEDC Bill no./<br>Sale Bill Date </th><th style='width: 100px !important'>HPSEDC<br />Bill<br />Amount</th><th style='width: 100px !important'>Amount Received</th><th style='width: 100px !important'>Payment Released</th><th style='width: 100px !important'>Balance Amt.</th><th style='width: 100px !important'>TDS Status</th></tr>";

            $.each(obj, function (key, value) {
                msr = msr + 1;

                var BillDetail = '<div>' + value.Billno + '<br> ' + value.PBilldate + '</div>';
                var purchaseAmount = '<div>' + 'Amt1- ' + parseFloat(value.PAmount).toFixed(2) + '<br>' +
                    'CG - ' + parseFloat(value.PcgstAmt).toFixed(2) + '<br>' + 'SG - ' + parseFloat(value.PSGSTAtm).toFixed(2) +
                    '<br>' + 'IGST - ' + parseFloat(value.IGSTAmt).toFixed(2) + '<br>' + 'TA1 - ' + parseFloat(value.TotalAmt).toFixed(2) + '</div>';
                var SaleAmount = '<div>' + 'Amt2- ' + parseFloat(value.SAmount).toFixed(2) + '<br>' +
                    'CG - ' + parseFloat(value.cgstAmt).toFixed(2) + '<br>' + 'SG - ' + parseFloat(value.SGSTAtm).toFixed(2) +
                    '<br>' + 'TA2 - ' + parseFloat(value.TotalAmt1).toFixed(2) + '</div>';
                var ReceivedAmount = '<div>' + 'Amt3- ' + parseFloat(value.ReceivedAmt).toFixed(2) + '<br>' +
                    'TDS- ' + parseFloat(value.Tds2).toFixed(2) + '<br>' + 'GTD- ' + parseFloat(value.GSTTds2).toFixed(2) +
                    '<br>' + 'TA3 - ' + parseFloat(value.TReceivedAmount).toFixed(2) + '</div>';
                var ReleasedAmount = '<div>' + 'Amt4- ' + parseFloat(value.ReleasedAmount).toFixed(2) + '<br>' +
                    'TDS- ' + parseFloat(value.Tds).toFixed(2) + '<br>' + 'GTD- ' + parseFloat(value.GSTTds).toFixed(2) +
                    '<br>' + 'TA4 - ' + parseFloat(value.TReleasedAmount).toFixed(2) + '</div>';
                var BalanceAmount = '<div>' + 'Amt5- ' + parseFloat(value.BalanceAmt).toFixed(2) + '<br>' +
                    'TDS- ' + parseFloat(value.BTds).toFixed(2) + '<br>' + 'GTD- ' + parseFloat(value.BGSTTds).toFixed(2) +
                    '<br>' + 'TA5 - ' + parseFloat(parseFloat(value.TBalanceAmt).toFixed(0)).toFixed(2) + '</div>';

                var TdsStatusCol = '';
                if (value.TdsStatus === 'D') {
                    TdsStatusCol = `<div style="color: green;"><b>TDS Deposited</b><br>TDS Amount: ${parseFloat(value.ItTds).toFixed(2)}</div>`;
                } else if (value.TdsStatus === 'V') {
                    TdsStatusCol = `<div style="color: orange;"><b>TDS Deducted but Yet to be Deposit</b><br>TDS Amount: ${parseFloat(value.ItTds).toFixed(2)}</div>`;
                } else if (value.TdsStatus === 'N') {
                    TdsStatusCol = `<div style="color: red;"><b>TDS Not Deducted</b><br>TDS Amount: ${parseFloat(value.ItTds).toFixed(2)}</div>`;
                } else {
                    TdsStatusCol = `<div style="color: gray;">Status Unknown<br>TDS Amount: ${parseFloat(value.ItTds).toFixed(2)}</div>`;
                }


                printContent += "<tr>";
                printContent += "<td>" + msr + "</td>";
                printContent += "<td>" + value.DepartmentAddress + "</td>";
                printContent += "<td>" + BillDetail + "</td>";
                printContent += "<td>" + purchaseAmount + "</td>";
                printContent += "<td>" + value.SaleBillNo + "<br/>" + value.SaleBillDate + "</td>";
                printContent += "<td>" + SaleAmount + "</td>";
                printContent += "<td>" + ReceivedAmount + "</td>";
                printContent += "<td>" + ReleasedAmount + "</td>";
                printContent += "<td>" + BalanceAmount + "</td>";
                printContent += "<td>" + TdsStatusCol + "</td>";
                printContent += "</tr>";
            });

            printContent += "</table>";

            if ($('#PReceived').prop('checked') && $('#ddlAgency').val() != '0') {

                printContent += "<style>";
                printContent += "#myTable2 {";
                printContent += "margin-top: 30px";
                printContent += "}";
                printContent += "#myTable2, #myTable2 th, #myTable2 td {";
                printContent += "border: 1px solid black;";
                printContent += "border-collapse: collapse;";
                printContent += "}";
                printContent += "#myTable2 th, #myTable2 td {";
                printContent += "padding: 3px;";
                printContent += "text-align: center;";
                printContent += "}";
                printContent += "#myTable2 td {";
                printContent += "font-size: 10px";
                printContent += "}";
                printContent += "#myTable2 th {";
                printContent += "font-size: 12px";
                printContent += "}";
                printContent += "</style>";

                printContent += "<table id='myTable2'><tr><th>Sr.No.</th><th>Item</th><th>Amount</th></tr>";

                var Totalbalance = 0;
                var TBGSTTds = 0;
                var TBTds = 0;
                var NetTotalBalanceAmt = 0;
                var GstTdsType = 0;

                $.each(obj, function (key, value) {
                    Totalbalance += parseFloat(parseFloat(value.BalanceAmt).toFixed(2));
                    TBGSTTds += parseFloat(parseFloat(value.BGSTTds).toFixed(2));
                    TBTds += parseFloat(parseFloat(value.ItTds).toFixed(2));
                    NetTotalBalanceAmt += parseFloat(parseFloat(value.TBalanceAmt).toFixed(0));
                    GstTdsType = value.GSTTdsType;
                });

                printContent += "<tr>";
                printContent += "<td>" + '1' + "</td>";
                printContent += "<td>" + 'Total Amount' + "</td>";
