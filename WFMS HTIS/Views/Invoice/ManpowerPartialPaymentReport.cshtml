    function _NewInvoiceList() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val()
        if ($('#PReceived').prop('checked')) {
            var Preceived = 'Y';
        }
        else {
            var Preceived = 'N';
        }
        if ($('#PReleased').prop('checked')) {
            var Preleased = 'Y';
        }
        else {
            var Preleased = 'N';
        }
        if ($('#Balance').prop('checked')) {
            var Balance = 'Y';
        }
        else {
            var Balance = 'N';
        }

        $('#ProgressImg').show();
        $.post('/Invoice/_invoiceReportList', {
            DeptId: $('#ddldepartment').val(),
            MonthId: month,
            AgencyId: $('#ddlAgency').val(),
            PReceived: Preceived,
            PReleased: Preleased,
            Balance: Balance,
            SaleBillNo: ''

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();

            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;
                var DeptAdvancePayment = '<a  onclick="OpenAddModel(' + value.AgencyBillId + ')"  class="img-circle">' + '<center><i class="btn btn-warning" style="color:white !important;">Department Payment</i></center></a>';

                //var NoESIEpfCheck = '';
                var EsiStatus = '';
                var EPFStatus = '';

                // For ESI
                if (value.EsiStatus == '3') {
                    EsiStatus = '<a href="#" class="img-circle" style="color: green;"><i class="fa fa-check fa-3x" aria-hidden="true"></i></a>';
                } else if (value.EsiStatus == '2') {
                    EsiStatus = '<a href="#" class="img-circle" style="color: orange;"><i class="fa fa-check fa-3x" aria-hidden="true"></i></a>';
                } else {
                    EsiStatus = '<a href="#" class="img-circle" style="color: gray;"><i class="fa fa-check fa-3x" aria-hidden="true"></i></a>';
                }

                // For EPF
                if (value.EPFStatus == '3') {
                    EPFStatus = '<a href="#" class="img-circle" style="color: green;"><i class="fa fa-check fa-3x" aria-hidden="true"></i></a>';
                } else if (value.EPFStatus == '2') {
                    EPFStatus = '<a href="#" class="img-circle" style="color: orange;"><i class="fa fa-check fa-3x" aria-hidden="true"></i></a>';
                } else {
                    EPFStatus = '<a href="#" class="img-circle" style="color: gray;"><i class="fa fa-check fa-3x" aria-hidden="true"></i></a>';
                }
                var TdsStatusIcon = '';
                if (value.TdsStatus === 'D') {
                    TdsStatusIcon = `<div style="text-align:center;"><a href="#" class="img-circle" style="color: green;"> <i class="fa fa-check fa-3x" aria-hidden="true"></i></a><br>
                                     <span style="color: green;">TDS Amount = ${parseFloat(value.ItTds).toFixed(2)}</span></div>`;
                } else if (value.TdsStatus === 'V') {
                    TdsStatusIcon = `<div style="text-align:center;"><a href="#" class="img-circle" style="color: orange;"> <i class="fa fa-check fa-3x" aria-hidden="true"></i></a><br>
                                     <span style="color: orange;">TDS Amount= ${parseFloat(value.ItTds).toFixed(2)}</span> </div>`;
                } else if (value.TdsStatus === 'N') {
                    TdsStatusIcon = `<div style="text-align:center;"> <a href="#" class="img-circle" style="color: red;"><i class="fa fa-times fa-3x" aria-hidden="true"></i> </a><br>
                                     <span style="color: red;">TDS Amount= ${parseFloat(value.ItTds).toFixed(2)}</span> </div>`;
                } else {
                    TdsStatusIcon = `<div style="text-align:center;"><a href="#" class="img-circle" style="color: gray;"> <i class="fa fa-question fa-3x" aria-hidden="true"></i> </a><br>
                                    <span style="color: gray;">TDS Amount= ${parseFloat(value.ItTds).toFixed(2)}</span></div>`;
                }

                var BillDetail = '<div>' + value.Billno + '<br> ' + value.PBilldate + '</div>';
                var purchaseAmount = '<div>' + 'Amt1- ' + parseFloat(value.PAmount).toFixed(2) + '<br>' +
                    'CG - ' + parseFloat(value.PcgstAmt).toFixed(2) + '<br>' + 'SG - ' + parseFloat(value.PSGSTAtm).toFixed(2) +
                    '<br>' + 'IGST - ' + parseFloat(value.IGSTAmt).toFixed(2) + '<br>' + 'TA1 - ' + parseFloat(value.TotalAmt).toFixed(2) + '</div>';
                var SaleAmount = '<div>' + 'Amt2- ' + parseFloat(value.SAmount).toFixed(2) + '<br>' +
                    'CG - ' + parseFloat(value.cgstAmt).toFixed(2) + '<br>' + 'SG - ' + parseFloat(value.SGSTAtm).toFixed(2) +
                    '<br>' + 'TA2 - ' + parseFloat(value.TotalAmt1).toFixed(2) + '</div>';
                var ReceivedAmount = '<div>' + 'Amt3- ' + parseFloat(value.ReceivedAmt).toFixed(2) + '<br>' +
                    'TDS- ' + parseFloat(value.Tds2).toFixed(2) + '<br>' + 'GTD- ' + parseFloat(value.GSTTds2).toFixed(2) +
                    '<br>' + 'TA3 - ' + parseFloat(value.TReceivedAmount).toFixed(2) + '</div>';
                var ReleasedAmount = '<div>' + 'Amt4- ' + parseFloat(value.ReleasedAmount).toFixed(2) + '<br>' +
                    'TDS- ' + parseFloat(value.Tds).toFixed(2) + '<br>' + 'GTD- ' + parseFloat(value.GSTTds).toFixed(2) +
                    '<br>' + 'TA4 - ' + parseFloat(value.TReleasedAmount).toFixed(2) + '</div>';
                var BalanceAmount = '<div>' + 'Amt5- ' + parseFloat(value.BalanceAmt).toFixed(2) + '<br>' +
                    'TDS- ' + parseFloat(value.BTds).toFixed(2) + '<br>' + 'GTD- ' + parseFloat(value.BGSTTds).toFixed(2) +
                    '<br>' + 'TA5 - ' + parseFloat(parseFloat(value.TBalanceAmt).toFixed(0)).toFixed(2) + '</div>';
                var checkbox = '<input type="checkbox" class="form-control clearchk12" id="bill' + msr + '" value="' + value.SaleBillNo + '"/>';

                var elmntArray = [
                    checkbox,
                    msr,
                    value.DepartmentAddress,
                    BillDetail,
                    'Esic-' + EsiStatus + '<br>' + 'Epf-' + EPFStatus,
                    purchaseAmount,
                    value.SaleBillNo + "<br/>" + value.SaleBillDate,
                    SaleAmount,
                    ReceivedAmount,
                    DeptAdvancePayment,
                    ReleasedAmount,
                    BalanceAmount,
                    TdsStatusIcon
                ];
                table.row.add(elmntArray).draw(false);
            });
            $('.clearchk12').prop('checked', false);
            checkedBills = [];
        });
    }
