
@using System.Data
@{
    ViewBag.Title = "Invoice Report";
    ViewBag.PageTitle = "Invoice Report";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();

}

