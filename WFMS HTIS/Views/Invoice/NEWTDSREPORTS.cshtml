<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var mAgencyId = 0, accessRights;
    var vId = 0;
    var sr = 0;
    var IsActive = 'Y';
    var tableRow;
    $(document).ready(function () {
        TableManageDefault.init();
        $('#ddlAgency').select2();
        _NEWTDSREPORTSList();
    });

    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').val(mAgencyId);
        });
    }
    function _NEWTDSREPORTSList() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        $.post('/Invoice/_NEWTDSREPORTSList', {
            AgencyId: '0',
            MonthId: month,
            AgencyBillId: 0,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;
                if (value.IsTdsDeposited == 'N') {
                    VerifiedIcon = '<i class="fa fa-close" style="font-size:48px;color:red"></i>';
                } else{
                    VerifiedIcon = '<i class="fa fa-check" style="font-size:48px;color:green"></i>';
                }
                if (value.IsPurchaseBillVerified == 'V') {
                    PVerified = '<i class="fa fa-check" style="font-size:48px;color:green"></i>';
                } else if (value.IsPurchaseBillVerified == 'R') {
                    PVerified = ''; // Blank
                } else {
                    PVerified = '<i class="fa fa-close" style="font-size:48px;color:red"></i>';
                }

                var elmntArray = [

                    msr,
                    value.Billno,
                    value.AgencyName,
                    value.Ptotal,
                    PVerified,
                   /* value.GSTTDS,*/
                    value.ITTDS1,
                    VerifiedIcon
                ];
                table.row.add(elmntArray).draw(false);
            });
        });

    }
    var TdsId;
    function OpenAddModel6(AgencyBillId) {
        $('.modal-title').html("Enter TDS");
        $('#myModal4').modal({
            show: 'false'
        });

        TdsId = AgencyBillId;
        _NEWTDSREPORTSListGet(AgencyBillId);
        root = '/Invoice/_NEWTDSREPORTSListGet';
    }
    function _NEWTDSREPORTSListGet(AgencyBillId) {
        alert(AgencyBillId);
        $.post('/Invoice/_NEWTDSREPORTSListGet', {
            'AgencyBillId': AgencyBillId,
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                $('#Purchase').val(value.Billno);
                $('#PurchaseBillDate2').val(value.BillDate);
                $('#BillForMonth').val(value.BillforMonth);
                $('#BillAmount').val(value.BaseAmount);
                $('#Percentage').val(value.TdsP);

            });
        });
    }

    $('.btnModalSubmit').click(function () {
        _TDSSubmit();
    });
    function _TDSSubmit() {

        if (!$('#TDS').is(':checked')) {
            alert('Please check the "Mark TDS Deposited" checkbox before submitting.');
            return;
        }


        $('.modelalert').html('');
        $('#ModalProgress').show();
        $.post('/Invoice/_TDSSubmit', {
            'AgencyBillId': TdsId,
            'IsDeposited': 'Y',

        }, function (data) {
            alert(data);
            TdsId = 0;
            $('#myModal4').modal('hide');
            $('.btnModalSubmit').removeAttr("disabled");
            $('#ModalProgress').hide();
            _NEWTDSREPORTSList();
        });
    }

    function OpenAddModel() {
        // resetModal();
        // resetForm();
        $('.modal-title').html("Deposited TDS Challan");
        $('#myModal').modal({
            show: true
        });

        vId = 0;
        IsActive = 'Y';
        _TDSDataGet(vId);
    }
    $('.btnModalSubmit1').click(function () {
        _DepositedTdsSubmit();
    });

    function _DepositedTdsSubmit() {

        var monthyear = $('#ddlMonths1').val() + $('#ddlYears1').val();
        if ($('#TotalPurchaseInv').val() == '') {
            alert('Enter Total Purchase No.');
            return;
        }
        if ($('#TotaltdsAmount').val() == '') {
            alert('Please Enter Total Tds Amount');
            return;
        }
        if ($('#ddlMonths1').val() == "--Month--" || $('#ddlYears1').val() == "--Year--") {
            $('.modelalert').html('Please select Month and Year.');
            return;
        }


        if ($('#ChallanNo').val() == '') {
            alert('Please Enter Challan No.');
            return;
        }

        if ($('#BSRCode').val() == '') {
            alert('Please Enter BSR Code');
            return;
        }
        if ($('#ChallanAmount').val() == '') {
            alert('Please Enter Challan Amount');
            return;
        }
        if ($('#Remarks').val() == '') {
            alert('Please Enter Remarks');
            return;
        }

        $.post('/Invoice/_DepositedTdsSubmit', {
            'ChallanId': vId,
            'TotalPurchaseInv': $('#TotalPurchaseInv').val(),
            'TotaltdsAmount': $('#TotaltdsAmount').val(),
            'monthyear': monthyear,
            'ChallanNo': $('#ChallanNo').val(),
            'DepositedDate': $('#DepositedDate').val(),
            'BSRCode': $('#BSRCode').val(),
            'ChallanAmount': $('#ChallanAmount').val(),
            'Remarks': $('#Remarks').val(),

        }, function (data) {
            alert(data);
            $('#myModal').modal('hide');
            $('.btnModalSubmit1').removeAttr("disabled");
            $('#ModalProgress').hide();
        });
    }

    function _TDSDataGet(vId) {
        var MonthYearComine = $('#ddlMonths1').val() + $('#ddlYears1').val();
        $.post('/Invoice/_NewTDSGETList', {
            'ChallanId': 0,
            'MonthYear': MonthYearComine,
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                $('#TotalPurchaseInv').val(value.TotalAgencyBIll);
                $('#TotaltdsAmount').val(value.TdsAmount);
            });
        });

        $('.modal-title').html("Deposited TDS Challan");
        $('#myModal').modal({
            show: 'false'
        });
    }
    function Excel() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        $.post('/Invoice/_NEWTDSREPORTSList', {
            AgencyId: '0',
            MonthId: month,
            AgencyBillId: 0,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var msr = 0;

            // Totals initialized
            var totalAgencyBillAmt = 0;
            var totalAdminAmt = 0;
            var totalBaseAmount = 0;
            var totalITTDS = 0;

            var dataForExport = [];
            dataForExport.push(["COMPUTATION OF TAXABLE AMOUNT (NON SALARIED) FOR THE " + $("#ddlMonths").find(':selected').text() + " " + $("#ddlYears").find(':selected').text() + " & ITTDS DEPOSIT THERE OF IN R/o HPSEDC LTD., MEHLI"]);
            dataForExport.push([]);

            dataForExport.push([
                "Sr. No.",
                "Agency Invoice No.",
                "Agency Name",
                "Amount Without(2.5%)",
                "Adminstrative Charge(2.5%)",
                "Base Amount",
                "ITTDS Percentage",
                "ITTDS Deducted",
            ]);

            $.each(obj, function (key, value) {
                msr++;
                totalAgencyBillAmt += Math.round(value.AgencyBillAmt);
                totalAdminAmt += Math.round(value.AdminAmt);
                totalBaseAmount += Math.round(value.BaseAmount);
                totalITTDS += Math.round(value.ITTDS);

                dataForExport.push([
                    msr,
                    value.Billno,
                    value.AgencyName,
                    Math.round(value.AgencyBillAmt),
                    Math.round(value.AdminAmt),
                    Math.round(value.BaseAmount),
                    value.TdsP,
                    Math.round(value.ITTDS),
                ]);
            });
            dataForExport.push([
                "",
                "",
                "TOTAL",
                totalAgencyBillAmt,
                totalAdminAmt,
                totalBaseAmount,
                "",
                totalITTDS,
            ]);

            const ws = XLSX.utils.aoa_to_sheet(dataForExport);

            ws["!merges"] = [
                { s: { r: 0, c: 0 }, e: { r: 0, c: 6 } }
            ];

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "TDS Report");
            XLSX.writeFile(wb, "ITTDS_Report.xlsx");
        });
    }

</script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>