                                    <input type="text" data-date-format="d-M-yyyy" value="@DateTime.Now.ToString("d-MMM-yyyy")" class="datepicker datepickertxt form-control readonly" name="PaymentDate" id="PaymentDate" />

                                    @*<input type="date" data-date-format="yyyy-MM-dd" value="@DateTime.Now.ToString("yyyy-MM-dd")" name="PaymentDate" id="PaymentDate" class="form-control" />*@
                                </div>
                            </div>

