                                    <select id="ModePayment1" class="form-control clearddl" onchange="">
                                    </select>

                                </div>
                                <div class="col-md-3">
                                    <label for="Transaction">Transaction ID</label><span class="error-message">*</span>
                                    <input id="Transaction" class="form-control cleartxt required" placeholder="Transaction ID">

                                </div>
                                <div class="col-md-3">
                                    <label for="PaymentAmount">Payment Received (INR)</label><span class="error-message">*</span>
                                    <input id="PaymentAmount" class="form-control cleartxt required" placeholder="Payment Amount">
                                </div>

                            </div>

                            <div class="form-group row">

                                <div class="col-md-3">
                                    <label for="GSTTDS">GST TDS (at 2%)</label>
                                    <input id="GSTTDS" class="form-control cleartxt required" placeholder="GST TDS">
                                </div>
                                <div class="col-md-3">
                                    <label for="TDS">TDS (at 2%)</label>
                                    <input id="TDS" class="form-control cleartxt required" placeholder="TDS">
                                </div>

                                <div class="col-md-3">
