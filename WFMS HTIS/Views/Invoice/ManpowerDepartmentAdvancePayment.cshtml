                                    <select id="Agency" style="width: 21rem" onchange="_NewBiillingAdressAdvance();">
                                        <option value="0">Select</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-top: 20px;">
                            <div class="form-group row">
                                <div class="col-md-3 form-group">
                                    <label>Bank Name</label><span class="error-message">*</span>
                                    <select id="bankName" class="form-control clearddl"></select>
                                </div>
                                <div class="col-md-3">
