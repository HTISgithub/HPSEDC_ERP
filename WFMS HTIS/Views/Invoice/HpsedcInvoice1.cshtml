    function toWords(num) {
        var ones = [
            "",
            "One",
            "Two",
            "Three",
            "Four",
            "Five",
            "Six",
            "Seven",
            "Eight",
            "Nine",
            "Ten",
            "Eleven",
            "Twelve",
            "Thirteen",
            "Fourteen",
            "Fifteen",
            "Sixteen",
            "Seventeen",
            "Eighteen",
            "Nineteen",
        ];
        var tens = [
            "",
            "",
            "Twenty",
            "Thirty",
            "Forty",
            "Fifty",
            "Sixty",
            "Seventy",
            "Eighty",
            "Ninety",
        ];
        var thousands = ["", "Thousand", "Lakh", "Crore"];

        function convertNumberToWords(num) {
            if (num === 0) return "zero";
            if (num < 20) return ones[num];
            if (num < 100)
                return (
                    tens[Math.floor(num / 10)] + (num % 10 ? " " + ones[num % 10] : "")
                );
            if (num < 1000)
                return (
                    ones[Math.floor(num / 100)] +
                    " Hundred" +
                    (num % 100 ? " and " + convertNumberToWords(num % 100) : "")
                );

            var result = "";
            var i = 0;
            while (num > 0) {
                var chunk = num % 1000;
                if (chunk) {
                    result =
                        convertNumberToWords(chunk) +
                        " " +
                        thousands[i] +
                        (result ? " " + result : "");
                }
                num = Math.floor(num / 1000);
                i++;
            }
            return result.trim();
        }

        function convertDecimalToWords(decimal) {
            if (decimal === 0) return "";
            return convertNumberToWords(decimal) + " paise";
        }

        var integerPart = Math.floor(num);
        var decimalPart = Math.round((num - integerPart) * 100);

        var integerPartWords = convertNumberToWords(integerPart);
        var decimalPartWords = convertDecimalToWords(decimalPart);

        var result = integerPartWords + " rupees";
        if (decimalPartWords) {
            result += " and " + decimalPartWords;
        }
        result += " only";

        return result;
    }


