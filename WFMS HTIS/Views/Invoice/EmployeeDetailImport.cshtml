    function _DataVerify() {
        var workOrderNo = $('#Work_Order').val();
        var DdlAgencynew = $('#ddlAgencynew').val();
        var deptId = $('#DeptId').val();
        var data = JSON.stringify(getdata());

        var formData = new FormData();
        formData.append("DeptId", deptId);
        formData.append("ddlAgencynew", DdlAgencynew);
        formData.append("WorkOrderNo", workOrderNo);
        formData.append("Resources", $('#Resources').val());
       // formData.append("NoOfEmp", $('#NoOfEmp').val());
        formData.append("Table", data);

        $.ajax({
            type: "POST",
            url: "/Invoice/_InsertDetailVerification",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                if (data != "[]") {
                    $('.modal-title').html("EmployeeDetail Verification Status List");
                    $('#myModal').modal({
                        show: 'false'
                    });
                    var obj = $.parseJSON(data);
                    var table = $('#myTable').DataTable();
                    table.clear().draw();
                    var sr = 0;
                    $("#submitBtn").prop("disabled", true);
                    $.each(obj, function (key, value) {
                        sr = sr + 1;
                        var statusIcon = "";
                        if (value.VerificationStatus == "Green") {
                            statusIcon = '<i class="fa fa-check" style="color:green; font-size:20px;"></i>';
                        } else if (value.VerificationStatus == "Red") {
                            statusIcon = '<i class="fa fa-times" style="color:red; font-size:20px;"></i>';
                        } else {
                            statusIcon = value.VerificationStatus;
                        }
                        var errorMsg = "";
                        if (value.Error_Message && value.Error_Message.trim() !== "") {
                            errorMsg = '<span style="color:red; font-weight:bold;">' + value.Error_Message + '</span>';
                        }

                        var elmntArray = [
                            sr,
                            value.Empname,
                            value.AADHARNO,
                            value.DesigationId,
                            statusIcon,
                            errorMsg
                        ];
                        table.row.add(elmntArray).draw(false);
                        if (value.Isuploaded == 1) {
                            $("#submitBtn").prop("disabled", false);
                        }

                    });
                }
                else {
                    alert("data uploaded Fail!");
                }
            }
        });
    }
