    function DesignationExcel() {
        $('#ProgressImg').show();
        $.post('/Invoice/DesignationListDownload',
            {
                'fiDesignationID': 0
            },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var msr = 0;
                var dataForExport = [];
                dataForExport.push(["DESIGNATION LIST"]);
                dataForExport.push([]);
                dataForExport.push([
                    "Sr. No.",
                    "Designation ID",
                    "Designation Name"
                ]);
                $.each(obj, function (key, value) {
                    msr++;
                    dataForExport.push([
                        msr,
                        value.fiDesignationID,
                        value.fvDesignationName
                    ]);
                });
                const ws = XLSX.utils.aoa_to_sheet(dataForExport);
                ws["!merges"] = [
                    { s: { r: 0, c: 0 }, e: { r: 0, c: 2 } }
                ];

                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Designation List");
                XLSX.writeFile(wb, "Designation_List.xlsx");
            });
    }
