<script>
 var mId = 0;
     var pageSize=@pageSize;
        var sr = 0;
        $(document).ready(function () {
            TableManageDefault.init();
            validateShowButton();
            $('#DeptId').select2();
            $('#DeptIdEmployee').select2();
            $('#Designation').select2();
        });
    function toggleEpf() {
        var basic = parseFloat(document.getElementById("Basic").value) || 0;
        var epfInput = document.getElementById("epf");

        if (document.getElementById("chkEpf").checked) {
            epfInput.style.display = "block";
            if (basic > 0) {
                var epfBase = basic > 15000 ? 15000 : basic;
                epfInput.value = (epfBase * 0.13).toFixed(2);
            } else {
                epfInput.value = "0.00";
            }
        } else {
            epfInput.style.display = "none";
            epfInput.value = "";
        }
        calculateAdminCharge();
    }
    function toggleEsic() {
        var basic = parseFloat(document.getElementById("Basic").value) || 0;
        var esicInput = document.getElementById("Esic");

        if (document.getElementById("chkEsic").checked) {
            esicInput.style.display = "block";
            if (basic > 0) {
                var esicBase = basic > 21000 ? 21000 : basic;
                esicInput.value = (esicBase * 0.0325).toFixed(2);
            } else {
                esicInput.value = "0.00";
            }
        } else {
            esicInput.style.display = "none";
            esicInput.value = "";
        }
        calculateAdminCharge();
    }
    function calculateAdminCharge() {
        var basic = parseFloat(document.getElementById("Basic").value) || 0;
        var epf = document.getElementById("chkEpf").checked
            ? parseFloat(document.getElementById("epf").value) || 0
            : 0;
        var esic = document.getElementById("chkEsic").checked
            ? parseFloat(document.getElementById("Esic").value) || 0
            : 0;
        var others = parseFloat(document.getElementById("Others").value) || 0;

        var total = basic + epf + esic + others;
        document.getElementById("Total").value = total.toFixed(2);
    }
    document.getElementById("Basic").addEventListener("input", function () {
        if (document.getElementById("chkEpf").checked) toggleEpf();
        if (document.getElementById("chkEsic").checked) toggleEsic();
        calculateAdminCharge();
    });

     function validateShowButton() {
            var agency = $('#ddlAgencynew').val();
            var dept = $('#DeptId').val();
            var workOrder = $('#Work_Order').val();

            var fileSelected = $('#ExcelFile').val();

            var isValid = agency !== "0" &&
                dept !== "0" &&
                workOrder !== "0" &&

                fileSelected !== "";

            $('input[value="View"]').prop('disabled', !isValid);
        }
        $(document).on('change keyup', '#ddlAgencynew, #DeptId, #Work_Order,  #ExcelFile', function () {
            validateShowButton();
        });
    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl2', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
                $('#ddlAgencynew').html(DeploymentOfficeId);
            });
        });
    }
    function _Departmentddl() {
        $.post('/Invoice/_AvoDepartmentddlEmployee', { 'Id': 0, 'AgencyId': $("#ddlAgencynew").val() }, function (data) {
            var DeptIdvar = '<option value="0">---select---</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptIdvar += '<option value=' + value.Id + '>' + value.EntityName + '</option>';
            });
            $('#DeptId').html(DeptIdvar);
        });
    }
    function ClearEmployeeForm() {
        $('.cleartxt').val('');
        $('.clearddl').val('0');
        $('#DeptIdEmployee').val('0').trigger('change');
        $('#Designation').val('0').trigger('change');
        $('input[type="checkbox"]').prop('checked', false);
        $('#epf').val('').hide();
        $('#Esic').val('').hide();
        $('#Total').val('');
    }

    function _WorkOrderDdl() {

        $.post('/Invoice/_WorkOrderDdlEmployee', { 'AgencyId': 0, 'WorkOrderAgencyId': 0, 'DeptId': $("#DeptId").val() }, function (data) {
            var DeploymentOfficeId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.WorkOrderAgencyId + '>' + value.WorkOrderId + '</option>'
            });
            $('#Work_Order').html(DeploymentOfficeId);

        });
    }
    function _WorkOrderDetails() {
        $.post('/Invoice/_WorkOrderDdl', {
            'AgencyId': 0,
            'DeptId': $("#DeptId").val(),
            'WorkOrderAgencyId': $("#Work_Order").val(),
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                $('#Resources').val(value.NoDeployedRes);
            });

        });
    }
        function showWarning(message) {
            Swal.fire({
                icon: 'warning',
                title: message,
                customClass: {
                    confirmButton: 'swal-ok-btn'
                },
                showClass: { popup: 'animate__animated animate__fadeInDown' },
                hideClass: { popup: 'animate__animated animate__fadeOutUp' }
            });
        }

        function Show() {
            $('input[value="View"]').prop('disabled', true);
            var formData = new FormData();
            formData.append('ExcelFile', $('input[name=file]')[0].files[0]);

            $.ajax({
                url: '/Invoice/_ImportFile01',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    $('#ProgressImg').hide();
                    var obj = $.parseJSON(data);

                    var noOfResources = parseInt($("#Resources").val() || "0", 10);
                    var excelCount = obj.length;
                    if (excelCount !== noOfResources) {
                        showWarning("⚠ Warning: You Are Trying To Upload (" + excelCount +
                            ") Resources But In Your Work Order  (" + noOfResources + ")Reosurces");
                        return;
                    }

                    $("#tblExcel > TBODY").empty();
                    var sr = 0;
                    $.each(obj, function (key, value) {
                        sr++;
                        var template1 = '<tr>';
                        template1 += '<td><span class="Sr.">' + sr + '</span></td>';
                        template1 += '<td><span class="Empname">' + value.Empname + '</span></td>';
                        template1 += '<td><span class="Father_Name">' + value.Father_Name + '</span></td>';
                        template1 += '<td><span class="IsFullTime">' + value.IsFullTime + '</span></td>';
                        template1 += '<td><span class="DesigationId">' + value.DesigationId + '</span></td>';
                        template1 += '<td><span class="AADHAR">' + value.AADHAR + '</span></td>';
                        template1 += '<td><span class="Basic">' + value.Basic + '</span></td>';
                        template1 += '<td><span class="Others">' + value.Others + '</span></td>';
                        template1 += '<td><span class="IsPf">' + value.IsPf + '</span></td>';
                        template1 += '<td><span class="IsEsi">' + value.IsEsi + '</span></td>';
                        template1 += '<td><button id="btnRemove" onclick="RemoveItemlist(this);">Remove</button></td>';
                        template1 += '</tr>';
                        $("#tblExcel > TBODY").append(template1);
                    });
                    if ($("#tblExcel tbody tr").length > 0) {
                        $('input[value="Verify"]').prop('disabled', false);
                    }
                }
            });
        }

        function RemoveItemlist(button) {
            var row = $(button).closest("TR");
            var name = $("TD", row).eq(0).html();
            if (confirm("Do you want to delete: " + name)) {
                var table = $("#tblExcel")[0];
                table.deleteRow(row[0].rowIndex);
                if ($("#tblExcel tbody tr").length === 0) {
                    $('input[value="Verify"]').prop('disabled', true);
                }
            }
        }

