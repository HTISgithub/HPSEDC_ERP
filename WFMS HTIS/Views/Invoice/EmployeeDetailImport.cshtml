<style>
    .btn {
        display: inline-block;
        padding: 6px 12px;
        margin-bottom: 0;
        font-size: 14px;
        font-weight: normal;
        line-height: 1.42857143;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        cursor: pointer;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        background-image: none;
        border: 1px solid transparent;
        border-radius: 4px;
    }
    /*Also */
    .btn-success {
        color: #fff;
        background-color: #5cb85c;
        border-color: #4cae4c;
    }

    .fileinput-button {
        position: relative;
        overflow: hidden;
    }
        /*Also*/
        .fileinput-button input {
            position: absolute;
            top: 0;
            right: 0;
            margin: 0;
            opacity: 0;
            -ms-filter: 'alpha(opacity=0)';
            font-size: 200px;
            direction: ltr;
            cursor: pointer;
        }

    .hidden {
        display: none !important;
    }

    .ui-helper-hidden-accessible {
        display: none !important;
    }

    .ui-datepicker-calendar {
        background-color: white;
    }

        .ui-datepicker-calendar td {
            padding: 5px;
            border-collapse: collapse;
        }

    #ui-datepicker-div {
        padding: 5px;
        border: solid 1px #e8e8e8;
        background-color: white;
        box-shadow: 0 2px 4px rgba(0,0,0,.2);
    }


    .file-input-large {
        height: 35px;
        font-size: 14px;
        padding: 6px;
        width: 219px;
    }

    .modal-footer {
        display: flow;
    }

    .swal-ok-btn {
        font-size: 18px !important;
        padding: 10px 25px !important;
    }
</style>
@******************Breadcrumb Start**************@
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Excel</a>
        </li>

        @*<li>
                <a href="#">Daily Reports</a>
            </li>*@
        @*<li class="active">@ViewBag.PageTitle</li>*@
    </ul><!-- /.breadcrumb -->

</div>
<!-- 🔹 Step Guide Start -->
<div class="step-guide" style="margin:15px 0; padding:10px; background:#f8f9fa; border:1px solid #ddd; border-radius:5px; display:flex; justify-content:space-between; align-items:center;">
    <div>
        <h5 style="margin-bottom:10px; font-weight:bold; color:#00476a;">Steps to Upload Employee Excel:</h5>
        <ol style="margin-left:20px; line-height:1.8; color:#333;">
            <li>
                <b>Download Template</b>
            </li>
            <li>
                <b>Prepare your employee data in that Excel file</b>
                <span style="color:#d9534f; font-weight:bold; margin-left:10px;">
                    ⚠ Excel file must be created Work Order wise
                </span>
                <div style="margin-top:8px; display:flex; flex-direction:column; gap:5px;">
                    <span style="color:#004085; font-weight:bold;">(For Designation Write DesigntionID as Mention in this Sheet)</span>
                    <a href="javascript:void(0);" onclick="DesignationExcel()" class="btn btn-success btn-sm" style="width:max-content;">
                        <i class="fa fa-download"></i> Download Designation Code Excel Sheet
                    </a>
                </div>
            </li>
            <li>Select <b>Agency</b></li>
            <li>Select <b>Department</b></li>
            <li>Select <b>Work Order</b></li>
            <li><b>Upload Excel File</b></li>
            <li>Click on <b>View</b> to check records</li>
            <li>Click on <b>Verify</b> to validate data</li>
            <li>If all records are correct → Click <b>Upload</b></li>
        </ol>
        <p style="margin-top:10px; font-weight:bold; color:#000;">
            If you want to add employees manually, click on the <b>ADD Employee Details</b> button on the side.
        </p>
    </div>

    <!-- 🔹 Right Side Button -->
    @if (user == "48")
    {
        <div class="page-header">
            <h1>
                <a class="btn btn-primary pull-right btnAddModal" onclick="OpenAddModel()">
                    <i class="fa fa-plus"></i> ADD Employee Details
                </a>
            </h1>
        </div>
    }
</div>


<!-- 🔹 Step Guide End -->
@******************Breadcrumb End**************@

