<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

<script>
    var mAgencyId = 0, accessRights;
    var vId = 0;
    var sr = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();
        _PaymentRelease_List();
        $('#ddlAgency').select2();
        $('#ddldepartment').select2();
    });


    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').val(mAgencyId);
        });
    }

    _Departmentddl();
    function _Departmentddl() {
        $.post('/Invoice/_AvoDepartmentddlNew1', { 'Id': 0 }, function (data) {
            var DeptId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptId += '<option value=' + value.Id + '>' + value.EntityName + '</option>';
            });
            $('#ddldepartment').html(DeptId);
        });
    }

    function _PaymentRelease_List() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val()
        //if ($('#PaymentRecive').prop('checked')) {
        //    var PaymentRecive = 'Y';
        //}
        //else {
        //    var PaymentRecive = 'N';
        //}

        $('#ProgressImg').show();
        $.post('/Invoice/_PaymentRelease_List', {
            DeptId: $('#ddldepartment').val(),
            MonthId: month,
            AgencyId: $('#ddlAgency').val(),
            //PaymentId: 1,
            SaleBillNo: ''
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();

            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;

                var BillDetail = '<div>' + value.Billno + '<br> ' + value.BillDate + '</div>';
                //var SaleAmount = '<div>' + 'Amt2- ' + parseFloat(value.SAmount).toFixed(2) + '<br>' +
                //    'CG - ' + parseFloat(value.cgstAmt).toFixed(2) + '<br>' + 'SG - ' + parseFloat(value.SGSTAtm).toFixed(2) +
                //    '<br>' + 'TA2 - ' + parseFloat(value.TotalAmt1).toFixed(2) + '</div>';

                var Tax = '<div>' + 'GstTds2- ' + parseFloat(value.GstTds2).toFixed(2) + '<br>' +
                    'Tds1- ' + parseFloat(value.Tds1).toFixed(2) + '<br>' + 'Tds2- ' + parseFloat(value.Tds2).toFixed(2)

                var PaymentRelease = '<div>' + 'Transaction Id- ' + (value.TransactionId) + '<br>' +
                    'Mode Of Payment- ' + (value.ModeOfPayment) + '<br>' + 'Payment Date- ' + (value.PaymentDate) +
                    '<br>' + 'Payment Release - ' + parseFloat(value.PaymentAmt).toFixed(2) + '</div>';

                //var RAmountDetail = '<div>' + 'Mode Of Payment- ' + value.ModeOfPayment + '<br>' +
                //    'Transaction Id- ' + value.TransactionId + '<br>' + 'Transaction Date -' +
                //    value.ReceivedDate + '<br>' + 'Amount Payable -' +
                //    parseFloat(parseFloat(value.TBalanceAmt).toFixed(0)).toFixed(2) + '</div>';

                //var checkbox = '<input type="checkbox" class="form-control clearchk12" id="bill' + msr + '" value="' + value.SaleBillNo + '"/>';

                var elmntArray = [
                    // checkbox,
                    msr,
                    value.DepartmentAddress,
                    value.AgencyName,
                    //value.Billno,
                    BillDetail,
                    value.TotalAmt,
                    value.SaleBillNo,
                    Tax,
                    PaymentRelease
                    //RAmountDetail
                ];
                table.row.add(elmntArray).draw(false);
            });
            //$('.clearchk12').prop('checked', false);
            //checkedBills = [];
        });

    }
</script>