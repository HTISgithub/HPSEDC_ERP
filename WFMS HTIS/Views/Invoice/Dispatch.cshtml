    <div class="row">
        &nbsp;
        <div class="col-md-12">
            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-12">
                        <div class="col-md-3" style=" margin-top: -71px;">
                            <label for="Month">Month Year</label><span class="error-message">*</span>
                            <select id="ddlMonths" class="Month" onchange="SubMonthlyReport()">
                                <option>--Month--</option>
                                @for (int i = 1; i <= 12; i++)
                                {

                                    DateTime date = new DateTime(2020, i, 1);
                                    mon = date.ToString("MMM");
                                    <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                }
                            </select>
                            <select id="ddlYears" class="year" onchange="SubMonthlyReport()">
                                <option>--Year--</option>
                                @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                {
                                    if (i == DateTime.Now.Year)
                                    {
                                        <option value="@i" selected='selected'>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 280px; display:none;">
                            <label for="Complaint">Agency</label><span class="error-message">*</span>
                            <select id="ddlAgency" style="width: 20rem" onchange="SubMonthlyReport()">
                                <option value="0">Select Agency</option>
                            </select>
                        </div>

                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 580px; display: none;">
                            <label for="Complaint">Department</label><span class="error-message">*</span>
                            <select id="ddldepartment" style="width: 20rem" onchange="SubMonthlyReport()">
                                <option value="0">Select Department</option>
                            </select>
                        </div>
                    </div>

                    @*<div class="col-md-1" style=" margin-top: -83px; margin-left: 1045px; display:flex;flex-direction:row ">
                            <button id="printData" style="background-color: #337ab7; width: 4vw; color: white; font-size: 16px; padding: 8px 8px; border-radius: 5px; border: none; " onclick="printData()">Print</button>
                            <button id="exportBtn" style="background-color: #337ab7; width: 4vw; color: white; font-size: 16px; padding: 8px 12px; border-radius: 5px; border: none; margin-left:10px " onclick="Excel()">Excel</button>
                        </div>*@
                </div>
            </div>
