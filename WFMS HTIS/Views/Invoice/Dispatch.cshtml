<!-- Dispatch Model  -->
<div class="modal fade" id="DispatchModel" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#00476a;color:white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
                    <div class="table-responsive">
                        <!-- Pehla bordered div -->
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-bottom: 20px;">
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label for="Invoice">Sale Bill No.(HPSEDC Ref.No.)</label>
                                    <input id="Invoice" class="form-control cleartxt required" placeholder="Invoice No." readonly>
                                </div>
                                <div class="col-md-6">
                                    <label for="Department">Department Name</label>
                                    <input id="Department" class="form-control cleartxt required" placeholder="Department Name" readonly>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label for="Complaint" @*style=" font-weight: 390;"*@>Department Name With Billing Address</label>
                                    <textarea rows="2" cols="51" id="Address" style="width: 847px; height: 31px;" placeholder="Department Name With Address" disabled></textarea>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="Dispatch">Dispatch No.</label>
                                    <input id="Dispatchno" class="form-control cleartxt required" placeholder="Department Name" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>


        <div class="modal-footer">

            <div class="row">

                <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>

                <div class="col-md-8">

                    <div class="modelalert"></div>

                </div>

                <div class="col-md-2">

                    <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />

                </div>

            </div>



        </div>

    </div>

</div>

<!-- Dispatch Model -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var mAgencyId;
    $(document).ready(function () {
        TableManageDefault.init();
        SubMonthlyReport();
    });

    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').val(mAgencyId);
        });
    }

    _Departmentddl();
    function _Departmentddl() {
        $.post('/Invoice/_AvoDepartmentddlNew1', { 'Id': 0 }, function (data) {
            var DeptId = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                DeptId += '<option value=' + value.Id + '>' + value.EntityName + '</option>';
            });
            $('#ddldepartment').html(DeptId);
        });
    }


    function SubMonthlyReport() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();

        $.post('/Invoice/_DispatchList', {
            DeptBillId: '0',
            MonthId: month,
            DeptId: '0',
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();

            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;

                var VerifiedIcon = '-';
                if (value.IsDispatched === 'N') {
                    VerifiedIcon = '<i class="fa fa-close" style="font-size:48px;color:red"></i>';
                }
                else if (value.IsDispatched === 'Y') {
                    VerifiedIcon = '<i class="fa fa-check" style="font-size:48px;color:green"></i>';
                }

                var ActionBtn = '<div style="text-align:center;">';
                if (value.IsDispatched === 'Y') {
                    ActionBtn += '<button disabled class="btn btn-secondary btn-sm" style="opacity: 0.6; cursor: not-allowed;">' +
                        '<i class="fa fa-pencil"></i></button>';
                } else {
                    ActionBtn += '<button onclick="OpenAddModel(' + value.DeptBillId + ')" class="btn btn-primary btn-sm">' +
                        '<i class="fa fa-pencil"></i></button>';
                }
                ActionBtn += '</div>';

                var elmntArray = [
                    msr,
                    value.AgencyName,
                    value.Billno,
                    value.SaleBillNo,
                    value.BillforMonth,
                    value.DepartmentAddress,
                    VerifiedIcon,
                    ActionBtn,
                    value.DispatchNo
                ];

                table.row.add(elmntArray).draw(false);
            });
        });
    }

    var Id;
    function OpenAddModel(DeptBillId) {
        $('.modal-title').html("Enter Dispatch Details");
        $('#DispatchModel').modal({
            show: 'false'
        });

        Id = DeptBillId;
        _DispatchListGet(DeptBillId);
        root = '/Invoice/_DispatchListGet';


    }
    function _DispatchListGet(DeptBillId) {
        alert(DeptBillId);
        $.post('/Invoice/_DispatchListGet', {
            'DeptBillId': DeptBillId,
            'MonthId': '0',
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                $('#Invoice').val(value.SaleBillNo);
                $('#Department').val(value.departmentName);
                $('#Address').val(value.DepartmentAddress);
                $('#Dispatchno').val(value.DispatchNo1);
            });
        });

        $('.modal-title').html("Enter Dispatch Details");
        $('#DispatchModel').modal({
            show: 'false'
        });
    }
    $('.btnModalSubmit').click(function () {
        _DispatchSubmit();
    });

    function _DispatchSubmit() {

        if ($('#Dispatchno').val() == '') {
            alert('Please Enter Transaction Id');
            return;
        }

        $('.modelalert').html('');
        $('#ModalProgress').show();
        $.post('/Invoice/_DispatchSubmit', {
            'DispatchId': 0,
            'DeptBIllId': Id,
            'DispatchNo': $('#Dispatchno').val(),
            'OfficeAddressId': 0,
            'OfficeAdddress': $('#Address').val(),
        }, function (data) {
            $.post('/Invoice/SendEmail1', { 'BillId': Id }, function (data) {
                alert(data);
            });

            alert(data);
            Id = 0;
            $('#DispatchModel').modal('hide');
            $('.btnModalSubmit').removeAttr("disabled");
            $('#ModalProgress').hide();
            SubMonthlyReport();
        });
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>