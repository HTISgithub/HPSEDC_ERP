            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>

<script>
    var mAgencyId = 0, accessRights;
    var vId = 0;
    var sr = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();
        _VerifyEPFESIlist();
        //_VerifyEPFESIlistModel();
        $('#ddlAgency').select2(
            {
                dropdownAutoWidth: 'false'

            });

    });
    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);

        });
    }

    function _VerifyEPFESIlist() {
        var monthyear = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        console.log($('#ddlAgency').val());

        $.post('/Invoice/_VerifyEPFESIlist', {
            'AgencyId': $('#ddlAgency').val(),
            'MonthYear': monthyear,
            'ChallanId': vId,
            'ChllanType': $('#ChllanType').val(),
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;
                //alert(value.IsVarified);

                var colorStyle = "";
                if (value.IsVarified == 'Y') {
                    colorStyle = "style='color:green;'";
                } else if (value.IsVarified == 'N') {
                    colorStyle = "style='color:red;'";
                } // if null or undefined, leave as default

                var btnEpfEsi = '<a href="#" onclick="OpenAddModel(' + value.ChallanId + ')" class="img-circle">' +
                    '<center><i class="fa fa-check-circle fa-3x" ' + colorStyle + '></i></center></a>';

                var elmntArray = [
                    msr,
                    value.AgencyName,
                    value.BillForMonth,
                    value.ChallanNumber,
                    value.ChallanType,
                    value.Amount,
                    value.NoOfResource,
                    btnEpfEsi
                ];

                table.row.add(elmntArray).draw(false);
            });
        });
    }

    var chId;
    function OpenAddModel(ChallanId) {

        $('.modal-title').html("<table><tr><td>Add EPF ESI</td><td style=padding-inline:185px;align:center;!important></td></tr></table>");
        $('#myModal').modal({
            show: 'false'

        });
        vId = ChallanId;
        chId = ChallanId;
        _VerifyEPFESIlistGet(ChallanId);
        root = '/Invoice/_VerifyEPFESIlistGet';
        _VerifyEPFESIlistModel(ChallanId);
        root = '/Invoice/_VerifyEPFESIlistModel';

        // View(WorkOrderId, MonthYear);
    }
    $('.btnModalSubmit').click(function () {
        _VerifyEPFESISubmit();

    });
    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('.cleartxt').val('');
        $('.clearddl').val('0');
        $('.clearchk').val('');
    }
    $('.modal-footer').show();

    function ViewDocument() {
        window.open(`/ChallanDoc/${ChallanDocument}`, target = "_blank");
    }
    function ViewDocument2() {
        window.open(`/ChallanDetailsDoc/${ChallanDocument2}`, target = "_blank");
    }
    function _VerifyEPFESIlistModel(ChallanId) {
        //var monthyear = $('#ddlMonths').val() + $('#ddlYears').val();

        $('#ProgressImg').show();
        $.post('/Invoice/_VerifyEPFESIlistModel', {
            'AgencyId': 0,
            'MonthYear': 0,
            'ChallanId': ChallanId

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable1').DataTable();
            table.clear().draw();

            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;
                var elmntArray = [
                    msr,
                    value.Billno,
                    value.BillforMonth,
                    value.NoOfResource,
                    value.EpfPerson,
                    value.EsiPerson,
                    value.ChallanType,
                ];
                table.row.add(elmntArray).draw(false);
            });
        });

    }

    var ChallanDocument = '';
    var ChallanDocument2 = '';
    function _VerifyEPFESIlistGet(ChallanId) {

        $.post('/Invoice/_VerifyEPFESIlistGet', {
            'AgencyId': 0,
            'MonthYear': 0,
            'ChallanId': chId
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                $('#AgencyName').val(value.AgencyName);
                $('#Monthyear').val(value.BillForMonth);
                $('#Challanfor').val(value.ChallanType);
                $('#ChallanNo').val(value.ChallanNumber);
                $('#MappedId').val(value.InvoicePerson);
                $('#Noofresource').val(value.NoOfResource);
                $('#TotalAmount').val(value.Amount);

                // $('#ChallanAttachment').attr('href', '/ChallanDoc/' + value.AttacheChallan);;
                ChallanDocument = value.AttacheChallan;

                //$('#ChallanAttachment2').attr('href', '/ChallanDetailsDoc/' + value.AttacheChallanDetails);;
                ChallanDocument2 = value.AttacheChallanDetails;

            });
        });
    }
    var EpfEsiCheckId = 'N';
    $('#EpfEsiCheckId').change(function () {

        if ($(this).is(':checked')) {
            EpfEsiCheckId = 'Y';
        } else {
            EpfEsiCheckId = 'N';
        }

    });

    function _VerifyEPFESISubmit() {

        if (!$('#EpfEsiCheckId').is(':checked')) {
            alert('Please check EPF $ ESI ?');
            return;
        }
        $.post('/Invoice/_VerifyEPFESISubmit', {
            'ChallanId': chId,
            'IsVarified': EpfEsiCheckId,
        }, function (data) {
            alert(data);
            $('#EpfEsiCheckId').prop('checked', false);
            $('.btnModalSubmit').removeAttr("disabled");
        });
    }
    $('.btnModalSubmit1').click(function () {
        $('#myModal').modal('hide');
    });
</script>