                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
                    <div class="table-responsive">
                        <!-- Pehla bordered div -->
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-bottom: 20px;">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="AgencyName">Agency Name</label>
                                    @*<div class="" id="AgencyName"></div>*@
                                    <input id="AgencyName" placeholder="Agency Name" class="form-control cleartxt required" readonly>
                                </div>


                                <div class="col-md-4">
                                    <label for="Monthyear">Month Year</label>
                                    <input id="Monthyear" placeholder="Month Year" class="form-control cleartxt required" readonly>
                                </div>
                                <div class="col-md-4">
                                    <label for="Challan">Challan Type</label>
                                    <input id="Challanfor" class="form-control cleartxt required" placeholder="Challan for" readonly>
                                </div>

                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="ChallanNo">Challan No.</label>
                                    <input id="ChallanNo" class="form-control cleartxt required" placeholder="Challan No" readonly>
                                </div>


                                <div class="col-md-4">
                                    <label for="TotalAmount">Challan Amount</label>
                                    <input id="TotalAmount" placeholder="Total Amount" class="form-control cleartxt required" readonly>
                                </div>
                                <div class="col-md-4">
                                    <label for="Amount">No.of HPSEDC Resources</label>
                                    <input id="Noofresource" class="form-control cleartxt required" placeholder="No.Of Resource" readonly>
                                </div>

                            </div>

                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="Mapped">Mapped Resources</label>
                                    @*<div class="" id="MappedId">00010</div>*@
                                    <input id="MappedId" class="form-control cleartxt required" placeholder="Mapped Id" readonly>
                                </div>

                                <div class="col-md-4">
                                    <label class="font">Upload Challan Copy</label><span class="error-message">*</span><br />
