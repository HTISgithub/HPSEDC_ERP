                            </tbody>
                        </table>
                        @*</div>*@
                    </div>
                </div>

            </div>


        </div>


        <div class="modal-footer">

            <div class="row">

                <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>

                <div class="col-md-8">

                    <div class="modelalert"></div>

                </div>

                <div class="col-md-4">

                    <label class="" style="color:red;">Is Verify EPF & ESI</label><span class="error-message">*</span>
                    <input type="checkbox" id="EpfEsiCheckId" />

                </div>
                <div class="col-md-4">

                    <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />

                </div>
                <div class="col-md-4">

                    <input type="button" class="btnModalSubmit1 btn btn-danger" value="Close" />

