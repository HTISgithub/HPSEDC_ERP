                                </div>

                                <div class="col-md-4">
                                    <label class="font">Upload Employee Details</label><span class="error-message">*</span><br />
                                    <a onclick="ViewDocument2()" id="ChallanAttachment2" style="font-size: 20px; margin-left: 40px;">View</a><br />
                                </div>

                            </div>



                        </div>


                    </div>
                </div>


                <div class="row">
                    <div class="col-md-12">
                        @*<div style="overflow-x:auto;">*@
                        <table id="myTable1" class="table table-striped table-bordered" style="width:100%">
                            <thead>
                                <tr>
                                    <th class="widthsr">Sr.No.</th>
                                    <th>Invoice No.</th>
                                    <th>Bill For Month</th>
                                    <th>No.of Resources on Bill</th>
                                    <th>EPf Deposited (No. of Resouces)</th>
                                    <th>Esic Deposited (No. of Resources)</th>
                                    <th>Challan Type</th>


                                </tr>
                            </thead>
