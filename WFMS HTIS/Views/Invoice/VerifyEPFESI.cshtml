<div class="page-content">
    @*********Page Title************@
    <div class="page-header">

    </div>
    @*********Page End************@

    @*********Page Content************@


    <div class="row">
        &nbsp;
        <div class="col-md-12">
            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-4" style=" margin-top: -71px; ">
                        <label for="Month">Month Year</label><span class="error-message">*</span>

                        <select id="ddlMonths" class="Month" onchange="_VerifyEPFESIlist()">
                            <option>--Month--</option>
                            @for (int i = 1; i <= 12; i++)
                            {

                                DateTime date = new DateTime(2020, i, 1);
                                mon = date.ToString("MMM");
                                <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                            }
                        </select>
                        <select id="ddlYears" class="year" onchange="_VerifyEPFESIlist()">
                            <option>--Year--</option>
                            @for (int i = 2021; i <= DateTime.Now.Year; i++)
                            {
                                if (i == DateTime.Now.Year)
                                {
                                    <option value="@i" selected='selected'>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>

                    </div>

                    <div class="col-md-4" style=" margin-top: -73px; margin-left: 280px; ">
                        <label for="Complaint">Agency Name</label><span class="error-message">*</span>
                        <select id="ddlAgency" onchange="_VerifyEPFESIlist()">
                            <option value="0">Select Agency</option>
                        </select>
                    </div>

                    <div class="col-md-4" style=" margin-top: -73px; margin-left: 550px; ">
                        <label for="Complaint">Challan Type </label><span class="error-message">*</span>
                                                                    <select id="ChllanType" onchange="_VerifyEPFESIlist()">
                                                                        <option value="0">Select Challan Type</option>
                                                                        <option value="2">EPF</option>
                                                                        <option value="1">ESIC</option>
                                                                    </select>
                    </div>

                </div>


            </div>


            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>Agency Name</th>
                                <th>Month Year</th>
                                <th>Challan No.</th>
                                <th>Challan Type</th>
                                <th>Challan Amount</th>
                                <th>No. of HPSEDC Resources</th>
                                <th>Verify EPF ESIC</th>

                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="myModal" role="dialog">
