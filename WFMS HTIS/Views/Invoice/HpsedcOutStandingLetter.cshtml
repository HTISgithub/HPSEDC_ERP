    function toWords(num) {
        var ones = [
            "",
            "One",
            "Two",
            "Three",
            "Four",
            "Five",
            "Six",
            "Seven",
            "Eight",
            "Nine",
            "Ten",
            "Eleven",
            "Twelve",
            "Thirteen",
            "Fourteen",
            "Fifteen",
            "Sixteen",
            "Seventeen",
            "Eighteen",
            "Nineteen",
        ];

        var tens = [
            "",
            "",
            "Twenty",
            "Thirty",
            "Forty",
            "Fifty",
            "Sixty",
            "Seventy",
            "Eighty",
            "Ninety",
        ];

        var scales = ["", "Thousand", "Lakh", "Crore"];

        function convertNumberToWords(num) {
            if (num === 0) return "";
            if (num < 20) return ones[num];
            if (num < 100)
                return tens[Math.floor(num / 10)] + (num % 10 ? " " + ones[num % 10] : "");
            if (num < 1000)
                return (
                    ones[Math.floor(num / 100)] +
                    " Hundred" +
                    (num % 100 ? " and " + convertNumberToWords(num % 100) : "")
                );
            return "";
        }

        function integerToWords(num) {
            if (num === 0) return "Zero";

            var result = "";
            var chunks = [];
            var divider = [100, 10]; 
            chunks.push(num % 1000);
            num = Math.floor(num / 1000);
            while (num > 0) {
                chunks.push(num % 100);
                num = Math.floor(num / 100);
            }

            for (var i = chunks.length - 1; i >= 0; i--) {
                if (chunks[i]) {
                    result += convertNumberToWords(chunks[i]) + (scales[i] ? " " + scales[i] + " " : " ");
                }
            }

            return result.trim();
        }

        function convertDecimalToWords(decimal) {
            if (decimal === 0) return "";
            return convertNumberToWords(decimal) + " paise";
        }

        var integerPart = Math.floor(num);
        var decimalPart = Math.round((num - integerPart) * 100);

        var integerPartWords = integerToWords(integerPart);
        var decimalPartWords = convertDecimalToWords(decimalPart);

        var result = integerPartWords + " rupees";
        if (decimalPartWords) {
            result += " and " + decimalPartWords;
        }
        result += " only";

        return result;
    }


    function HpsedcInvoieDetails2() {
    $("#ProgressImg").show();
    var MonthYear = "01-" +  $("#ddlMonths option:selected").text() +  "-" + $("#ddlYears").val();
    var url = new URL(window.location.href);
    var Rid = 0;
    if (url.searchParams.has("BillingId")) {
       const queryString = window.location.search;
       const urlParams = new URLSearchParams(queryString);
       BillingId = urlParams.get("BillingId");
        }
        $.post(
            "/Invoice/HpsedcOutStandingLetterList",
            { MonthYear: 0, BillingId: BillingId },
            function (data) {
                var totalAmountSum = 0;
                var obj = JSON.parse(data);
                if (obj.length > 0) {
                    var toAddress = obj[0].BillingAddress.replace(/,/g, ",<br>");
                    $("#BillingAddressText3").html(toAddress);
                    var TotalAmtount = parseFloat(obj[0].TotalAmt) || 0;
                   
                    var tableBody = "";
                    var totalAmountSum = 0;

                    for (var i = 0; i < obj.length; i++) {
                        totalAmountSum += parseFloat(obj[i].TotalAmt);

                        var formattedDate = obj[i].BillDate.split('T')[0];

                        tableBody += "<tr>" +
                            "<td style='border: 1px solid black; padding: 8px;'>" + (i + 1) + "</td>" +
                            "<td style='border: 1px solid black; padding: 8px;'>" + obj[i].SaleBillNo + "</td>" +
                            "<td style='border: 1px solid black; padding: 8px;'>" + formattedDate + "</td>" +
                            "<td style='border: 1px solid black; padding: 8px; text-align: right;'>" + parseFloat(obj[i].TotalAmt).toFixed(2) + "</td>" +
                            "</tr>";
                    }
                    tableBody += "<tr style='font-weight: bold; background-color: #f9f9f9;'>" +
                        "<td colspan='3' style='border: 1px solid black; padding: 8px; text-align: right;'>Total</td>" +
                        "<td style='border: 1px solid black; padding: 8px; text-align: right;'>" + totalAmountSum.toFixed(2) + "</td>" +
                        "</tr>";
                    $("#InvoiceDetailsTableBody").html(tableBody);
                    $("#NumberinAmount2").html(totalAmountSum.toFixed(2));
                    var amountInWords = toWords(totalAmountSum);
                    $("#TaxWord2").html("(" + amountInWords + ")");
                }
            }
        );
    }
</script>