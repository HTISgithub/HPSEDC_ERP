                        <tr>
                            <th class="widthsr">Sr.No.</th>
                            <th>Agency Name</th>
                            <th>Department Name</th>
                            <th>Employee Name</th>
                            <th>Father's Name<br />Husband Name</th>
                            <th>Designation</th>
                            <th>Addhar No.</th>
                            <th>Basic Salary</th>
                            <th>Is EPF</th>
                            <th>Is ESIC</th>
