@******************Breadcrumb End**************@
<style>
    .modal-footer {
        display: block;
    }

    .input-sm {
        margin-top: 30px;
    }

    body {
        font-family: "Jost", sans-serif;
    }

    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    #myTable_wrapper {
        margin-top: -89px;
    }

    .dt-buttons {
        display: display-none;
    }

    #Zones {
        margin-top: 0px !important;
        padding-top: 5px !important;
    }

    #printData {
        display: display-none;
    }

    #loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        backdrop-filter: blur(8px);
        background-color: rgba(255, 255, 255, 0.5); /* light blur overlay */
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Loader spinner */
    .loader {
        border: 8px solid #f3f3f3;
        border-top: 8px solid #3498db;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        animation: spin 1s linear infinite;
    }

    /* Spin animation */
    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .swal-ok-btn {
        font-size: 18px !important;
        padding: 10px 25px !important;
    }
</style>
<div id="loader-overlay">
    <div class="loader"> </div>
</div>

<div class="page-content">
    @*********Page Title************@
    <div class="page-header">
    </div>
    @*********Page End************@
    @*********Page Content************@
    <div class="row">
        &nbsp;
        <div class="col-md-12">
            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-12">
                        <div class="col-md-3" style=" margin-top: -73px; margin-left: -23px;">
                            <label for="Complaint">Agency</label><span class="error-message">*</span>
                            <select id="ddlAgencynew" style="width: 20rem" onchange="_Departmentddl(); EmployeeList();">
                                <option value="0">Select Agency</option>
                            </select>
                        </div>
                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 258px;">
                            <label for="Complaint">Department</label><span class="error-message">*</span>
                            <select id="DeptId" style="width: 20rem" onchange="_WorkOrderDdl(); EmployeeList();">
                                <option value="0">Select Department</option>
                            </select>
                        </div>
                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 561px;">
                            <label for="Wokr">Work Order No.</label><span class="error-message">*</span>
                            <select id="Work_Order" style="width: 20rem" onchange="EmployeeList();">
                                <option value="0">Select Agency</option>
                            </select>
                        </div>
                        <div class="col-md-1" style=" margin-top: -85px; margin-left: 950px; display:flex;flex-direction:row">
                            <button id="exportBtn" style="background-color: #337ab7; width: 4vw; color: white; font-size: 16px; padding: 8px 12px; border-radius: 5px;  margin-left:10px; " onclick="ExportEmployeeListToExcel()">Excel</button>
                        </div>
