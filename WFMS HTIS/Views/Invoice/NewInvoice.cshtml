    function _InvoicePurchaseListget() {

        //var month2 = $('#ddlMonths2').val() + $('#ddlYears2').val();

        $.post('/Invoice/_InvoicePurchaseListget', {
            'WorkorderNo': $('#WOrderNo2').val(),
            'AgencyBillId': $('#BillingId').val(),
            'AgencyId': $('#ddlSelectAgency').val(),
            'DeptId': $('#selectDeptId').val(),
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                $('#WorkOrderNo1').val(value.WorkOrderNo);
                $('#NoOfResource1').val(value.NoOfResource);
                $('#Description2').val(value.Description);
                $('#DepartmentAddress2').val(value.DepartmentAddress);

                $('#BillingIdExisting').val(value.BillingId);

                $('#AgencyBill2').val(value.AgencyBillAmt);
                $('#Libary2').val(value.LibaryAmt);
               // $('#Admin2').val(value.AdminAmt * 2);
                $('#Admin2').val(value.AdminAmt);
                $('#ddlMonths2').val(value.BillforMonth.toString().substring(0, 1));
                $('#ddlYears2').val(value.BillforMonth.toString().substring(1));

                var agencyBillAmt = parseFloat(value.AgencyBillAmt) || 0;
                var adminAmt = parseFloat(value.AdminAmt) || 0;
                var libraryCharge = parseFloat(value.LibaryAmt) || 0;

                var taxableAmt = agencyBillAmt + adminAmt + libraryCharge;

                var cgst = taxableAmt * 0.09;
                var sgst = taxableAmt * 0.09;

                $('#cgst2').val(cgst.toFixed(2));
                $('#SGST2').val(sgst.toFixed(2));

                var total = taxableAmt + cgst + sgst;
                $('#Total2').val(total.toFixed(2));

            });
        });

        $('.modal-title').html("Purchase Bill Existing Data");
        $('#PurchaseBillExistingModal').modal({
            show: 'false'
        });
    }

