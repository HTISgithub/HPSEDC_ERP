@using System.Data
@{
    // string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
    ViewBag.Title = "Agency Invoicing";
    ViewBag.PageTitle = "Agency Invoicing";
    commonFunctions comfun = new commonFunctions();
    string mon = "";
    string user = Session["RoleId"].ToString();
}

@******************Breadcrumb Start**************@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />

@******************Breadcrumb End**************@
<style>
    body {
        font-family: "Jost", sans-serif;
    }

    table {
        border-radius: 5px;
    }

    th {
        font-family: "Jost", sans-serif;
        font-weight: 600;
        color: white;
        border-radius: 5px;
        font-size: 15px;
        background-color: #0f1875;
    }

    .hydrated {
        visibility: inherit;
        font-size: 5px !important;
    }

    td {
        font-family: "Jost", sans-serif;
        font-weight: 400;
    }

    .dt-buttons {
        display: none;
    }

    #myTable_wrapper {
        margin-top: -50px;
    }

</style>

<div class="page-content">
    @*********Page Title************@
    <div class="page-header">

    </div>
    @*********Page End************@

    @*********Page Content************@

    @if (user == "47")
    {
        <input type="button" class="btn btn-primary" value="Report" onclick="Report()" style="cursor: pointer !important; float:right;margin-top:-75px" />
    }


    <div class="row">
        &nbsp;
        <div class="col-md-12">

            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-4" style=" margin-top: -71px; ">
                        <label for="Month">Month Year</label><span class="error-message">*</span>

                        <select id="ddlMonths3" class="Month" onchange="_NewInvoiceList()">
                            <option>--Month--</option>
                            @for (int i = 1; i <= 12; i++)
                            {

                                DateTime date = new DateTime(2020, i, 1);
                                mon = date.ToString("MMM");
                                <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                            }
                        </select>
                        <select id="ddlYears3" class="year" onchange="_NewInvoiceList()">
                            <option>--Year--</option>
                            @for (int i = 2021; i <= DateTime.Now.Year; i++)
                            {
                                if (i == DateTime.Now.Year)
                                {
                                    <option value="@i" selected='selected'>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>

                    </div>

                </div>

            </div>

            @if (user == "39")
            {
                <a class="btn btn-primary  btnAddModal" onclick="OpenAddModel()" style=" margin-top: -45px; ">
                    <i class="fa fa-plus"></i> Enter Purchase Bill
                </a>
            }

            @if (user == "39")
            {
                <a class="btn btn-primary  btnAddModal" onclick="OpenPurchaseBillExisting()" style=" margin-top: -45px; ">
                    <i class="fa fa-plus"></i> Enter Purchase Bill(Existing)
                </a>
            }



            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                @if (user == "48")
                                {
                                    <th>Agency Bill No.</th>
                                    <th>Agency Name</th>
                                    <th>Agency Bill Date</th>
                                    <th>Agency Bill Amount</th>
                                    <th>Department Name</th>
                                    <th>Bill Verification Status</th>
                                    <th>Remarks</th>
                                    <th>Department Payment</th>
                                    <th>Agency Payment</th>
                                    <th>View HPSEDC Bill</th>
                                    <th>Delete Agency Bill</th>
                                }


                                @if (user == "39")
                                {
                                    <th>Agency Bill No.</th>
                                    <th>Agency Name</th>
                                    <th>Agency Bill Date</th>
                                    <th>Agency Bill Amount</th>
                                    <th>Department Name</th>
                                    <th>ESI & EPF</th>
                                    <th id="purchaseedit">Purchase Bill Edit</th>
                                    <th>Generate Sale Bill</th>
                                    <th id="saleedit">Sale Bill Edit</th>
                                    <th>View HPSEDC Bill</th>
                                    <th>EInvoice</th>
                                    <th>Cancel Sale Bill</th>
                                }
                                @if (user == "47")
                                {
                                    <th>Deptt. Name</th>
                                    <th>Deppt. Address</th>
                                    <th>Agency Name</th>
                                    <th>Sale Bill No.<br />Purchase Bill No.</th>
                                    <th>Sale Bill Amount</th>
                                    <th>Sale Bill Date</th>
                                    <th>Department Payment</th>
                                    <th>Partial Payment</th>
                                    <th>Edit Deptt.</th>
                                    <th>View</th>
                                }
                                @if (user == "46")
                                {
                                    <th>Deptt. Name</th>
                                    <th>Deppt. Address</th>
                                    <th>Agency Name</th>
                                    <th>Agency Bill No.</th>
                                    <th>Agency Bill Amount</th>
                                    <th>Agency Bill Date</th>
                                    <th>Agency Payment</th>
                                    <th>Partial Payment</th>
                                    <th>View</th>
                                }

                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update-Country" role="dialog">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#00476a;color:white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
                    <div class="table-responsive">
                        <!-- Pehla bordered div -->
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-bottom: 20px;">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="BillDate">Purchase Bill Date</label><span class="error-message">*</span>
                                    <input placeholder="Bill Date" class="form-control text-box single-line datepicker cleardate" data-val="true" id="BillDate" type="datetime" value="@DateTime.Now.ToString("dd-MMM-yyyy")">
                                </div>
                                <div class="col-md-4">
                                    <label for="Work">Work Order No.</label>
                                    <input id="WorkOrderNo" placeholder="WorkOrderNo" class="form-control cleartxt required">
                                </div>
                                <div class="col-md-4">
                                    <label for="Billno">Purchase Bill No.</label><span class="error-message">*</span>
                                    <input id="Billno" class="form-control cleartxt required" placeholder="Bill No.">
                                </div>

                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="Complaint">Agency</label><span class="error-message">*</span>
                                    <select id="ddlAgency" class="clearddl" style="width:270px">
                                        <option value="0">Select Agency</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="Complaint">Department</label><span class="error-message">*</span>
                                    <select id="DeptId" class="clearddl" style="width:269px">
                                        <option value="0">Select Department</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label for="No">No. Of Resource</label><span class="error-message">*</span>
                                    <input type="text" class="form-control cleartxt required" id="NoOfResource" placeholder="No. Of Resource" />

                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-8" style=" display:flex;flex-direction:column">
                                    <div>
                                        <label>Department Full Name With Billing Address</label><span class="error-message">*</span>
                                    </div>
                                    <div>
                                        <textarea rows="2" cols="88" id="DepartmentAddress" class="cleartxt" placeholder="Department Full Name With Address"></textarea>
                                    </div>
                                </div>

                                <div class="col-md-4" style=" display:flex;flex-direction:column">
                                    <div>
                                        <label>BillForMonth</label><span class="error-message">*</span>
                                    </div>

                                    <div>
                                        <select id="ddlMonths" class="Month">
                                            <option>--Month--</option>
                                            @for (int i = 1; i <= 12; i++)
                                            {

                                                DateTime date = new DateTime(2020, i, 1);
                                                mon = date.ToString("MMM");
                                                <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                            }
                                        </select>
                                        <select id="ddlYears" class="year">
                                            <option>--Year--</option>
                                            @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                            {
                                                if (i == DateTime.Now.Year)
                                                {
                                                    <option value="@i" selected='selected'>@i</option>
                                                }
                                                else
                                                {
                                                    <option value="@i">@i</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label for="Complaint">Description</label><span class="error-message">*</span>
                                    <textarea rows="2" cols="51" id="Description" class="cleartxt" style="width: 425px; height: 31px;" placeholder="Description"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="Complaint">Narration</label><span class="error-message">*</span>
                                    <textarea rows="2" cols="51" id="Narration" class="cleartxt" style="width: 419px; height: 31px;" placeholder="Narration"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Doosra bordered div -->
                        <div style="border: 2px solid #000; padding: 10px; position: relative; margin-top: 20px;">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <label for="AgencyBill">Basic Bill Amount</label>
                                    <input id="AgencyBill" class="form-control cleartxt required" placeholder="Agency Bill" onchange="calculateAdminCharge()">
                                </div>
                                <div class="col-md-4">
                                    <label for="Admin">Admin Charge@2.5%</label>
                                    <input id="Admin" class="form-control cleartxt" placeholder="Agency Bill" onchange="calculateTaxes()">
                                </div>
                                <div class="col-md-4">
                                    <label for="Libary">Livery Charge</label>
                                    <input id="Libary" class="form-control clearddl" value="0" placeholder="Livery Charge" onchange="calculateTaxes()">
                                </div>
                            </div>
                            <div class="form-group row">
                                <div>
                                    <input type="checkbox" class="clearchk" id="showIGST" style=" margin-left: 14px; " />
                                    <label for="showIGST">Show IGST Input</label>
                                </div>

                                <div class="col-md-3" id="igstInputContainer" style="display:none;">
                                    <label for="Igst">Input IGST@18%</label>
                                    <input id="IGST" class="form-control clearddl required" placeholder="IGST" readonly>
                                </div>

                                <div class="col-md-3">
                                    <label for="Cgst">Input CGST@9%</label>
                                    <input id="cgst" class="form-control clearddl required" placeholder="CGST" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label for="SGST">Input SGST@9%</label>
                                    <input id="SGST" class="form-control clearddl required" placeholder="SGST" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label for="Total">Total Amount</label>
                                    <input id="Total" class="form-control cleartxt required" placeholder="Total" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="modal-footer">

                <div class="row">

                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>

                    <div class="col-md-8">

                        <div class="modelalert"></div>

                    </div>

                    <div class="col-md-2">

                        <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>



