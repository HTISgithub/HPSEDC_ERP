    function calculateAdminCharge() {
        let billAmount = parseFloat(document.getElementById("AgencyBill").value);

        if (!isNaN(billAmount)) {
            // Calculate Admin Charge (2.5% of Bill Amount)
            let adminCharge = billAmount * 0.025;
            if ($('#NoAdminCharge').is(':checked')) {
                $('#Admin').val('0');
            }
            else {
                document.getElementById("Admin").value = adminCharge.toFixed(2);
            }

            // Recalculate taxes and total
            calculateTaxes();
        } else {
            // Clear related fields if input is invalid
            document.getElementById("Admin").value = '';
            document.getElementById("cgst").value = '';
            document.getElementById("SGST").value = '';
            document.getElementById("Total").value = '';
        }
    }

    function calculateTaxes() {
        let billAmount = parseFloat(document.getElementById("AgencyBill").value);
        let adminCharge = parseFloat(document.getElementById("Admin").value) || 0;
        let libraryCharge = parseFloat(document.getElementById("Libary").value) || 0;

        if (!isNaN(billAmount)) {
            let taxableAmount = billAmount + adminCharge + libraryCharge;
            var cgst = 0;
            var sgst = 0;
            var igst = 0;
            var totalAmount = 0;

            if ($('#showIGST').is(':checked')) {
                igst = taxableAmount * 0.18;
                totalAmount = taxableAmount + igst;
            }
            else {
                cgst = taxableAmount * 0.09;
                sgst = taxableAmount * 0.09;
                totalAmount = taxableAmount + cgst + sgst;
            }

            document.getElementById("cgst").value = cgst.toFixed(2);
            document.getElementById("SGST").value = sgst.toFixed(2);
            document.getElementById("IGST").value = igst.toFixed(2);
            // Calculate total amount
            document.getElementById("Total").value = totalAmount.toFixed(2);
        }
        else {
            // Clear related fields if input is invalid
            document.getElementById("cgst").value = '';
            document.getElementById("SGST").value = '';
            document.getElementById("Total").value = '';
        }
    }


    function calculateAdminCharge2() {
        let billAmount2 = parseFloat(document.getElementById("AgencyBill2").value);

        if (!isNaN(billAmount2)) {
            // Calculate Admin Charge (2.5% of Bill Amount)
            let adminCharge2 = billAmount2 * 0.025;
            if ($('#NoAdminCharge').is(':checked')) {
                $('#Admin2').val('0');
            }
            else {
                document.getElementById("Admin2").value = adminCharge2.toFixed(2);
            }

            // Recalculate taxes and total
            calculateTaxes2();
        } else {
            // Clear related fields if input is invalid
            document.getElementById("Admin2").value = '';
            document.getElementById("cgst2").value = '';
            document.getElementById("SGST2").value = '';
            document.getElementById("Total2").value = '';
        }
    }

    function calculateTaxes2() {
        let billAmount2 = parseFloat(document.getElementById("AgencyBill2").value);
        let adminCharge2 = parseFloat(document.getElementById("Admin2").value) || 0;
        let libraryCharge2 = parseFloat(document.getElementById("Libary2").value) || 0;

        if (!isNaN(billAmount2)) {
            let taxableAmount2 = billAmount2 + adminCharge2 + libraryCharge2;
            var cgst2 = 0;
            var sgst2 = 0;
            var igst2 = 0;
            var totalAmount2 = 0;

            if ($('#showIGST12').is(':checked')) {
                igst2 = taxableAmount2 * 0.18;
                totalAmount2 = taxableAmount2 + igst2;
            }
            else {
                cgst2 = taxableAmount2 * 0.09;
                sgst2 = taxableAmount2 * 0.09;
                totalAmount2 = taxableAmount2 + cgst2 + sgst2;
            }

            document.getElementById("cgst2").value = cgst2.toFixed(2);
            document.getElementById("SGST2").value = sgst2.toFixed(2);
            document.getElementById("IGST2").value = igst2.toFixed(2);
            // Calculate total amount
            document.getElementById("Total2").value = totalAmount2.toFixed(2);
        }
        else {
            // Clear related fields if input is invalid
            document.getElementById("cgst2").value = '';
            document.getElementById("SGST2").value = '';
            document.getElementById("Total2").value = '';
        }
    }


