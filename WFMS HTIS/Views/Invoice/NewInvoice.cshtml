    function _NewInvoiceSubmit() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();

        if ($('#BillDate').val() == '') {
            alert('Please Select Bill Date');
            return;
        }
        if ($('#Billno').val() == '') {
            alert('Please Enter Bill No.');
            return;
        }


        if ($('#ddlAgency').val() == '0') {
            alert('Please Select Agency');
            return;
        }

        if ($('#DeptId').val() == '0') {
            alert('Please Select Department');
            return;
        }
        if ($('#DepartmentAddress').val() == '') {
            alert('Please Enter Department Address');
            return;
        }

