                        }
                    }

                    var elmntArray = [
                        msr,
                        value.TransactionId,
                        value.ModeofPayment,
                        value.BankName,
                        value.ReceivedAmt,
                        value.GSTTds2 + '<br>' + value.Tds2,
                        value.BalanceAmt,
                        actionBtn
                    ];
                    PartialPaymentTable.row.add(elmntArray).draw(false);
                });
            });
