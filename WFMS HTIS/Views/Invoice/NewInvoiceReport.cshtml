<style>
    .modal-footer {
        display: block;
    }


    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    #myTable_wrapper {
        margin-top: -89px;
    }

        
    .dt-buttons {
        display: none;
    }
</style>
<div class="page-content">
    @*********Page Title************@
    <div class="page-header">

    </div>
    @*********Page End************@

    @*********Page Content************@


    <div class="row">
        &nbsp;
        <div class="col-md-12">
            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-4" style=" margin-top: -71px; ">
                        <label for="Month">Month Year</label><span class="error-message">*</span>

                        <select id="ddlMonths" class="Month" onchange="getList()">
                            <option>--Month--</option>
                            @for (int i = 1; i <= 12; i++)
                            {

                                DateTime date = new DateTime(2020, i, 1);
                                mon = date.ToString("MMM");
                                <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                            }
                        </select>
                        <select id="ddlYears" class="year" onchange="getList()">
                            <option>--Year--</option>
                            @for (int i = 2021; i <= DateTime.Now.Year; i++)
                            {
                                if (i == DateTime.Now.Year)
                                {
                                    <option value="@i" selected='selected'>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>

                    </div>

                    <div class="col-md-4" style=" margin-top: -73px; margin-left: 280px; ">
                        <label for="Complaint">Agency</label><span class="error-message">*</span>
                        <select id="ddlAgency">
                            <option value="0">Select Agency</option>
                        </select>
                    </div>

                </div>


            </div>


            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>Company Name</th>
                                <th>Total No. Invoice</th>
                                <th>Total Payment Amt.</th>
                                <th>Generate</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    var mAgencyId = 0, accessRights;
    var vId = 0;
    var sr = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();
        _NewInvoiceList();

    });


    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').val(mAgencyId);
        });
    }

    function _NewInvoiceList() {
        $('#ProgressImg').show();
        $.post('/Invoice/_NewInvoiceList', {
            'AgencyBillId': vId,

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();

            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;
                btn = '';

                var btnEdit = '<a href="#" onclick="OpenUpdateModel(' + value.AgencyId + ',this,\'' + value.IsActive + '\',' + value.AgencyId + ')" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';

                var elmntArray = [
                    msr,
                    value.AgencyName,
                    value.BillDate,
                    value.TotalAmt,
                    btnEdit

                ];
                table.row.add(elmntArray).draw(false);
            });
        });

    }

</script>


