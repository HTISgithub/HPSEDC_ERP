<style>
    .modal-footer {
        display: block;
    }

    .input-sm {
        margin-top: 30px;
    }

    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    #myTable_wrapper {
        margin-top: -89px;
    }


    .dt-buttons {
        display: none;
    }

    #Zones {
        margin-top: 0px !important;
        padding-top: 5px !important;
    }

    #printData {
        display: none;
    }
</style>

<div class="page-content">
    @*********Page Title************@
    <div class="page-header">

    </div>
    @*********Page End************@

    @*********Page Content************@
    <div class="row">
        &nbsp;
        <div class="col-md-12">
            <div style="margin-top:10px">
                <div class="form-group row">
                    <div class="col-md-12">
                        <div class="col-md-3" style=" margin-top: -71px;">
                            <label for="Month">Month Year</label><span class="error-message">*</span>
                            <select id="ddlMonths" class="Month" onchange="_TdsReportList()">
                                <option>--Month--</option>
                                @for (int i = 1; i <= 12; i++)
                                {

                                    DateTime date = new DateTime(2020, i, 1);
                                    mon = date.ToString("MMM");
                                    <option value="@i" @(DateTime.Now.Month == i ? "Selected='selected'" : "")>@mon</option>
                                }
                            </select>
                            <select id="ddlYears" class="year" onchange="_TdsReportList()">
                                <option>--Year--</option>
                                @for (int i = 2021; i <= DateTime.Now.Year; i++)
                                {
                                    if (i == DateTime.Now.Year)
                                    {
                                        <option value="@i" selected='selected'>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3" style=" margin-top: -73px; margin-left: 280px; ">
                            <label for="Complaint">Agency</label><span class="error-message">*</span>
                            <select id="ddlAgency" style="width: 20rem" onchange="_TdsReportList()">
                                <option value="0">Select Agency</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-1" style=" margin-top: -83px; margin-left: 1045px; display:flex;flex-direction:row ">
                        <button id="printData" style="background-color: #337ab7; width: 4vw; color: white; font-size: 16px; padding: 8px 8px; border-radius: 5px; border: none; " onclick="printData()">Print</button>
                        <button id="exportBtn" style="background-color: #337ab7; width: 4vw; color: white; font-size: 16px; padding: 8px 12px; border-radius: 5px; border: none; margin-left:10px " onclick="Excel()">Excel</button>
                    </div>
                </div>
            </div>
        </div>

        <div align="left" id="Zones">
            <div class="dt-responsive">
                <table class="table table-striped table-bordered" id="myTable">
                    <thead>
                        <tr>
                            <th class="widthsr">Sr.No.</th>
                            <th>Agency Name</th>
                            <th>PAN NO.</th>
                            <th>Month</th>
                            <th>Amount</th>
                            <th>TDS Deduction</th>
                            @*<th>Total</th>*@
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>

<script>
    var mAgencyId = 0, accessRights;
    var vId = 0;
    var sr = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();
        $('#ddlAgency').select2();
       // _TdsReportList();
    });


    function printData() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();
        $.post('/Invoice/_TdsReportList', {
            AgencyId: $('#ddlAgency').val(),
            MonthId: month,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var msr = 0;

            var printContent = `
                <div style="display: flex; justify-content: space-between;"><div style="text-align: left;">
                 @*<h2>${agencyname}</h2>*@
                          </div>
                            <div style="text-align: right;">
                             <h2>Month: ${$('#ddlMonths option:selected').text()} ${$('#ddlYears option:selected').text()}</h2></div></div>`;


            printContent += "<style>";
            printContent += "#myTable1, #myTable1 th, #myTable1 td {";
            printContent += "border: 1px solid black;";
            printContent += "border-collapse: collapse;";
            printContent += "}";
            printContent += "#myTable1 th, #myTable1 td {";
            printContent += "padding: 3px;";
            printContent += "text-align: center;";
            printContent += "}";
            printContent += "#myTable1 td {";
            printContent += "font-size: 10px";
            printContent += "}";
            printContent += "#myTable1 th {";
            printContent += "font-size: 12px";
            printContent += "}";
            printContent += "</style>";

            printContent += "<table id='myTable1'><tr><th>Sr.<br />No.</th><th>Agency Name</th><th>PAN Number</th><th>Month</th><th>Amount</th><th>TDS</th></tr>";

            var totalAmount = 0;

            $.each(obj, function (key, value) {
                totalAmount += value.PaymentAmt;
                msr = msr + 1;
                var taxAmount = 'TDS1:-' + value.Tds1 + '<br>' + 'TDS2:-' + value.Tds2;

                printContent += "<tr>";
                printContent += "<td>" + msr + "</td>";
                printContent += "<td>" + value.AgencyName + "</td>";
                printContent += "<td>" + value.PanNumber + "</td>";
                printContent += "<td>" + $('#ddlMonths').find(':selected').text() + "</td>";
                printContent += "<td>" + '₹' + value.PaymentAmt + "</td>";
                printContent += "<td>" + taxAmount + "</td>";
                printContent += "</tr>";
            });
            printContent += "</table>";

            printContent += "<div style='margin-top: 30px;'><span><strong>Total Amount = Rs." + totalAmount + "</strong></span>";


            var printWindow = window.open('', '', 'height=600,width=800');
            printWindow.document.write(printContent);
            printWindow.document.close();
            printWindow.print();
        });

    }

    function Excel() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();
        $('#ProgressImg').show();

        $.post('/Invoice/_TdsReportList', {
            AgencyId: $('#ddlAgency').val(),
            MonthId: month,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var msr = 0;
            var totalAmount = 0;
            //var tdsTotal=0;
            var tds1 = 0;
            var tds2 = 0;



            var dataForExport = [];


            dataForExport.push(["COMPUTATION OF TAXABLE AMOUNT (NON SALARIED) FOR THE" + $("#ddlMonths").find(':selected').text() + $("#ddlYears").find(':selected').text() + "& TDS DEPOSIT THERE OF IN R/o HPSEDC LTD., MEHLI"]);
            dataForExport.push([]);


            dataForExport.push([
                "Sr. No.",
                "COMPANY NAME",
                "PAN No.",
                "Month",
                "Amount",
                "TDS1 Deducted",
                "TDS2 Deducted",
            ]);


            $.each(obj, function (key, value) {
                msr++;
                totalAmount += Math.round(value.BasicAmountWithoutGST);
                //var tds = value.Tds1 != 0 ? Math.round(value.Tds1) : Math.round(value.Tds2);
                //tdsTotal +=  tds;
                tds1 += Math.round(value.Tds1);
                tds2 += Math.round(value.Tds2);
                dataForExport.push([
                    msr,
                    value.AgencyName,
                    value.PanNumber,
                    $('#ddlMonths').find(':selected').html(),
                    Math.round(value.BasicAmountWithoutGST),
                    Math.round(value.Tds1),
                    Math.round(value.Tds2),
                ]);
            });


            dataForExport.push([
                "",
                "",
                "",
                "TOTAL",
                totalAmount,
                tds1,
                tds2,
            ]);


            const ws = XLSX.utils.aoa_to_sheet(dataForExport);


            ws["!merges"] = [
                { s: { r: 0, c: 0 }, e: { r: 0, c: 6 } }
            ];

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "TDS Report");
            XLSX.writeFile(wb, "TDS_Report.xlsx");
        });
    }

    _Agencyddl();
    function _Agencyddl() {
        $.post('/Invoice/_Agencyddl1', { 'AgencyId': 0 }, function (data) {
            var DeploymentOfficeId = '<option value="0">---Select---</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                DeploymentOfficeId += '<option value=' + value.AgencyId + '>' + value.AgencyName + '</option>'
            });
            $('#ddlAgency').html(DeploymentOfficeId);
            $('#ddlAgency').val(mAgencyId);
        });
    }


    function _TdsReportList() {
        var month = $('#ddlMonths').val() + $('#ddlYears').val();

        $('#ProgressImg').show();
        $.post('/Invoice/_TdsReportList', {
            AgencyId: $('#ddlAgency').val(),
            MonthId: month,
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();

            var msr = 0;

            $.each(obj, function (key, value) {
                msr = msr + 1;
                var taxAmount =  'TDS1:-' + value.Tds1 + '<br>' + 'TDS2:-' + value.Tds2;
               /* @*var tds = value.Tds1 + value.Tds2;*@*/
                var elmntArray = [
                    msr,
                    value.AgencyName,
                    value.PanNumber,
                    $('#ddlMonths').find(':selected').text(),
                    '₹' + Math.round(value.BasicAmountWithoutGST),
                    taxAmount,
                   /* @*'₹' + value.Total,*@*/
                ];
                table.row.add(elmntArray).draw(false);
            });
        });

    }

</script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>