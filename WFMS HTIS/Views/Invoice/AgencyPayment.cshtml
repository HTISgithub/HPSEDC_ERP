        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('.cleartxt').val('');
        $('.clearddl').val('0');
        $('.clearchk').val('');
    }
    $('.modal-footer').show();


    _PaymentModeddl1();
    function _PaymentModeddl1() {
        $.post('/Invoice/_PaymentModeddl1', { 'Id': 0 }, function (data) {
            var ModePayment = '<option value="0">--Select--</option>';
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {
                ModePayment += '<option value=' + value.Id + '>' + value.ModeofPayment + '</option>'
            });
            $('#ModePayment').html(ModePayment);
            $('#ModePayment').val(Id);
        });
    }

    function _NewInvoiceListget(AgencyBillId) {
        $.post('/Invoice/_NewInvoiceListget', {
            'AgencyBillId': AgencyBillId
        }, function (data) {
            var obj = $.parseJSON(data);
            $.each(obj, function (key, value) {

                $('#PurchaseBillNo').val(value.Billno);
