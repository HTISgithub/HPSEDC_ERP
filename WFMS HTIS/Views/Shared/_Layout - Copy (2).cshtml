@using System.Collections
@using System.Data
@{
    string website = System.Configuration.ConfigurationManager.AppSettings["SiteName"];
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/SiteCmr.css" rel="stylesheet" />

    <link href="~/Content/sidemenu.css" rel="stylesheet" />
</head>
<body>
    <div id="ProgressImg" class="ProgressImg"><img src="/images/ajax-loader.gif" /></div>

    <button type="button" id="sidebarCollapse" class="btn btn-info navbar-btn">
        <i class="glyphicon glyphicon-align-left"></i>
    </button>
    <div class="navbar navbar-default navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand"><img class="logo" src="/images/logo.png" /></a>
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">  
                    <li><a href="/menus/admin">Admin</a></li> 
                    <li><a href="/menus/Payroll">Payroll</a></li>
                    <li><a href="/menus/Attendance">Attendance</a></li>
                    <li><a href="/menus/Reports">Reports</a></li>
                    <li><a href="/menus/ControlPanel">Control Panel</a></li>
                    
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </div>
    <div class="body-content wrapper">
        <div id="sidebar"></div>
        <div id="content">
            <div class="navbar-header">
                
            </div>
            @RenderBody()
        </div>
    </div>
    <div class="container">
        <footer>
            <hr />
            <p>&copy; @DateTime.Now.Year - @website</p>

        </footer>
    </div>
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"> </h4>
                </div>
                <div class="modal-body">
                    <div id="_view">
                        <div id="_editconatct"></div>

                    </div>
                    <div class="modal-footer">
                        <div class="row">
                            <div class="col-md-7 modal-loader"></div>
                            @*<div class="col-md-5" id="modal-actions">
                                    <input type="button" class="btnAdd btn btn-success btnModalSave" value="Save" />
                                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                </div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery.simplemodal.js"></script>
    <div id="basic-modal-content">

    </div>
    <script type="text/javascript">
        // Load dialog on page load
        //$('#basic-modal-content').modal();
        // Load dialog on click
        function showmodel() {
            $('#basic-modal-content').modal();
            return false;
        }
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>
</body>
</html>
