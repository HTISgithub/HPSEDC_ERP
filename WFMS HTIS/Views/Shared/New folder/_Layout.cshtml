<!DOCTYPE html>
<html lang="en">
<head>
    @{
        commonFunctions comfun = new commonFunctions();
        string projectName = "";
        if (Session["ProjectName"] == null)
        {
            if (Request.Cookies["ProjectName"] == null)
            {
                Session["ProjectName"] = "Attendance Management System";
                Response.Cookies["ProjectName"].Value = "Attendance Management System";
                Response.Cookies["ProjectName"].Expires = DateTime.Now.AddDays(1);
                projectName = Session["ProjectName"].ToString();
            }
            else
            {
                Session["ProjectName"] = Request.Cookies["Project"].Value;
                projectName = Session["ProjectName"].ToString();
            }
        }
        else
        { 
            projectName = Session["ProjectName"].ToString();
        }
    }
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <title>Dashboard</title>

    <meta name="description" content="overview &amp; stats" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Html.Partial("_layoutrefTop")
    <style>
        .error-message {
            color: #ff5b57 !important;
        }

        /*.projectname {
            font-size: 30px;
            color: #00476a;
            padding-top: 10px;
            margin-left: 104px;
        }*/
        .logdrop {
            margin-right: 20px;
            margin-top: 10px;
        }
            .logdrop a {
                background-color:transparent !important;
            }
        .logname {
            color: #333 !important;
            font-size: 16px;
            font-weight: normal;
            margin-right: 10px;
            margin-right: 15px; 
            margin-top: -1px; 
            float: left;
        }
        .logatag {
            border-radius: 50%;
            background-color: #17b0fb !important;
            min-width: 45px !important;
            height: 100%;
            
        }
        .logusericon {
            font-size: 30px !important;
            width: auto !important; 
            padding-top: 6px;
        }
        .fa-caret-down{
            color:#808080 !important;
            margin-left:10px;
        }
    </style>
</head>

<body class="no-skin">
    <div id="ProgressImg" class="ProgressImg">
        <img src="~/images/ajax-loader.gif" />
    </div>
    <div id="navbar" class="navbar navbar-default ace-save-state">
        <div class="navbar-container ace-save-state" id="navbar-container">
            <button type="button" class="navbar-toggle menu-toggler pull-left" id="menu-toggler" data-target="#sidebar">
                <span class="sr-only">Toggle sidebar</span>

                <span class="icon-bar"></span>

                <span class="icon-bar"></span>

                <span class="icon-bar"></span>
            </button>

            <div class="navbar-header pull-left">
                <a href="#" class="navbar-brand">
                    <img src="/assets/images/logo.png">
                </a>
            </div>
            <div class="pull-left projectname brand-sub-title">
                @projectName
            </div>
            <div class="navbar-buttons navbar-header pull-right" role="navigation">
                <ul class="nav ace-nav">
                    <li class="blue dropdown-modal logdrop">
                        <a data-toggle="dropdown" class="dropdown-toggle " href="#"> 
                            <span class="logname">  Hi, @(Request.Cookies["EmpName"]==null?"":Request.Cookies["EmpName"].Value)</span>
                            <i class="ace-icon fa fa-user logusericon logatag"></i> 
                            <i class="ace-icon fa fa-caret-down"></i>
                        </a>
                        
                        <ul class="dropdown-menu-right dropdown-navbar dropdown-menu dropdown-caret dropdown-close">
                            <li class="dropdown-content">
                                <ul class="dropdown-menu dropdown-navbar">
                                    <li>
                                        <a href="/account/logout" class="clearfix">Logout</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div><!-- /.navbar-container -->
    </div>
    
   
    <div class="main-container ace-save-state" id="main-container">
        <script type="text/javascript">
            try { ace.settings.loadState('main-container') } catch (e) { }
        </script>

        <div id="sidebar" class="sidebar                  responsive                    ace-save-state">
            <script type="text/javascript">
                try { ace.settings.loadState('sidebar') } catch (e) { }
            </script>


            <!------------------------------NEW PRODUCT-------------------------->
            <ul class="nav nav-list">
                <!--<li class="active">
                    <a href="index.html">
                        <i class="menu-icon fa fa-desktop"></i>
                        <span class="menu-text">Change Company </span>
                    </a>
                    <b class="arrow"></b>
                </li>-->
                <li class="">
                    <a href="#" class="dropdown-toggle" style="background-color: #EE7928;color: #fff;">
                        <i class="fa fa-product-hunt"></i>
                        <b>Change Product</b>
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">
                        <li class="ProjectChange">
                            <a href="/?id=@(comfun.encryptString("ams"))" class="ams">
                                <i class="menu-icon fa fa-caret-right"></i>
                                Attendance Management System
                            </a>
                            <b class="arrow"></b>
                        </li>
                        <li class="ProjectChange">
                            <a href="/?id=@(comfun.encryptString("payroll"))" class="payroll">
                                <i class="menu-icon fa fa-caret-right"></i>
                                PayRoll Management System
                            </a>

                            <b class="arrow"></b>
                        </li>

                        <li class="ProjectChange">
                            <a href="/?id=@(comfun.encryptString("pms"))" class="pms">
                                <i class="menu-icon fa fa-caret-right"></i>
                                Projet Management System
                            </a>
                            <b class="arrow"></b>
                        </li>
                        <li class="ProjectChange">
                            <a href="/?id=@(comfun.encryptString("esc"))" class="pms">
                                <i class="menu-icon fa fa-caret-right"></i>
                                Employee Self Care
                            </a>
                            <b class="arrow"></b>
                        </li>
                        <li class="ProjectChange">
                            <a href="/?id=@(comfun.encryptString("Account"))" class="pms">
                                <i class="menu-icon fa fa-caret-right"></i>
                                Account Management
                            </a>
                            <b class="arrow"></b>
                        </li>
                    </ul>
                </li>
            </ul>
            <!-----------------------------------END PRODUCT----------------------------->
            @{
                if (Session["Project"] == null)
                {
                    if (Request.Cookies["Project"] == null)
                    {
                        Session["Porject"] = "ams";
                        Session["ProjectName"] = "Attendance Management System";
                        Response.Cookies["Project"].Value = "ams";
                        Response.Cookies["Project"].Expires = DateTime.Now.AddDays(1);
                    }
                    else
                    {
                        Session["Porject"] = Request.Cookies["Project"].Value;
                    }
                }
                else
                {
                     
                }
            }
            @if ((Session["Project"] == null ? "ams" : Session["Project"].ToString()) == "ams")
            {
                <div>
                    @Html.Partial("_sidebarams")
                    @*@Html.Partial("_sidebar")*@
                </div>
            }
            else if ((Session["Project"] == null ? "pms" : Session["Project"].ToString()) == "pms")
            {
                <div>
                    @Html.Partial("_sidebarPms")
                </div>
            }
            else if ((Session["Project"] == null ? "payroll" : Session["Project"].ToString()) == "payroll")
            {
                <div>
                    @Html.Partial("_sidebarPayroll")
                </div>
            }
            else if ((Session["Project"] == null ? "esc" : Session["Project"].ToString()) == "esc")
            {
                <div>
                    @Html.Partial("_sidebarEsc")
                </div>
            }
            else if ((Session["Project"] == null ? "Account" : Session["Project"].ToString()) == "Account")
            {
                <div>
                    @Html.Partial("_sidebarAccount")
                </div>
            }
            <div class="sidebar-toggle sidebar-collapse" id="sidebar-collapse">
                <i id="sidebar-toggle-icon" class="ace-icon fa fa-angle-double-left ace-save-state" data-icon1="ace-icon fa fa-angle-double-left" data-icon2="ace-icon fa fa-angle-double-right" style="float: right;"></i>
            </div>
        </div>

        <div class="main-content" style="background-color: #ffffff;">
            <div class="main-content-inner">
                @RenderBody()
            </div>
            <div class="footer">
                <div class="footer-inner">
                    <div class="footer-content">
                        <span class="bigger-120">
                            <span class="blue bolder">WFMS</span>
                            Application &copy; @DateTime.Now.Year
                        </span>

                        &nbsp; &nbsp;
                        <span class="action-buttons">
                            <a href="#">
                                <i class="ace-icon fa fa-twitter-square light-blue bigger-150"></i>
                            </a>

                            <a href="#">
                                <i class="ace-icon fa fa-facebook-square text-primary bigger-150"></i>
                            </a>

                            <a href="#">
                                <i class="ace-icon fa fa-rss-square orange bigger-150"></i>
                            </a>
                        </span>
                    </div>
                </div>
            </div>

            <a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
                <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
            </a>
        </div>
        @*-----------------------------------------------------MODEL Start----------------------------------*@
        @*<div class="modal fade" id="myModaldadd" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header" style="background-color:#00476a;color:white;">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title"></h4>
                        </div>
                        <div class="modal-body">
                            <div id="_view">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="row">
                                <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                                <div class="col-md-8">
                                    <div class="modelalert"></div>
                                </div>
                                <div class="col-md-2">
                                    <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>*@
        @*</div>*@
    </div>


    @Html.Partial("_layoutrefBottom")

    @RenderSection("scripts", required: false)
</body>
</html>


