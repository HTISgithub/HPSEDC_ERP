<script>
    $(function () {
        var url = window.location.pathname;
        var element = $('ul.nav a[href="' + url + '"]').eq(0).parent();
        $('ul.nav').find('.active').removeClass('active');
        if (element.is('li')) {
            element.addClass('active');
            element.parent().show();
            var liLength = element.parents('li').length;
            element.parents('li').eq(liLength - 1).addClass('open');
            $.cookie("save_last_href", url, { expires: 9999, path: '/' });
        }
        else {
            var last_link = $.cookie("save_last_href");
            var newElement = $('a[href="' + last_link + '"]').parent();
            if (newElement.is('li')) {
                newElement.addClass('active');
                var liLength = element.parents('li').length;
                newElement.parents('li').eq(liLength - 1).show();
                newElement.parents('ul').eq(0).show();
            }
        }
    });
</script>
