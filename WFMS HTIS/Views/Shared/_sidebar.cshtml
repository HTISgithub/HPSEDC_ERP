@using System.Data;
@using System.Collections;
@{
    string roleId = Request.Cookies["RoleId"].Value;
    string proc = "MenuTree11";
    commonFunctions comfun = new commonFunctions();
    SortedList list = new SortedList();
    list.Add("@RoleId", roleId);
    list.Add("@MainId", "0");
    DataTable dt = comfun.fillDataTable(proc, "", list);
    int countChild = 0;
    string levelId1 = "0";
    string levelId2 = "0";
    string levelId3 = "0";
    string menu = "";
    string preUrl = "";
    HtmlString str = new HtmlString(menu);
}
<br />
<br />
<br />
<h4>Dynamic</h4>

<ul class="nav nav-list">
    <li class="active">
        <a href="/">
            <i class="fa fa-th-large" style="margin-left: 14px;"></i>
            <span class="menu-text"> Dashboard </span>
        </a>
        <b class="arrow"></b>
    </li>
    @for (int i = 0; i < dt.Rows.Count; i++)
    {
        menu += "<li class=''>";
        if (levelId1 != dt.Rows[i]["id"].ToString())
        {
            preUrl = dt.Rows[i]["Action"].ToString();
            levelId1 = dt.Rows[i]["id"].ToString();
            menu += "<a href='#aid_" + levelId1 + "#' class='dropdown-toggle' id='aid_" + levelId1 + "'>";
            menu += "<i class='fa fa-asterisk' style='margin-left: 14px;'></i>";
            menu += "<span class='menu-text'>";
            menu += dt.Rows[i]["text"];
            menu += "</span>";
            menu += "    <i class='fas fa-users-cog'></i>";
            menu += "    <b class='arrow fa fa-angle-down'></b>";
            menu += "</a>";
        }

        //Level 2
        list.Clear();
        list.Add("@RoleId", roleId);
        list.Add("@MainId", levelId1);
        DataTable dt2 = comfun.fillDataTable(proc, "", list);
        if (dt2.Rows.Count > 0)
        {
            menu += "<b class='arrow'></b>";
            menu += "<ul class='submenu'>";
            for (int j = 0; j < dt2.Rows.Count; j++)
            {
                menu += "<li class=''>";
                if (levelId2 != dt2.Rows[j]["Id"].ToString())
                {
                    preUrl = dt2.Rows[j]["Action"].ToString();
                    levelId2 = dt2.Rows[j]["Id"].ToString();
                    menu += "<a href='#aid_" + levelId2 + "#' class='dropdown-toggle' id='aid_" + levelId2 + "'>";
                    menu += "    <i class='menu-icon fa fa-caret-right'></i>";
                    menu += dt2.Rows[j]["text"].ToString();
                    menu += "    <b class='arrow fa fa-angle-down'></b>";
                    menu += "</a>";
                }


                //Level 3
                list.Clear();
                list.Add("@RoleId", roleId);
                list.Add("@MainId", levelId2);
                DataTable dt3 = comfun.fillDataTable(proc, "", list);


                if (dt3.Rows.Count > 0)
                {
                    menu += "<b class='arrow'></b>";
                    menu += "<ul class='submenu'>";
                    for (int k = 0; k < dt3.Rows.Count; k++)
                    {
                        menu += "  <li class=''>";
                        menu += "      <a href='" + dt3.Rows[k]["action"].ToString() + "'>";
                        menu += "          <i class='menu-icon fa fa-caret-right'></i>";
                        menu += dt3.Rows[k]["text"].ToString();
                        menu += "      </a>";
                        menu += "      <b class='arrow'></b>";
                        menu += "  </li>";

                    }
                    menu += "</ul>";
                }
                else
                {
                    menu = menu.Replace("#aid_" + levelId2 + "#", preUrl);

                }

                menu += "</li>";
            }
            menu += "</ul>";
        }
        else
        {
            menu = menu.Replace("#aid_" + levelId1 + "#", preUrl);

        }
        menu += "</li>";
    }
    @{str = new HtmlString(menu);}
    @str
</ul>
<script>
    $(document).ready(function () { 
        $('.sidebar a').each(function () {
            if ($(this).attr('href').indexOf('#') == -1) {
                $(this).removeClass('dropdown-toggle').find('b').remove();
            }
        }); 
    });
</script>
