            <h4 class="text-center">Please wait</h4>
            <span class="fa fa-spinner fa-spin fa-3x"></span>
        </div>
    </div>
    @{

        string Employee = ((int)Enum.Parse(typeof(payrollFunctions.roleIds), "Employee")).ToString();
    }
</div>
<script src="~/Scripts/autocomplete.js"></script>
<script>
        $(document).ready(function () {
            autoTextReport('EmployeeName', 'EmployeeId', '/autoComplete/_autoSearch/', 'EmpId', 'EmpName', 'EmpCode', 'Employee');
        });
    _Department();
        function showModalProgress() {
            $('.modal').modal('show');
        }
        function hideModalProgress() {
            $('.modal').modal('hide');
        }
        $('.datepicker').datepicker()
        $('.datepicker').on('changeDate', function (ev) {
            $(this).datepicker('hide');

        });
        function _Department() {
        $('#ModalProgress').show();
        $.post('/TimeSheet/_Department', {
        }, function (data) {
            $('#ModalProgress').hide();
            var department = '<option value="0">--Select Scrum--</option>';
            var obj = $.parseJSON(data);
            $('#notinotavialable').hide();
            $.each(obj, function (key, value) {
                department += '<option value=' + value.DepartmentID + '>' + value.DepartmentName + '</option>';
            });
            $('#ScrumId').html(department);
        });
    }

        $('#EmployeeName').bind('autocompleteselect', function (event, ui) {
            if (ui.item) {
                $(".EmployeeIdGlobal").val(ui.item.value);
                $(".EmployeeNameGlobal").val(ui.item.label);
                $("#CategoryIdGlobal").val('');
                $("#DesignationIdGlobal").val('');
                $("#GradeIdGlobal").val('');
                $("#CompanyIdGlobal").val('');
                $("#LocationIdGlobal").val('');
                $("#DivisionIdGlobal").val('');
                $("#DepartmentIdGlobal").val('');
                $("#CostCenterIdGlobal").val('');
                $("#ReportingManagerIdGlobal").val('');
                $("#StatusIdGlobal").val('');
                _salaryAttMonthly(1);
            }
        });

        function applyGlobalFilters() {
            hideGlobalFilters('_salaryAttMonthly(1)', 200);
        }
        $(".EmployeeIdGlobal").val('0');
        $('#EmployeeName').val('');
      //  _salaryAttMonthly(1);
        function _salaryAttMonthly(pageNo) {

            //if ($(".EmployeeIdGlobal").val().trim() == '' || $(".EmployeeIdGlobal").val().trim() == '0') {
            //    alert('Error: Please select Employee');
            //    return;
            //}
            if ($('#EmployeeName').val().trim() == '') {
                $(".EmployeeIdGlobal").val('0');
            }
            $('#ProgressImg').show();
            $.post('/TimeSheet/_AttendanceApprovalByDepartment',
                {
                    //'PageNo': pageNo,
                    'EmpId': $(".EmployeeIdGlobal").val(),
                    'DepartmentId': $('#ScrumId').val(),


                    //'CategoryId': $("#CategoryIdGlobal").val(),
                    //'Role': $("#roleId").val(),
                    //'DesignationId': $("#DesignationIdGlobal").val(),
                    //'GradeId': $("#GradeIdGlobal").val(),
                    //'CompanyId': $("#CompanyIdGlobal").val(),
                    //'LocationId': $("#LocationIdGlobal").val(),
                    //'DivisionId': $("#DivisionIdGlobal").val(),
                    //'DepartmentId': $("#DepartmentIdGlobal").val(),
                    //'CostCenterId': $("#CostCenterIdGlobal").val(),
                    //'ReportingManagerId': $("#ReportingManagerIdGlobal").val(),
                    //'StatusId': $("#StatusIdGlobal").val(),
                    'FromDate': $('#FromDate').val(),
                    'ToDate': $('#ToDate').val(),
                }, function (data) {
                    $('#_salaryAttMonthly').html(data);
                    $('#ProgressImg').hide();
                });
        }

</script>
