                                <td>To Date</td>
                                <td><input type="text" data-date-format="dd-M-yyyy" class="datepicker form-control readonly" name="ToDate" id="ToDate" readonly="readonly" value="@currentMonth.ToString("dd-MMM-yyyy")" /></td>
                                <td colspan="3">
                                    <input type="button" value="Refresh" onclick="_salaryAttMonthly(1)" class="btn btn-default btnRefresh" />
