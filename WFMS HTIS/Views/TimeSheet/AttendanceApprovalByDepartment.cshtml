@using System.Data
@{
    ViewBag.Title = "Attendance Approval Department Wise";
    ViewBag.PageTitle = "Attendance Approval Department Wise";

    string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
    commonFunctions comfun = new commonFunctions();
}
@{
    int StartYear = Convert.ToInt32(DateTime.Now.Year);
    int StartMonth = Convert.ToInt32(DateTime.Now.Month);
    DateTime oBeginnngOfThisMonth = new DateTime(StartYear, StartMonth, 1);
    int daysInMonth = oBeginnngOfThisMonth.AddMonths(1).AddDays(-1).Day;
    DateTime startDate = new DateTime(StartYear, StartMonth, 1).AddDays(-1);
    string dayName = "";
    DateTime iDate = new DateTime();
    string colName = "";
    string tdId = "";
    string dayTag = "";
    DataTable dtDayTags = comfun.fillDataTable("stpviksatLeaveTypeListShow", "", null);
    DateTime currentMonth = new DateTime(DateTime.Now.Year, DateTime.Now.AddMonths(1).Month, 1).AddDays(-1);
    DateTime oldMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
}
<style>
    .ui-helper-hidden-accessible {
        display: none !important;
    }

    #_salaryAttMonthly {
        max-width: 100%;
        overflow: auto;
    }

    .ddl {
        max-width: 40px;
    }

    .attendanceContainer {
        width: 100%;
        margin: 0px;
    }

    select {
        -webkit-appearance: none;
        -moz-appearance: none;
        text-indent: 1px;
        text-overflow: '';
        border: 0;
        padding: 0px;
        height: auto;
        scrollbar-width: thin;
    }

    #_salaryAttMonthly {
        max-height: 80vh;
        overflow: auto;
        scrollbar-width: thin;
        /*scrollbar-color: #00476a white;*/
    }

    .tdays {
        padding: 0px;
    }

    .tsr {
    }

    .tnames {
        text-transform: capitalize;
        padding-left: 5px !important;
    }

    .tempid {
        padding-left: 5px !important;
    }

    .tul li {
        list-style-type: none;
    }

    .bd-example-modal-lg .modal-dialog {
        display: table;
        position: relative;
        margin: 0 auto;
        top: calc(45% - 24px);
    }

        .bd-example-modal-lg .modal-dialog .modal-content {
            background-color: transparent;
            border: none;
        }

    .table-form td {
        padding: 4px;
    }
</style>

