                                        <input type="button" onclick="filterGlobalClear()" class="btn btn-default " id="filterclear" value="Clear Filters" />*@

                                </td>
                            </tr>
                            @*<tr>
                                    <td></td>
                                    <td>
                                        <input type="button" value="Refresh" onclick="_salaryAttMonthly(1)" class="btn btn-default btnRefresh" />
                                        <input type="button" onclick="showGlobalFilters()" class="btn btn-default" id="filter" value="Filters" />
                                        <input type="button" onclick="filterGlobalClear()" class="btn btn-default" id="filterclear" value="Clear Filters" />

                                    </td>
                                </tr>*@
                        </table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div id="_salaryAttMonthly"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @*<button type="button" class="btn btn-primary" onclick="modal();">Open and close in 3 secs</button>*@

    <div class="modal fade bd-example-modal-lg" role="dialog" id="spinnerModal" data-backdrop="static" data-keyboard="false" tabindex="-1">
