<script>
           var mId = 0;

         var pageSize=@pageSize;
    var sr = 0;

    $(document).ready(function () {
        TableManageDefault.init();

    });

    function Show() {
        var files = $("#ExcelFile").get(0).files;

        var Date = $("#Date").val()
        var formData = new FormData();
        formData.append('ExcelFile', $('input[name=file]')[0].files[0]);
        formData.append("Date", $('#Date').val());


        $.ajax({
            url: '/Timesheet/_ImportFile01',
            data: formData,
            type: 'POST',
            contentType: false,
            processData: false,
            success: function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);


                $.each(obj, function (key, value) {



                    var template1 = '<tr>';

                    template1 += '<td><span class="EmpCode">' + value.Code + '</span></td>';
                    template1 += '<td><span class="Empname">' + value.Empname + '</span></td>';
                    template1 += '<td><span class="Father_Name">' + value.Father_Name + '</span></td>';
                    template1 += '<td><span class="Mother_Name">' + value.Mother_Name + '</span></td>';
                    template1 += '<td><span class="DateOfBirth">' + value.DateOfBirth + '</span></td>';
                    template1 += '<td><span class="DateOfJoining">' + value.DateOfJoining + '</span></td>';
                    template1 += '<td><span class="Desigation">' + value.Desigation + '</span></td>';
                    template1 += '<td><span class="Department">' + value.Department + '</span></td>';
                    template1 += '<td><span class="Depatment_Location">' + value.Depatment_Location + '</span></td>';
                    template1 += '<td><span class="Vendor">' + value.Vendor + '</span></td>';
                    template1 += '<td><span class="Address">' + value.Address + '</span></td>';
                    template1 += '<td><span class="District">' + value.District + '</span></td>';
                    template1 += '<td><span class="Block">' + value.Block + '</span></td>';
                    template1 += '<td><span class="Panchayat_Name">' + value.Panchayat_Name + '</span></td>';
                    template1 += '<td><span class="Postal_Code">' + value.Postal_Code + '</span></td>';
                    template1 += '<td><span class="PAN">' + value.PAN + '</span></td>';
                    template1 += '<td><span class="UAN">' + value.UAN + '</span></td>';
                    template1 += '<td><span class="AADHAR">' + value.AADHAR + '</span></td>';
                    template1 += '<td><span class="Bank">' + value.Bank + '</span></td>';
                    template1 += '<td><span class="IFSC">' + value.IFSC + '</span></td>';
                    template1 += '<td><span class="Account_No">' + value.Account_No + '</span></td>';
                    template1 += '<td><span class="Basic">' + value.Basic + '</span></td>';
                    template1 += '<td><span class="HRA">' + value.HRA + '</span></td>';
                    template1 += '<td><span class="Others">' + value.Others + '</span></td>';
                    template1 += '<td><span class="IsPf">' + value.IsPf + '</span></td>';
                    template1 += '<td><span class="IsEsi">' + value.IsEsi + '</span></td>';
                    template1 += '<td><span class="Charge">' + value.Charge + '</span></td>';
                    template1 += '<td><span class="TA">' + value.TA + '</span></td>';
                    template1 += '<td><span class="SP">' + value.SP + '</span></td>';
                    template1 += '<td><span class="GrossWages">' + value.GrossWages + '</span></td>';
                    template1 += '<td><span class="ESINO">' + value.ESINO + '</span></td>';


                    template1 += '<td><button id="btnRemove"  onclick="RemoveItemlist(this);">Remove</button> </td>';


                    template1 += '</tr>'

                    var oldBody1 = $("#tblExcel > TBODY").html();

                    var tBody1 = $("#tblExcel > TBODY").html(oldBody1 + template1);


                });

            }
        });

    }

    function RemoveItemlist(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        if (confirm("Do you want to delete: " + name)) {
            //Get the reference of the Table.
            var table = $("#tblExcel")[0];

            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        }

    };
      function _Importexcel() {
          window.open('/Timesheet/_EmployeeCtcExcel', "_top");
    }



    function getdata() {
        //Loop through the Table rows and build a JSON array.

        var Table = new Array();
        $("#tblExcel TBODY TR").each(function () {
            var row = $(this);
            var terms = {};

            terms.EmpCode = row.find('.EmpCode').text();
            terms.EmpName = row.find('.Empname').text();
            terms.Father_Name = row.find('.Father_Name').text();
            terms.Mother_Name = row.find('.Mother_Name').text();
            terms.DateOfBirth = row.find('.DateOfBirth').text();
            terms.DateOfJoining = row.find('.DateOfJoining').text();
            terms.Desigation = row.find('.Desigation').text();
            terms.Department = row.find('.Department').text();
            terms.Depatment_Location = row.find('.Depatment_Location').text();
            terms.Vendor = row.find('.Vendor').text();
            terms.Address = row.find('.Address').text();
            terms.District = row.find('.District').text();
            terms.Block = row.find('.Block').text();
            terms.Panchayat_Name = row.find('.Panchayat_Name').text();
            terms.Postal_Code = row.find('.Postal_Code').text();
            terms.PAN = row.find('.PAN').text();
            terms.UAN = row.find('.UAN').text();
            terms.AADHAR = row.find('.AADHAR').text();
            terms.Bank = row.find('.Bank').text();
            terms.IFSC = row.find('.IFSC').text();
            terms.Account_No = row.find('.Account_No').text();
            terms.Basic = row.find('.Basic').text();
            terms.HRA = row.find('.HRA').text();
            terms.Others = row.find('.Others').text();
            terms.IsPf = row.find('.IsPf').text();
            terms.IsEsi = row.find('.IsEsi').text();
            terms.Charge = row.find('.Charge').text();
            terms.TA = row.find('.TA').text();
            terms.SP = row.find('.SP').text();
            terms.GrossWages = row.find('.GrossWages').text();
            terms.ESINO = row.find('.ESINO').text();

            Table.push(terms);

        });

        return Table;
        //Send the JSON array to Controller using AJAX.
    }
    function _Submit() {

        var data = JSON.stringify(getdata());
        var formData = new FormData();
        formData.append("Table", data);

        $.ajax({
            type: "POST",
            url: "/Timesheet/_InsertDetail",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {

                if (data != "[]") {
                    $('.modal-title').html("EmployeeDetail Error List");
                    $('#myModal').modal({
                        show: 'false'
                    });
                    var obj = $.parseJSON(data);
                    var table = $('#myTable').DataTable();
                    table.clear().draw();
                    var sr = 0;
                $.each(obj, function (key, value) {
                        sr = sr + 1;
                        var elmntArray = [
                            sr,
                            value.EmpCode, value.Desigation, value.Designationverify, value.Department, value.Departmentverify, value.Vendor, value.Accountverify, value.District, value.Distirctverify, value.AADHAR, value.AADHARverify
                        ];
                        table.row.add(elmntArray).draw(false);

                    });
                }
                else {
                    alert("data uploaded Successfully!");
                }

            }
        });
    }
</script>

