    function Sum() {
        var total = 0;
        var total1 = 0;
        var total2 = 0;
        var total3 = 0;
        var total4 = 0;
        var total5 = 0;
        $("#tblPurchase TBODY TR").each(function () {
            //var row = $(this);
            var value = parseFloat($(this).find('.Amount').val());
            var value1 = parseFloat($(this).find('.DiscountAmount').val());
            var value2 = parseFloat($(this).find('.IGSTAmount2').val());
            var value3 = parseFloat($(this).find('.CGSTAmount2').val());
            var value4 = parseFloat($(this).find('.SGSTAmount2').val());
            var value5 = parseFloat($(this).find('.NetAmount').val());
            if (!isNaN(value)) {
                total += value;
            }

            if (!isNaN(value1)) {
                total1 += value1;
            }

            if (!isNaN(value3)) {
                total3 += value3;
            }

            if (!isNaN(value4)) {
                total4 += value4;
            }

            if (!isNaN(value5)) {
                total5 += value5;
            }

            if (!isNaN(value2)) {
                total2 += value2;
            }
        });
        $("#txtAmount").val(total.toFixed('2'));
        $("#txtDiscountAmount").val(total1.toFixed('2'));
        $("#txtIGST").val(total2.toFixed('2'));
        $("#txtCGST").val(total3.toFixed('2'));
        $("#txtSGST").val(total4.toFixed('2'));
        $("#txtTotalAmount").val(total5.toFixed('2'));
        //$("#txtTotalAmount").val(total5.toFixed('2'));
    }

