                                    <select id="ddlChild" class="clearddl" placeholder="">
                                        <option value="0">---Select ---</option>
                                    </select>

                                </div>
                                <div>
                                    <textarea placeholder="Enter Billing Address here..." id="BillingAddress" class="form-control cleartxt" style="width: 90%; height: 27px;"></textarea>

                                </div>
                            </div>
                            <div class="col-md-2 col-sm-2 col-lg-2">
                                <div class="font">
                                    Deployment  Date
                                </div>
                                <div>
                                    <input type="text" data-date-format="d-M-yyyy" value="@DateTime.Now.ToString("d-MMM-yyyy")" class="datepicker datepickertxt form-control readonly" name="BillDate" id="BillDate" readonly="readonly" />
                                </div>
                            </div>

                            <div class="col-md-2 col-sm-2 col-lg-2">
                                <div class="font">

                                    <label class="checkbox-inline font">
                                        <input type="checkbox" id="IsActive" value="" style="margin-top:23px; margin-left:31px" onclick="showAgency()"> Agency Preference?
                                    </label>

                                </div>

                            </div>
                            <div class="col-md-2 col-sm-2 col-lg-2">
                                <div id="agency" hidden>
                                    <div class="font">
                                        Selected Agency <font color="red">*</font>
                                    </div>
                                    <div>
                                        <select id="ddlAgency" class="clearddl" placeholder="">
                                            <option value="0">---Select ---</option>

                                        </select>

                                    </div>
                                </div>

                            </div>

                        </div>


                        <br />
