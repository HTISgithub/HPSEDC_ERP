    function RenummerationCost1() {
        var IsEsi = $('#IsEsi').is(':checked') ? 'Y' : 'N'; // ESIAmt toggle
        var IsPf = $('#IsPf').is(':checked') ? 'Y' : 'N'; // EPFAmt toggle
        var BasicAmount = parseFloat($('#BasicSalary').val()) || 0;

        var SpecialAllowance = parseFloat($('#SpecialAllowance').val()) || 0;
        var liblyAllowance = parseFloat($('#liblyAllowance').val()) || 0;
        var Medical = parseFloat($('#Medical').val()) || 0;
        var HRA = parseFloat($('#HRA').val()) || 0;
        var Tribalallwoance = parseFloat($('#Tribalallwoance').val()) || 0;
        var TribalAreaallwoance = parseFloat($('#TribalAreaallwoance').val()) || 0;
        var ReliverCharges = parseFloat($('#ReliverCharges').val()) || 0;
        var DressCharge = parseFloat($('#DressCharge').val()) || 0;
        var OtherAllowance = parseFloat($('#OtherAllowance').val()) || 0;

        // EPF calculation: Apply 13% only up to ₹15,000
        var EPFAmt = BasicAmount > 15000 ? 15000 * 13 / 100 : BasicAmount * 13 / 100;
        $('#EPFAmt').val(EPFAmt.toFixed(2));

        // ESI calculation: Apply 3.25% only up to ₹21,000
        var ESIAmt = BasicAmount > 21000 ? 21000 * 3.25 / 100 : BasicAmount * 3.25 / 100;
        $('#ESIAmt').val(ESIAmt.toFixed(2));

        // Total Charge Amount
        var ChargeAmount = BasicAmount + EPFAmt + ESIAmt;
        $('#ChargeAmount').val(ChargeAmount.toFixed(2));

        // Hpsedc Charge (5% of Charge Amount)
        var HpsedcCharge = ChargeAmount * 5 / 100;
        $('#HpsedcCharge').val(HpsedcCharge.toFixed(2));

        // Total Amount
        var TotalAmt = ChargeAmount + HpsedcCharge + SpecialAllowance + liblyAllowance + Medical + HRA + Tribalallwoance + TribalAreaallwoance + ReliverCharges + DressCharge + OtherAllowance;
        $('#TotalAmt').val(TotalAmt.toFixed(2));

        // GST (18% of Taxable Amount)
        var GST = TotalAmt * 18 / 100;
        $('#GST').val(GST.toFixed(2));

        // Grand Total
        var GrandTotal = TotalAmt + GST;
        $('#GrandTotal').val(GrandTotal.toFixed(2));

        // Net Take Home
        var EPFAmt1 = BasicAmount > 15000 ? 15000 * 12 / 100 : BasicAmount * 12 / 100;
        var ESIAmt1 = BasicAmount > 21000 ? 21000 * 0.75 / 100 : BasicAmount * 0.75 / 100;
        var kum = EPFAmt1 + ESIAmt1;
        var netTakeHome = BasicAmount - kum;
        $('#Nettakehome').val(netTakeHome.toFixed(2));
    }


