                                    <select id="ddlParent" onchange="_ChildOfficeddl();" placeholder="">
                                        <option value="0">---Select ---</option>

                                    </select>
                                </div>
                                <div>
                                    <textarea placeholder="Enter HQ Address here..." id="ddlParentText" class="form-control cleartxt" style="width: 90%; height: 27px;"></textarea>
                                </div>
                            </div>
