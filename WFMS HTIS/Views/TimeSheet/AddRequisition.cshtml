                                                            <tr>
                                                                <th style="color: #0f1875; background-color: #d6f5fc " class="font">Designation <span class="error-message">*</span> </th>
                                                                <th style="color: #0f1875; background-color: #d6f5fc " class="font">Type <span class="error-message">*</span></th>
                                                                <th style="color: #0f1875; background-color: #d6f5fc " class="font">Tenure of Deployment. <span class="error-message">*</span></th>
                                                                @*<th style="color: #0f1875; background-color: #d6f5fc " class="font">Basic Salary [Min. Wage per Resource]. <span class="error-message">*</span></th>
                                                                    <th style="color: #0f1875; background-color: #d6f5fc " class="font">Cost to Department [per Resource] <span class="error-message">*</span></th>*@
                                                                <th style="color: #0f1875; background-color: #d6f5fc;  width: 5%; " class="font">No. of Resource(s) <span class="error-message">*</span></th>

                                                                <th style="color: #0f1875; background-color: #d6f5fc; width: 10%; ">Action</th>
                                                                <th id="itemid" class="hide"></th>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <input type="text" id="ResourceId" value="0" placeholder="Designation">
                                                                    <input type="text" id="Resource" class="form-control" placeholder="Search Designation">

                                                                </td>
                                                                <td>
                                                                    <select id="ResourceType">
                                                                        <option value="0" style="text-align:center">Select Job Type</option>
                                                                        <option value="1">Full-Timer</option>
                                                                        <option value="2">Part-Timer</option>

                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select id="Tenure">
                                                                        <option value="0" style="text-align:center">Select Tenure</option>
                                                                        <option value="1">6 Months</option>
                                                                        <option value="2">12 Months</option>
                                                                        <option value="3">Till further Order</option>
                                                                        <option value="3">Other</option>

                                                                    </select>
                                                                </td>
                                                                @*<td>
                                                                        <input type="text" id="BasicAmount" placeholder="0" class="form-control cleartxt tblcler " style="text-align:right;" />
                                                                        <span id="error" class="error"></span>
                                                                    </td>

                                                                    <td>
                                                                        <input type="text" id="DeptCost" placeholder="0" class="form-control cleartxt tblcler " style="text-align:right;" />
                                                                        <span id="error2" class="error"></span>
                                                                    </td>*@
                                                                <td>
                                                                    <input type="text" id="ResourceNo" placeholder="0" class="form-control cleartxt tblcler " style="text-align:right;" />
                                                                    <span id="error" class="error"></span>
                                                                </td>
                                                                <td>
                                                                    <input type="button" class="btn btn-primary pull-right" @*class="addmore btn-success"*@ id="btnAdd" onclick="Add()" value="ADD" style="width:60px; margin-right:15px;" />
                                                                </td>
                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                    </table>
                                                </div>
                                            </div>



                                            <div class="col-md-4">
                                                <div class="font">Upload Requisition Document<span class="error-message">*</span></div>
                                                <div>
                                                    <input type="file" name="file" id="DeparmentOrderDocument" multiple="" required />
                                                </div>

                                            </div>


                                            <div class="col-md-4" style="display:none">
                                                <div class="font">Select Requisition Type<span class="error-message">*</span></div>
                                                <div>
                                                    <select name="RequisitionType" id="RequisitionType">
                                                        <option value="0">select</option>
                                                        <option value="1">New</option>
                                                        <option value="2">Old</option>
                                                        <option value="3">Replacement</option>
                                                        <option value="4">Renewal/Extension</option>
                                                    </select>
                                                </div>

                                            </div>


                                            <div class="col-md-4" style="margin-left:46rem;">
                                                <table align="right" class="font" style="margin:5px;background-color: #d6f5fc; color: #0f1875; height:70px;border-radius:10px;">
                                                    <tbody>
                                                        <tr id="totals">
                                                            <td>Total Resources</td>
                                                            <td><input type="text" id="txtTotalResource" value="0" readonly style=" margin: 13px; border-radius: 10px; width: 13rem;" /></td>
                                                        </tr>

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-md-offset-5">
                            @if (Request.Cookies["RoleId"].Value == "18")
                            {
                                <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" style="width: 80px" />
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*Financial*@
<div class="modal fade" id="myModal1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #d6f5fc; color: #0f1875; font-size: 28px; ">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title jost"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
