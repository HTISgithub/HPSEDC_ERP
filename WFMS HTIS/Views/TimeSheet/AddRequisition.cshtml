<h1 class="jost" style=" color: #0f1875;text-align:center;font-size:30px;margin-bottom:1rem;">@ViewBag.Title</h1>
<div class="page-content">
    <div class="page-content divborder">
        <div class="button-container">
            <input type="button" style="font-size:14px" class="btn btn-primary tablinks" id="btnVendor" onclick="opentab(event, 'Entry')" value="New Requisition" />
            <input type="button" style="font-size:14px" class="btn btn-primary tablinks" id="btnList" onclick="opentab(event, 'List')" value="List" />
            <input type="button" style="font-size:14px" class="btn btn-primary tablinks" id="btnVendor1" onclick="redirectToOldRequisition()" value="OLD Requisition" />


        </div>
        <div class="row form-group">
            <div id="List" class="tabcontent">
                <div class="row">
                    <div class="col-xs-12">
