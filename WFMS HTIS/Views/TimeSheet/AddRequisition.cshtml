    function toggleTextbox(textboxId, nextCheckboxId) {
        var textbox = document.getElementById(textboxId);

        // Check if textbox is visible
        if (textbox.style.display === "none") {
            textbox.style.display = "block"; // Show the textbox
            textbox.value = 0; // Set default value to 0 when shown
        } else {
            if (textbox.value === "") {
                alert("Please enter the amount before proceeding to the next field.");
            } else {
                textbox.style.display = "none"; // Hide the textbox if valid amount is entered
                if (nextCheckboxId) {
                    document.getElementById(nextCheckboxId).disabled = false; // Enable next checkbox if amount is valid
                }
            }
        }
    }

