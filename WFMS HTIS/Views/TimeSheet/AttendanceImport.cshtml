            }

           var fromdate = '01-' + $('#ddlMonth option:selected').text() + '-' + $('#ddlYear').val();
            var method = 'ImportExcel';
            var FromDate = fromdate;
            var ToDate =fromdate;
            var EmpId = $('#EmpId').val();
            var BranchId = $('#BranchId').val();
            var DepartmentId = $('#CustomerId').val();


            var DesignationId = $('#DesignationId').val();
            var qs = '?method=' + method;
            if (FromDate != '') {
                qs += '&FromDate=' + FromDate;
            }
            if (ToDate != '') {
                qs += '&ToDate=' + ToDate;
            }


            if (parseInt(EmpId) > 0) {
                qs += '&EmpId=' + EmpId;
            }
            if (parseInt(BranchId) > 0) {
                qs += '&BranchId=' + BranchId;
            }
            if (parseInt(DepartmentId) > 0) {
                qs += '&DepartmentId=' + DepartmentId;
            }
