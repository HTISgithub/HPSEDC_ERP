                                    <label class="col-md-4 control-label">Customer/Vendor </label>
                                    <div class="col-md-6">
                                        <input type="text" id="CustomerId" value="0" class="form-control hidden" placeholder="Department">
                                        <input type="text" id="Customer" class="form-control" placeholder="Customer/Vendor">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-md-4 control-label">Designation </label>
                                    <div class="col-md-6">
                                        <input type="text" id="DesignationId" value="0" class="form-control hidden" placeholder="Designation">
                                        <input type="text" id="Designation" class="form-control" placeholder="Designation">
                                    </div>
                                </div>
                            </div>

                        </div>
