        function _Importexcel() {

            if ($('#EmpName').val().trim() == '') {
                $('#EmpId').val(0);
            }

            if ($('#Branch').val().trim() == '') {
                $('#BranchId').val(0);
            }
            if ($('#Customer').val().trim() == '') {
                $('#CustomerId').val(0);
            }
            if ($('#Designation').val().trim() == '') {
