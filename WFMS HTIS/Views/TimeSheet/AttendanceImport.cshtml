}
<style>
    .fileinput-button {
        position: relative;
        overflow: hidden;
    }
        /*Also*/
        .fileinput-button input {
            position: absolute;
            top: 0;
            right: 0;
            margin: 0;
            opacity: 0;
            -ms-filter: 'alpha(opacity=0)';
            font-size: 200px;
            direction: ltr;
            cursor: pointer;
        }
</style>
@******************Breadcrumb Start**************@
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Reports</a>
        </li>
        <li>
            <a href="#">Daily Reports</a>
        </li>
        <li class="active">@ViewBag.PageTitle</li>
    </ul><!-- /.breadcrumb -->

</div>
@******************Breadcrumb End**************@


