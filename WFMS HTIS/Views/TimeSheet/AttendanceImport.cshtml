        function AddData() {
            var data = [];
            $("#Attendance TBODY TR").each(function () {
                var row = $(this);
                var Attendance = {};
                Attendance.EmpId = row.find(".EmpId").text();
                Attendance.PresentDays = row.find(".PresentDays").val();
                Attendance.AbsentDays = row.find(".AbsentDays").val();
                Attendance.LeaveDays = row.find(".LeaveDays").val();
                Attendance.OTDays = row.find(".OTTime").val();
                Attendance.Weekoff = row.find(".Weekoff").val();
                Attendance.Holidays = row.find(".Holidays").val();
                Attendance.Days = row.find(".Days").text();

                data.push(Attendance);

                //EmpId, PresentDays, OTDays, Days



            });
            // alert(data);
            return data;
        }
