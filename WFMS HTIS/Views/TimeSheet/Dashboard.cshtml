<style>
    #loading {
        position: fixed;
        display: block;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        text-align: center;
        opacity: 0.7;
        background-color: #fff;
        z-index: 99;
    }

    .dashboard-body {
        background-color: white;
    }

    #loading-image {
        width: 100px;
        left: 0%;
        position: relative;
        top: 50%;
    }

    .dashbox {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        border: solid 1px #c8dced;
        min-height: 250px;
        margin-bottom: 15px;
        box-shadow: none !important;
        transition: transform 0.3s ease;
        cursor: pointer;
    }

    .boxtitle {
        font-family: "Raleway", sans-serif;
    }

    .dashbox:hover {
        transform: scale(1.05);
    }
</style>

<div style="background-color: white;">
    <div class="page-content dashboard-body" style="background-color:white; margin-top:4rem; box-shadow:none">
        <div class="row" style="margin-top: -3px;" id="Module">

            @foreach (DataRow dr in Model.Rows)
            {
                // Retrieve the module-specific image
                var iconSrc = dr["Icon"].ToString(); // Assuming 'Icon' column holds the image URL

        <div class="col-md-3" onclick="OpenGenerateModel('@dr["ModuleId"]')">
            <div class="widget-box dashbox pie-attendance" style="background-color: #d6f5fc;">
                <div class="widget-body" style="background-color: #d6f5fc">
                    <div class="widget-main">
                        <div class="row">
                            <h4 class="boxtitle" style="margin-left: 76px; margin-top: -5px; color: #0f1875">
                                @dr["ModuleName"]
                            </h4>

                            <div class="col-md-4">
                                <!-- Display the image specific to this row -->
                                <img src="~/DashboardLogo/@iconSrc" style="width:80px;margin-top: -38px;margin-left: -21px;" />
                            </div>

                            <div class="col-md-4" style="font-size: 37px; text-align:center;">
                                <label id="Total" style="font-size: 37px;font-weight:bold;color:#00476a" onclick=""></label>
                            </div>
                        </div>
                    </div><!-- /.widget-main -->
                </div><!-- /.widget-body -->
            </div>
  
        </div>
        }

        </div>
    </div>

</div>
}
<script src="~/Scripts/autocomplete.js"></script>
<script>
    function OpenGenerateModel(id) {
        var tt = '';

        $('#ProgressImg').show();
        $.post('/TimeSheet/DashboardList', {
            'ModuleId': id,

        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var msr = 0;
            var SubMenuName = '';
            $.each(obj, function (key, value) {
                if (value.IsLink == 'Y') { window.location.href = value.link; }
                else {
                    SubMenuName += '\
                         <div class="col-md-3" > \
                         <div class="widget-box dashbox pie-attendance">\
                               <div class="widget-body" onclick="OpenGenerateModel('+ value.ModuleId + ')">\
                                 <div class="widget-main">\
                                        <div class="row">\
                                            <h4 class="boxtitle" style="margin-left: 76px;margin-top:-5px" ">' + value.ModuleName + '</h4>\
                                            <div class="col-md-4">\
                                                <img src="/images/today.png" style="width:80px;margin-top: -38px;margin-left: -21px;" onclick="" />\
                                            </div>\
                                            <div class="col-md-4" style="font-size: 37px; text-align:center;">\
                                                <label id="Total" style="font-size: 37px;font-weight:bold;color:#00476a" onclick=""></label>\
                                            </div>\
                                        </div>\
                                    </div>\
                                </div>\
                            </div>\
                        </div> ';
                }
                //window.location.href = value.link;

            });
            $('#Module').html(SubMenuName);
        });
    }


</script>
