@{
    int StartYear = Convert.ToInt32(DateTime.Now.Year);
    int StartMonth = Convert.ToInt32(DateTime.Now.Month);
    DateTime oBeginnngOfThisMonth = new DateTime(StartYear, StartMonth, 1);
    int daysInMonth = oBeginnngOfThisMonth.AddMonths(1).AddDays(-1).Day;
    DateTime startDate = new DateTime(StartYear, StartMonth, 1).AddDays(-1);
    string dayName = "";
    DateTime iDate = new DateTime();
    string colName = "";
    string tdId = "";
    string dayTag = "";
    DataTable dtDayTags = comfun.fillDataTable("stpviksatLeaveTypeListShow", "", null);
    DateTime currentMonth = new DateTime(DateTime.Now.Year, DateTime.Now.AddMonths(1).Month, 1).AddDays(-1);
    DateTime oldMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);


}

