<script src="~/Scripts/autocomplete.js"></script>
<script>
    $(document).ready(function () {
        autoTextReport('EmployeeName', 'EmployeeId', '/autoComplete/_autoSearch/', 'EmpId', 'EmpName', 'EmpCode', 'Employee');
    });
    _Branch();
    _Status();
    _Department();
      PayDaysfreeze() ;
    $('.select2').select2();
     $(".All").click(function () {
        $(".chk_").prop('checked', $(this).prop('checked'));
     });
      $('.datepicker').datepicker(
   {
       format: "M-yyyy",
       viewMode: "months",
       minViewMode: "months"
   });
    $('.datepicker').on('changeDate', function (e) {
        $(this).datepicker('hide');
        var date = new Date(e.date);
        //$('.errorDiv').html(date.getMonth()+1).show();
        $('#Month').val(date.getMonth() + 1);
    });
    function _Status() {


        $('#ModalProgress').show();
        $.post('/TimeSheet/_AttendanceStatusddl', {
        }, function (data) {
            $('#ModalProgress').hide();
            var StatusId = '<option value="0">--All--</option>';
            var obj = $.parseJSON(data);
            $('#notinotavialable').hide();
            $.each(obj, function (key, value) {
                StatusId += '<option value=' + value.StatusId + '>' + value.StatusName + '</option>';
            });
            $('#StatusId').html(StatusId);

        });
    }


    function _Branch() {


        $('#ModalProgress').show();
        $.post('/TimeSheet/_helpdeskGroupMappingBranch', {
        }, function (data) {
            $('#ModalProgress').hide();
            var branchId = '<option value="0">--Select Funnel--</option>';
            var obj = $.parseJSON(data);
            $('#notinotavialable').hide();
            $.each(obj, function (key, value) {
                branchId += '<option value=' + value.BranchId + '>' + value.BranchName + '</option>';
            });
            $('#funnelId').html(branchId);

        });
    }
    function _Department() {
        $('#ModalProgress').show();
        $.post('/TimeSheet/_Department', {
        }, function (data) {
            $('#ModalProgress').hide();
            var department = '<option value="0">--Select Scrum--</option>';
            var obj = $.parseJSON(data);
            $('#notinotavialable').hide();
            $.each(obj, function (key, value) {
                department += '<option value=' + value.DepartmentID + '>' + value.DepartmentName + '</option>';
            });
            $('#ScrumId').html(department);
        });
    }
    var accessRights = {@ViewData["AccessRights"]};
    function showModalProgress() {
        $('.modal').modal('show');
    }
    function hideModalProgress() {
        $('.modal').modal('hide');
    }
    $('.datepicker').datepicker()
    $('.datepicker').on('changeDate', function (ev) {
        $(this).datepicker('hide');

    });

     function PayDaysfreeze() {


       //  alert(dateval);
             $('#ProgressImg').show();
                    $("#tblLeaveList > TBODY").html('');
                    $.post('/TimeSheet/_TimeSheetApproval', {
                        'FromDate': $('#FromDate').val(),
                        'ToDate':$('#ToDate').val(),
                         //'funnelId': $('#funnelId').val(),
                        'ScrumId': $('#ScrumId').val(),
                        'EmployeeID': $('#EmployeeId').val(),
                        'StatusId': $('#StatusId').val(),
                    }, function (data) {
                            $('#ProgressImg').hide();
                            if (data.length <= 0)
                            {

                                $("#tblLeaveList").html('Record Not Found');
                                return;
                            }
                        var obj = $.parseJSON(data);

                        //table4.clear().draw();

                            $.each(obj, function (key, value) {
                                var EmpId = value.EmpID
                                var Empcode = value.EmployeeCode;
                 var EmpName = value.EmployeeName;
                // var Funnel = value.Funnel;
                // var Scrum = value.Scrum;
                 //var Designation = value.Designation;
                 var Doj = value.DOJ;
                 var PP= value.PP;
                 var AA = value.AA;
                 var WW = value.WW;
                 var HH = value.HH;
                 var PayDays = value.PayDays;
                               // var AStatus = value.AStatus;
                 //Get the reference of the Table's TBODY element.



                 var hiddenIds1 = '<div style="display:none"><span class="Id">' + EmpId + '</span>';

                 hiddenIds1 += '</div>';
                 var template1 = '<tr  class="trEmpData">';
                 template1 += '<td class="EmpCode">' + Empcode + '</td>';
                 template1 += '<td><span class="EmpName">' + EmpName + '</span></td>';
                 //template1 += '<td><span class="Funnel">' + Funnel + '</span></td>';
                 //template1 += '<td><span class="Scrum">' + Scrum + '</span></td>';
                 //template1 += '<td><span class="Designation">' + Designation + '</span></td>';
                                template1 += '<td><span class="Doj">' + Doj + '</span></td>';
                                 template1 += '<td><span class="PP">' + PP + '</span></td>';
                 template1 += '<td><span class="AA">' + AA + '</span></td>';
                 template1 += '<td><span class="WW">' + WW + '</span></td>';
                 template1 += '<td><span class="HH">' + HH + '</span></td>';
                                template1 += '<td><span class="NoofDays">' + PayDays + '</span></td>';

                                //template1 += '<td><span class="AStatus">' + AStatus + '</span></td>';
                                template1 += '<td><input type="checkbox" Id="chk_' + EmpId + '" class="chk_"/></td>';
                                 template1 += '<td hidden="hidden"><span class="chk_EmpId">' + EmpId + '</span></td>';
                                template1 += '</tr>'

                 var oldBody1 = $("#tblLeaveList>TBODY").html();
                 var tBody1 = $("#tblLeaveList > TBODY").html(oldBody1 + template1);

                        });
                    });
    }
    function getAllData() {
            var data = [];
            $('.trEmpData').each(function () {
                    //var id = $(this).attr("id");
                var empId = $(this).find('.chk_EmpId').text();
                var chk = $(this).find('.chk_');
                  var PayDays = $(this).find('.NoofDays').text();
                var alldata = {
                    'EmpId': empId,
                    'NoofDays': PayDays
                }

                if ($(chk).prop("checked")) {
                    data.push(alldata);
                }
            });
        console.log(data);//

            return data;
    }
    function AttendanceApproval() {

        var fdata = JSON.stringify(getAllData());
        alert(fdata);
        if (fdata.length < 3) {
            alert('Error: Please select Employees');
            return;
        }

        var FromDate = $('#FromDate').val();

        $('#ProgressImg').show();
        $.post('/TimeSheet/_AttendanceApprovalSubmit', {
            'FreezeEmpIds': fdata,
            'FromDate': FromDate,

        }, function (data) {
            alert(data);
            $('#ProgressImg').hide();
        });

    }

    $('#EmployeeName').bind('autocompleteselect', function (event, ui) {
        if (ui.item) {
            $(".EmployeeIdGlobal").val(ui.item.value);
            $(".EmployeeNameGlobal").val(ui.item.label);
            $("#CategoryIdGlobal").val('');
            $("#DesignationIdGlobal").val('');
            $("#GradeIdGlobal").val('');
            $("#CompanyIdGlobal").val('');
            $("#LocationIdGlobal").val('');
            $("#DivisionIdGlobal").val('');
            $("#DepartmentIdGlobal").val('');
            $("#CostCenterIdGlobal").val('');
            $("#ReportingManagerIdGlobal").val('');
            $("#StatusIdGlobal").val('');
            PayDaysfreeze();
        }
    });

    function applyGlobalFilters() {
        hideGlobalFilters('_TimeAttMonthly()', 200);
    }
    $(".EmployeeIdGlobal").val('0');
    $('#EmployeeName').val('');



</script>
