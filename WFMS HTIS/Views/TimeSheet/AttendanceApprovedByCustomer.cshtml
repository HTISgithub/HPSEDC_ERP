            'ToDate': $('#ToDate').val(),
        }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            // var table4 = $('#Contact').DataTable();
            //table4.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                msr = msr + 1;

                var hiddenIds = '<div style="display:none"><span class="Id">' + value.ID + '</span>';

                hiddenIds += '</div>';
                var template2 = '<tr>';
                template2 += '<td style="display:none"><input type="text" value="' + msr + '" class="txtSr" />';
                template2 += '<td style="display:none"><input type="text" value="' + value.ID + '" class="EmpId" />';
                template2 += '<td style="display:none"><input type="text" value="' + value.CertificateId + '" class="CertificateId" />';

                template2 += '<td><span class="SNo">' + msr + '</span></td>';
                template2 += '<td><span class="EmpCode">' + value.EmpCode + '</span></td>';

