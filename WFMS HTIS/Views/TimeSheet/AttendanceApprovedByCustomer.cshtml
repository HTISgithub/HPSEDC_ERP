                template2 += '<td><span class="Designation">' + value.Designation + '</span></td>';

                template2 += '<td><span class="Department">' + value.Department + '</span></td>';
                template2 += '<td><span class="PayDays">' + value.PayDays + '</span></td>';

                template2 += '<td style="align:center;"><input type=checkbox id="chkProduct_' + msr + '" class="chkProduct" value=' + value.ID + '"></></td>'





                template2 += '</tr>'



                var oldBody2 = $("#tblDepartmentApproval > TBODY").html();

                var tBody2 = $("#tblDepartmentApproval > TBODY").html(oldBody2 + template2);



            });
            $('.show1').show();
