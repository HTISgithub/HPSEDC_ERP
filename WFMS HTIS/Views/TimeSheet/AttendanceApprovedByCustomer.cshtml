    function getdata() {
        var data = [];
        $("#tblDepartmentApproval TBODY TR").each(function () {

            var EmpId = $(this).find('.EmpId').val();
            var sr = $(this).find('.txtSr').val();
            var CertificateId = $(this).find('.CertificateId').val();
            var PayDays = $(this).find('.PayDays').text();


            var alldata = {
                'EmpId': EmpId,
                //'CertificateId': CertificateId,
                'PayDays': PayDays,

                //'Remarks':remarks
            }
            if ($('#chkProduct_' + sr + ':checkbox:checked').length > 0) {
                data.push(alldata);
            }


        });

        return data;
    }

    function GenerateCertificate() {


        var data = JSON.stringify(getdata());

        if (data.length < 3) {
            alert('Please Enter Employee List');
            return;
        }










        $.ajax({
            type: 'POST',
            url: '/TimeSheet/_AttendanceApprovalBillContractorSubmit',


            data: JSON.stringify({
                'BillDetail': data,

                'FromDate': $('#FromDate').val(),

                'Id': mId,


            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",


            success: function (r) {
                if (r.indexOf('Error') > -1) {
                    $('.modelalert').html(data);
                }
                else {
                    // var table = $('#update-Country').DataTable();

                    //   var elmntCollection = createTblColmnBtns();

                    if (parseInt(mId) > 0) {
                        $('.modelalert').html(r).delay(1000).queue(function () {
                            $('.modelalert').dequeue();
                            $('#update-Country').modal('toggle');
                        });
                        //table.row(tableRow).r(elmntCollection).draw(false);

                    }
                    else {
                        // sr = table.rows().count() + 1;
                        // console.log('sr=' + sr);
                        $('.modelalert').html(r).delay(1000).queue(function () {
                            $('.modelalert').dequeue();
                            $('#update-Country').modal('toggle');

                            // fillPONo();
                            //  AddPerson();
                        });
                    }
                }
                $('.btnModalSubmit1').removeAttr("disabled");
                $('#ModalProgress').hide();
                View();


            }
        });


    }


