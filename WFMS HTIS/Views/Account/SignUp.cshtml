        background-color: #d9edfe;
    }

    .control-label, .login-heading h3 {
        color: #333;
    }

    .login-heading h3 {
        margin-top: 25px;
    }

    .control-label {
        margin-bottom: 5px;
    }

    .loginpage {
        min-height: 450px;
        margin-top: 40px;
        margin-bottom: 40px;
    }

    .panel {
        border-radius: 10px;
    }

    .site-footer {
        position: absolute;
        width: 100%;
        bottom: 0px;
    }

    #loginForm {
        background-color: #fff;
        padding: 10px 15px;
        border-radius: 7px;
    }

    .btn100 {
        width: 100% !important;
        background-color: #ee7928 !important;
    }

    .terms {
        color: #ee7928;
    }

    .selectdiv {
        position: relative;
        /*Don't really need this just for demo styling*/
        float: left;
        width: 100%;
    }

        .selectdiv label {
            display: inherit !important;
        }
    /* IE11 hide native button (thanks Matt!) */
    select::-ms-expand {
        display: none;
    }

    .selectdiv:after {
        content: '<>';
        font: 17px "Consolas", monospace;
        color: #333;
        -webkit-transform: rotate(90deg);
        -moz-transform: rotate(90deg);
        -ms-transform: rotate(90deg);
        transform: rotate(90deg);
        right: 10px;
        /*Adjust for position however you want*/
        top: 7px;
        padding: 0 0px 5px 0px;
        border-bottom: 1px solid #999;
        /*left line */
        position: absolute;
        pointer-events: none;
    }

    .selectdiv select {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        /* Add some styling */
        display: block;
        width: 100%;
        max-width: 320px;
        height: calc(1.5em + .75rem + 2px);
        float: right;
        padding: 0px 44px 0px 5px;
        font-size: 16px;
        line-height: 1.75;
        color: #333;
        background-color: #ffffff;
        background-image: none;
        border: 1px solid #cccccc;
        -ms-word-break: normal;
        word-break: normal;
    }
</style>
<div class="container-fluid loginbg">
    <div class="container">
        <div class="loginpage">
            <div class="row">
                <div class="col-md-6"></div>
                <div class="col-md-6 col-md-offset-6 col-xs-12 ">
                    <section id="loginForm">
                        @using (Html.BeginForm("AddWeb", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form", role = "form", id = "signupform" }))
                        {
                            <div class="panel">
                                <div class="panel-heading login-heading">
                                    <h3>Sign Up</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="form-group row">
                                        <div class="col-md-6">
                                            <label>First Name</label>
                                            <input type="text" class="form-control AlphabetsOnly" name="FirstName" id="FirstName" required maxlength="50"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label>Last Name</label>
                                            <input type="text" class="form-control AlphabetsOnly" name="LastName" id="LastName" required maxlength="50"/>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-6">
                                            <label>Work Email</label>
                                            <input type="text" class="form-control" name="Email" id="Email" required maxlength="50"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label>Job Title</label>
                                            <div class="selectdiv">
                                                <label>
                                                    <select name="JobTitle" id="JobTitle">
                                                        <option selected value=""> Select Job Title</option>
                                                        <option>Option 1</option>
                                                        <option>Option 2</option>
                                                        <option>Last long option</option>
                                                    </select>
                                                </label>
                                            </div>


                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-6">
                                            <label>Company Name</label>
                                            <input type="text" class="form-control" name="CompanyName" id="CompanyName" maxlength="100"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label>No of Employees</label>
                                            <div class="selectdiv">
                                                <label>
                                                    <select name="NoOfEmployees" id="NoOfEmployees">
                                                        <option selected value=""> Select No of Employees</option>
                                                        <option value='50'>Option 1</option>
                                                        <option value='100'>Option 2</option>
                                                        <option value='500'>Last long option</option>
                                                    </select>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-6">
                                            <label>Phone</label>
                                            <input type="text" class="form-control" name="Phone" id="Phone" required maxlength="20"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label>Country</label>
                                            <div class="selectdiv">
                                                <label>
                                                    <select name="Country" id="Country">
                                                        <option selected value=""> Select Country</option>
                                                        <option value="1">India</option>

                                                    </select>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label>Domain</label>
                                            <div class="input-group mb-3">
                                                <input type="text" class="form-control AlphabetsOnly" name="Domain" id="Domain" maxlength="30" placeholder="Domain" aria-label="Domain" aria-describedby="basic-addon2" required>
                                                <div class="input-group-append">
                                                    <span class="input-group-text" id="basic-addon2">htistelecom.in</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="chkTerms" id="chkTerms">
                                                <label class="form-check-label" for="defaultCheck1">
                                                    <span id="chkspan">I agree to the </span><a href="#" class="terms">Terms and conditions</a>&nbsp;<svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-info-circle" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
    <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
    <path d="M8.93 6.588l-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588z" />
    <circle cx="8" cy="4.5" r="1" />
</svg>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <input type="submit" name="btnSubmit" id="btnSubmit" style="display:none" />
                                        <a class="maxbutton-2 maxbutton maxbutton-button2 asubmitLogin btn100" href="javascript:;"><span class="mb-text">Sign Up</span></a>
                                    </div>
                                    <div class="form-group clear text-center">
                                        @*<a href="javascript:;" onclick="forgetPassword()" class="pull-right">Forgot Password?</a>&nbsp;&nbsp;*@
                                        Aready have an account? <a href="/account/login" class="">Login</a>
                                    </div>
                                </div>
                            </div>
                            if (ViewData["error"] != null)
                            {
                                if (ViewData["error"].ToString() != "")
                                {
                                    <script>
                                            alert('@ViewData["error"]');
                                    </script>
                                }
                            }
                        }
                    </section>
                </div>

            </div>
        </div>

    </div>

</div>
<script>
    $('.AlphabetsOnly').keypress(function (e) {
        var regex = new RegExp(/^[a-zA-Z\s]+$/);
        var str = String.fromCharCode(!e.charCode ? e.which : e.charCode);
        if (regex.test(str)) {
            return true;
        }
        else {
            e.preventDefault();
            return false;
        }
    });
    $('input').keyup(function () {
        console.log('test');
        $(this).removeClass('error');
    });
    $('select').change(function () {
        $(this).removeClass('error');
    });
    $('.asubmitLogin').click(function () {
        //$('#btnSubmit').trigger('click');
        
        if ($('#FirstName').val().trim() == '') {
            $('#FirstName').addClass('error');
            return;
        }
        else {
            $('#FirstName').removeClass('error');
        }
        if ($('#LastName').val().trim() == '') {
            $('#LastName').addClass('error');
            return;
        }
        else {
            $('#LastName').removeClass('error');
        }
        if ($('#Email').val().trim() == '') {
            $('#Email').addClass('error');
            return;
        }
        else {
            $('#Email').removeClass('error');
        }
        if ($('#JobTitle').val().trim() == '') {
            $('#JobTitle').addClass('error');
            return;
        }
        else {
            $('#JobTitle').removeClass('error');
        }

        if ($('#CompanyName').val().trim() == '') {
            $('#CompanyName').addClass('error');
            return;
        }
        else {
            $('#CompanyName').removeClass('error');
        }
        if ($('#NoOfEmployees').val().trim() == '') {
            $('#NoOfEmployees').addClass('error');
            return;
        }
        else {
            $('#NoOfEmployees').removeClass('error');
        }
        if ($('#Phone').val().trim() == '') {
            $('#Phone').addClass('error');
            return;
        }
        else {
            $('#Phone').removeClass('error');
        }
        if ($('#Country').val().trim() == '') {
            $('#Country').addClass('error');
            return;
        }
        else {
            $('#Country').removeClass('error');
        }


        if ($('#Domain').val().trim() == '') {
            $('#Domain').addClass('error');
            return;
        }
        else {
            $('#Domain').removeClass('error');
        }

        if ($('#Domain').val().trim().indexOf('local')>-1) {
            $('#Domain').addClass('error');
            alert('Domain not available');
            return;
        }
        else {
            $('#Domain').removeClass('error');
        }

        if ($('input[type=checkbox]:checked').length == 0) {
            //$('#chkspan').addClass('error');
            $('.bi-info-circle').show().addClass('animation: shake 0.82s cubic-bezier(.36,.07,.19,.97) both;').delay(1500, function () {
                $(this).removeClass('animation: shake 0.82s cubic-bezier(.36,.07,.19,.97) both;')
            });;
            return;
        }
        else {
            $('.bi-info-circle').hide();
            $('#chkspan').removeClass('error');
        }

      

        var form = $('#signupform');
        var url = form.attr('action');
        $.post('/account/addweb', {
            'Domain': $('#Domain').val(),
            'FirstName': $('#FirstName').val(),
            'LastName': $('#LastName').val(),
            'Email': $('#Email').val(),
            'Phone': $('#Phone').val(),
            'NofEmp': $('#NoOfEmployees').val(),
            'CompanyName': $('#CompanyName').val(),
            'CountryID': $('#Country').val(),
            'JobTitle': $('#JobTitle').val()
        }
            , function (data) {
                alert(data); // show response from the php script.
                if (data.indexOf('Error') == -1) {
                    $('input').val('');
                    $('select').val('');
                }
            }
        );
    });
