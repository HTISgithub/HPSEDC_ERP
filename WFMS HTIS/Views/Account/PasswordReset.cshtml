
@{
    Layout = "~/Views/Shared/_layoutLogin.cshtml";
    ViewBag.Title = "Reset password";
    ViewBag.PageTitle = "Reset password";
    string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
}
<div class="container">
    <div class="row">
        <div class="col-md-2"><div id="sidebar" class=""></div></div>
        <div class="col-md-10">
            <div class="row titleArea">
                <div class="col-md-4 ">
                    <span class="page-title">@ViewBag.PageTitle</span>
                </div>
                <div class="col-md-8 " id="ActionbtnArea">
                    @*<a href="@siteUrl/admin/CountriesAdd" class="btn btn-info pull-right btnAdd">Add</a>*@

                </div>
            </div>
            <div class="row minHeight">
                <div class="col-md-6">
                    <table class="table table-form table-border-none">
                        <tr>
                            <td>New Password</td>
                            <td><input type="password" id="password" class="form-control" /></td>
                        </tr>
                        <tr>
                            <td>Confirm Password</td>
                            <td><input type="password" id="confirmpassword" class="form-control" /></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><input type="button" class="btnSubmit btn btn-danger" value="Submit" onclick="_changepassword()" /></td>

                            </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function _changepassword() {

        if ($('#password').val() == '') {
            alert("Error:Please Enter Password");
            return;
        }
        if ($('#confirmpassword').val() == '') {
            alert("Error:Please Enter Confirm Password");
            return;
        }
        if ($('#confirmpassword').val() != $('#password').val()) {
            alert("Error:Confirm Password Not Matched With New Password");
            return;
        }

        $('#ProgressImg').show();
        $('.btnSubmit').attr("disabled", "disabled");
        $.post('@siteUrl/account/_Changepassword',
              {
                  'EmpCode': '@ViewData["EmpCode"]',
                  'Password': $('#password').val(),
                  'RefDate':'@ViewData["RefDate"]'
              },
              function (result) {
                  $('.btnSubmit').removeAttr("disabled");
                  $('#ProgressImg').hide();
                  alert(result);
                  
                      window.location = '@siteUrl/home/';
                  
              }
            ); 
    }

</script>
