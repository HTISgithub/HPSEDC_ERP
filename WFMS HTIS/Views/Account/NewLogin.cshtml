@model Payroll.portal.Models.LoginViewModel
@using System.Data;
@{
    Layout = "~/Views/Shared/newloginlayout.cshtml";
}

<div class="container">
    <div class="row justify-content-center align-items-center g-0">

        <div class="col-lg-7 d-none d-lg-flex justify-content-end">
            <img src="~/assets/images/login/hero-img.png"
                 alt="Invoice Illustration"
                 class="img-fluid" style="max-width: 85%;">
        </div>

        <div class="col-lg-4 col-md-5 col-sm-8 col-10">
            <div class="card login-card-custom">
                <h4 class="heading-font montserrat">Welcome to the Portal !</h4>
                <p class="subtitle montserrat">Sign in to your account</p>

                <section id="loginForm">
                    @using (Html.BeginForm("NewLogin", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                        <div class="mb-3">
                            @Html.LabelFor(m => m.UserName, "User Name", new { @class = "form-label montserrat" })

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control montserrat", placeholder = "Enter your username" })
                            </div>
                            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, "Password", new { @class = "form-label montserrat" })

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control montserrat ", id = "password-field", placeholder = "Enter your password" })
                                <button class="btn btn-outline-secondary " type="button" id="togglePassword">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-2 text-start">
                            <a href="#" class="small montserrat">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold montserrat asubmitLogin">LOG IN</button>

                        <div class="text-center mt-3">
                            @*<span class="text-muted">Don't have an account? </span>*@
                            <a href="#" class="montserrat">Sign up to create a new account</a>
                        </div>

                        if (ViewData["error"] != null && !string.IsNullOrEmpty(ViewData["error"].ToString()))
                        {
                            <script>alert('@Html.Raw(ViewData["error"])');</script>
                        }
                    }
                </section>
            </div>
        </div>

    </div>
</div>



