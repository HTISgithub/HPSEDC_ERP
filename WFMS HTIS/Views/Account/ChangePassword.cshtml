
@{
    string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
    ViewBag.Title = "Change Password";
    ViewBag.PageTitle = "Change Password";
}


<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Account</a>
        </li>
        @*<li>
                <a href="#"> Sub Activity</a>
            </li>*@
        <li class="active">@ViewBag.PageTitle</li>
    </ul><!-- /.breadcrumb -->

</div>
@******************Breadcrumb End**************@


<div class="page-content">
    @*********Page Title************@

    <div class="page-header">
        @*<h1>
            @ViewBag.PageTitle
            <a class="btn btn-primary pull-right" onclick="OpenAddModel()"><i class="fa fa-plus"></i> Change Password</a>
        </h1>*@
    </div>
    @*********Page End************@

    @*********Page Content************@


<div class="modal fade" id="update-Country" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#00476a;color:white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="_view">
                    <div class="form-group row">
                            <div class="col-md-6 col-lg-6 col-sm-6">
                                <label>User Name</label><br />
                                @Html.Partial("_employeeBox")
                            </div>
                                              </div>
                    <div class="form-group row">
                    
                      
                        <div class="col-md-6 col-lg-6 col-sm-6">
                            <label>New Password</label> <br />
                            <input type="password" id="password" class="form-control" />
                        </div>
                                
                  
                        <div class="col-md-6 col-lg-6 col-sm-6">
                            <label>Confirm Password</label><br />
                            <input type="password" id="confirmpassword" class="form-control" />
                        </div>
                                
                           
                       
                    </div>
                </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                    <div class="col-md-8">
                        <div class="modelalert"></div>
                    </div>
                    <div class="col-md-2">
                        <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
    <script>
       var mEmpId = 0;
      $('.btnModalSubmit').click(function () {
          _changepassword(); 
      });
       function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }
         $('.modal-footer').show();
    function resetForm() {
        $('.cleartxt').val('');
        } 
        OpenAddModel();
         function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("Change Password");
        $('#update-Country').modal({
            show: 'false'
        });
mEmpId = $('#EmployeeId').val();
        isActive = 'Y'; 
    }
        function _changepassword() {
            if ($('#EmployeeId').val() == '') {
                $('.modelalert').html('Error:Please select Employee');

                return;
            }
            if ($('#password').val() == '') {

                $('.modelalert').html('Error:Please Enter Password');
                return;
            }


            if ($('#confirmpassword').val() == '') {
                $('.modelalert').html('Error:Please confirm Password');

                return;
            }
            if ($('#confirmpassword').val() != $('#password').val()) {
                $('.modelalert').html('Error:Password and confirm Password does not matched');

                return;
            }
            if (confirm("Are you sure to change password?")) {
                $('#ProgressImg').show();
                $('.btnSubmit').attr("disabled", "disabled");
                $.post('/account/_Changepassword',
                    {
                        'EmpId': $('#EmployeeId').val(),
                        'Password': $('#password').val(),
                        'RefDate': 'nolink'
                    },
                    function (data) {
                        //if (data.Error.indexOf("Error") > -1) {
                        //    $('.modelalert').html(data.Error);
                        //}
                        //else {

                           // var table = $('#myTable').DataTable();

                         //   var elmntCollection = createTblColmnBtns(data);

                            if (parseInt(mEmpId) > 0) {
                                $('.modelalert').html(data).delay(1000).queue(function () {
                                    $('.modelalert').dequeue();

                                    $('#update-Country').modal('hide');
                                       window.location = '/account/logout';
                                });
                              //  table.row(tableRow).data(elmntCollection).draw(false);
                            }
                            //else {
                            //    sr = table.rows().count() + 1;
                            //    console.log('sr=' + sr);
                            //    $('.modelalert').html("Record Save Sucessfully").delay(1000).queue(function () {
                            //        $('.modelalert').dequeue();
                            //        window.location = '/admin/country';
                            //        //countries(0);
                            //    });
                            //}
                      //  }
                        $('.btnModalSubmit').removeAttr("disabled");
                        $('#ModalProgress').hide();
                    });
            }
        }

          
    

    </script>
