    function applySelect2Styling() {
        // Apply styling to Select2 options based on data attributes
        $('#consigneeAddressDdl').on('select2:open', function () {
            setTimeout(function () {
                $('.select2-results__option').each(function () {
                    var $option = $(this);
                    var originalOption = $('#consigneeAddressDdl option[value="' + $option.attr('aria-describedby') + '"]');
                    var status = $('#consigneeAddressDdl option').eq($option.index()).attr('data-status');

                    if (status === 'partial') {
                        $option.css({
                            'background-color': '#FFA500',
                            'color': '#FFFFFF'
                        });
                    } else if (status === 'complete') {
                        $option.css({
                            'background-color': '#008000',
                            'color': '#FFFFFF'
                        });
                    }
                });
            }, 50);
        });
    }

