    var productListState = {
        page: 1,
        size: 10,
        term: ''
    };


    function ProductDeliveryList(pageNumber, pageSize, searchTerm) {


        productListState.page = pageNumber;
        productListState.size = pageSize;
        productListState.term = searchTerm;


        var scrollTop = $('#ProductDeliveryModal .modal-body').scrollTop();

        $('#ProgressImg').show();

        $.post('/HardwareInvoice/GetConsigneeAddressOptimized', {
            'OrderDetailId': 0,
            'PurchaseOrderNo': PurchaseNoId,
            'consigneeAddress': '',
            'PageNumber': productListState.page,
            'PageSize': productListState.size,
            'SearchTerm': productListState.term
        }, function (data) {
            $('#ProgressImg').hide();


            try {
                var obj = JSON.parse(data);
                if (!obj || obj.length === 0) {
                    ProductTempTable.clear().draw();
                    $('.pagination-container').remove();
                    $('#addProductTemp_info').html('No records found.');
                    return;
                }

                ProductTempTable.clear();

                var msr = ((productListState.page - 1) * productListState.size);

                var totalRecords = obj[0].TotalRecord || 0;
                var totalPages = Math.ceil(totalRecords / productListState.size);

                $.each(obj, function (key, value) {

                    let podfile = 'File not<br/> uploaded';
                    if (value.Document !== 'N') {
                        podfile = `<div style="text-align:center;"><a href="/ProofOfDelivery/${value.Document}" target="_blank" data-toggle="tooltip" title="Download file" style="font-size:30px;"><i class="fa fa-download"></i></a></div>`;
                    }

                    let irfile = 'File not<br/> uploaded';
                    if (value.Document2 !== 'N' && value.Document2 !== '') {
                        irfile = `<div style="text-align:center;"><a href="/InstallationReport/${value.Document2}" target="_blank" data-toggle="tooltip" title="Download file" style="font-size:30px;"><i class="fa fa-download"></i></a></div>`;
                    }

                    let deliveredQty = (value.DeliveredQty != 0) ? value.DeliveredQty : 'Not Delivered yet';
                    msr++;

                    let DeleteButton = `<a onclick="DeletePod('${value.OrderDeliveryId}','${value.DeliveryId}')" style="cursor:pointer;"><div style="text-align:center;"><i class="fa fa-trash-o" style="font-size:28px;color:red"></i></div></a>`;
                    if ((value.Document === 'N') && (value.Document2 === 'N')) {
                        DeleteButton = '---';
                    }

                    const podcheckbox = `<input type="checkbox" class="podcheckbox" id="podVerification">`;
                    const ircheckbox = `<input type="checkbox" class="ircheckbox" id="irVerification">`;
                    const submitVerifycheck = `<button class="btn btn-primary btn-sm submitVerifycheckdata" onclick="SubmitVerificationDetail(this,${value.OrderDeliveryId},${value.DeliveryId})">Verify</button>`;

                    // --- 3. Avoiding Code Duplication (DRY Principle) ---
                    let elmntArray = [
                        msr,
                        value.ProductName,
                        `${value.ConsigneeName}, ${value.consigneeAddress}`,
                        deliveredQty,
                        value.ConsigneeContactNo,
                        podfile,
                        irfile
                    ];

                    if (@user == '55') {
                        elmntArray.push(DeleteButton);
                    }

                    elmntArray.push(podcheckbox, ircheckbox, submitVerifycheck);
                    // --- End of DRY block ---

                    const rowNode = ProductTempTable.row.add(elmntArray).draw(false).node();
                    const $row = $(rowNode);
                    const isPOD = value.IsPOdVerified === 'Y';
                    const isIR = value.IsIRVerified === 'Y';

                    $row.find('.podcheckbox').prop({ 'checked': isPOD, 'disabled': isPOD });
                    $row.find('.ircheckbox').prop({ 'checked': isIR, 'disabled': isIR });
                    $row.find('.submitVerifycheckdata').prop('disabled', isPOD && isIR);
                });

                // Restore scroll position
                $('#ProductDeliveryModal .modal-body').scrollTop(scrollTop);

                if (totalRecords > 0) {
                    createPaginationControls(totalRecords, totalPages);
                }

            } catch (e) {
                console.error("Failed to parse JSON or process data:", e);
                $('#addProductTemp_info').html('Error loading data.');
            }
        });
    }


    function createPaginationControls(totalRecords, totalPages) {
        // This function now reads from the global productListState object
        console.log('from paggination control');
        console.log(productListState);
        const { page, size, term } = productListState;

        let paginationdata;
        if (term && term.trim() !== '') {
            paginationdata = `Showing ${((page - 1) * size) + 1} to ${Math.min(page * size, totalRecords)} of ${totalRecords} entries (filtered)`;
        } else {
            paginationdata = `Showing ${((page - 1) * size) + 1} to ${Math.min(page * size, totalRecords)} of ${totalRecords} entries`;
        }

        // --- Using Template Literals for the search box ---
        const paginationSearch = `
            <div class="search-box">
                <input type="text" id="searchInput" class="form-control search-input" placeholder="Search..." autocomplete="off" value="${term}">
                <button type="button" class="clear-search" onclick="clearSearch()" title="Clear search">
                    <i class="fas fa-times"></i>
                </button>
            </div>`;

        let paginationHtml = '';
        // Previous button
        if (page > 1) {
            paginationHtml += `<button onclick="ProductDeliveryList(${page - 1}, ${size}, '${term}')" class="btn btn-sm btn-primary" style="margin: 0 2px;">Previous</button>`;
        }

        // Page numbers logic (remains the same)
        var startPage = Math.max(1, page - 2);
        var endPage = Math.min(totalPages, page + 2);

        if (startPage > 1) {
            paginationHtml += `<button onclick="ProductDeliveryList(1, ${size}, '${term}')" class="btn btn-sm btn-outline-primary" style="margin: 0 2px;">1</button>`;
            if (startPage > 2) paginationHtml += '<span style="margin: 0 5px;">...</span>';
        }

        for (let i = startPage; i <= endPage; i++) {
            const activeClass = i === page ? 'btn-primary' : 'btn-outline-primary';
            paginationHtml += `<button onclick="ProductDeliveryList(${i}, ${size}, '${term}')" class="btn btn-sm ${activeClass}" style="margin: 0 2px;">${i}</button>`;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) paginationHtml += '<span style="margin: 0 5px;">...</span>';
            paginationHtml += `<button onclick="ProductDeliveryList(${totalPages}, ${size}, '${term}')" class="btn btn-sm btn-outline-primary" style="margin: 0 2px;">${totalPages}</button>`;
        }

        // Next button
        if (page < totalPages) {
            paginationHtml += `<button onclick="ProductDeliveryList(${page + 1}, ${size}, '${term}')" class="btn btn-sm btn-primary" style="margin: 0 2px;">Next</button>`;
        }

        // Remove existing pagination and add new one
        $('.pagination-container').remove();
