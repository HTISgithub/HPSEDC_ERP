    function PurchaseOrderDetailList() {
    var RoleId = @Session["RoleId"];


    var scrollTop = $('.page-content').scrollTop();
    var table = $('#myTable').DataTable();
    var currentPage = table.page();
        var agencyid = $('#ddlAgencyFilter').val() || 0;
