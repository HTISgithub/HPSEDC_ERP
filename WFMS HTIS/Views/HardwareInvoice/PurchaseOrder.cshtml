    function initializeTabs() {

        $('#myTab .nav-link').removeClass('active').attr('aria-selected', 'false');
        $('.tab-content .tab-pane').removeClass('show active');


        $('#home-tab').addClass('active').attr('aria-selected', 'true');
        $('#pod_tab').addClass('active show');


        $('#profile-tab').removeClass('active').attr('aria-selected', 'false');
        $('#ir_tab').removeClass('active show');


    }


    function switchToTab(tabId, paneId) {

        $('#myTab .nav-link').removeClass('active').attr('aria-selected', 'false');


        var currentPane = $('.tab-content .tab-pane.active');
        currentPane.removeClass('active show bounce-in flip-in zoom-fade');


        currentPane.addClass('slide-left');


        $(tabId).addClass('active').attr('aria-selected', 'true');


        setTimeout(function () {

            $('.tab-content .tab-pane').removeClass('active show bounce-in flip-in zoom-fade slide-left');


            var animations = ['bounce-in', 'flip-in', 'zoom-fade'];
            var randomAnimation = animations[Math.floor(Math.random() * animations.length)];

            $(paneId).addClass('active show fade ' + randomAnimation);



        }, 300);


        sessionStorage.setItem('activeTab', paneId);


    }


    function switchToTabWithAnimation(tabId, paneId, animationType) {
        $('#myTab .nav-link').removeClass('active').attr('aria-selected', 'false');


        var currentPane = $('.tab-content .tab-pane.active');
        currentPane.removeClass('active show bounce-in flip-in zoom-fade');

        $(tabId).addClass('active').attr('aria-selected', 'true');

        setTimeout(function () {
            $('.tab-content .tab-pane').removeClass('active show bounce-in flip-in zoom-fade slide-left');
            $(paneId).addClass('active show fade ' + animationType);
        }, 200);

        sessionStorage.setItem('activeTab', paneId);
    }

