    function getProductDeliveryIRdata() {
        var DeliveryData = [];
        var isValid = true;

        productIrTable.rows().every(function () {
            var row = $(this.node());

            if (row.find('.ir_upload_check').prop('checked')) {

                var data = {};

                data.OrderDeliveryId = row.find('.Ir_deliveryid').text();
                data.OrderDetailsId = row.find('.Ir_deliveryid1').text();
                DeliveryData.push(data);
            }
        });

        if (!isValid) {
            return 'failed';
        }


        if (DeliveryData.length == 0) {
            return 'notSelected';
        }

        return DeliveryData;
    }

    async function SubmitProductIRDelivery() {
        if ($('#consigneeAddressDdlIR').val() === 0) { alert('Please Select Address'); return; }

        var rawData = getProductDeliveryIRdata();
        if (rawData === 'failed') {
            return;
        }

        else if (rawData == 'notSelected') {
            alert('Please Select Product');
            return;
        }

        var data = JSON.stringify(rawData);
        var irFile = $('#irOnly')[0].files[0];
        if (!irFile) { alert("Please Choose IR File"); return; }
        $('#loader-overlay').show();
        var formData = new FormData();

        var timestamp = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);

        let consignee = $('#consigneeAddressDdlIR option:selected').text();
        let result = consignee.split(",");


        if (irFile) {
            var fileExtensionIr = irFile.name.split('.').pop();
            var newIrName = `IR_${result[0]}_${timestamp}.${fileExtensionIr}`;
            renamedIr = await new File([irFile], newIrName, { type: irFile.type });
            formData.append("IR", renamedIr);
        }

        formData.append("data", data);
        formData.append("PurchaseOrderid", PurchaseNoId);
        //formData.append("ItemDetailsIdTxt", '');

        $.ajax({
            url: '/HardwareInvoice/SubmitProductIRDelivery',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                $('#loader-overlay').hide();
                if (data.includes("Successfully") || data.includes("successfully")) {
                    ProductDeliveryList(productListState.page, productListState.size, productListState.term);
                    clearIr();
                }
                alert(data);
            },
            error: function (xhr, status, error) {
                $('#loader-overlay').hide();
                alert("Error: " + error);
            }
        });
    }

