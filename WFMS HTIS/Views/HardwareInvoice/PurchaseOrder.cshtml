<!--Purchase Bill Modal-->
<div class="modal fade" id="PurchaseModal" role="dialog">
    <div class="modal-dialog  modal-lg" style="width:75%;">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #000080; color: white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Purchase Order Detail</h4>
            </div>
            <div class="modal-body" style="overflow-y: auto; height: 75vh; ">
                <div class="box">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="">Purchase Bill Date</label>
                                <input class="form-control datepicker" id="purchaseBillDate" placeholder=" " data-val="true" type="datetime" value="@DateTime.Now.ToString("dd-MMM-yyyy")">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="">Sale Order No.</label>
                                <input type="text" class="form-control" id="workOrderNo" placeholder="Enter Order No." readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="">Purchase Order No.</label>
                                <input type="text" class="form-control" id="purchaseNo" placeholder="" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="">Bill From</label>
                                <select class="form-control" id="billForm" onchange="showAddress()">
                                    <option value="0">Select</option>
                                </select>
                                <label id="billforaddress"></label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Agency Name</label>
                                <input type="text" id="agencyName" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Department Name</label>
                                <input type="text" id="depName" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Billing Address</label>
                                <textarea type="text" class="form-control" id="billingAddress" placeholder="" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <label>Purchase Invoice No.</label>
                            <input type="text" id="invoiceNo" placeholder="Purchase Invoice No." class="form-control" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Purchase Invoice</label>
                            <input type="file" id="purchaseBill" class="form-control-file" />
                            <div class="mt-2 d-block" id="viewBillContainer">
                                <button id="viewBill" class="btn-sm btn btn-primary" onclick="ViewBill()">View</button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label>Naration</label>
                            <textarea class="form-control" id="naration" placeholder="Enter Naration"></textarea>
                        </div>

                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <table id="PurchaseTable" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Sr.</th>
                                    <th></th>
                                    <th>Product Name</th>
                                    <th>Bill Qty</th>
                                    <th>Quantity</th>
                                    <th>HSN Code</th>
                                    <th>Rate</th>
                                    <th>GST</th>
                                    <th>Total</th>
                                    <th>GTotal</th>
                                </tr>
                            </thead>
                            <tbody id="PurchaseTableTbody">
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="box" id="purchaseAmountBox" style="margin-top:10px">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label for="AgencyBill">Basic Bill Amount</label>
                            <input id="AgencyBill" class="form-control" placeholder="Base Amount" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="">IGST</label>
                            <input id="igst" class="form-control" placeholder="CGST" readonly value="0">
                        </div>
                        <div class="col-md-4">
                            <label for="Cgst">CGST</label>
                            <input id="cgst" class="form-control" placeholder="CGST" readonly value="0">
                        </div>

                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label for="SGST">SGST</label>
                            <input id="SGST" class="form-control " placeholder="SGST" readonly value="0">
                        </div>
                        <div class="col-md-4" hidden>
                            <label for="gst">GST</label>
                            <input id="GST" class="form-control" value=0 readonly>
                        </div>

                        <div class="col-md-4">
                            <label for="Total">Total Amount</label>
                            <input id="Total" class="form-control " placeholder="Total" readonly>
                        </div>
                    </div>
                </div>


            </div>


            <div class="modal-footer">

                <div class="row">

                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>

                    <div class="col-md-8">

                        <div class="modelalert"></div>

                    </div>

                    <div class="col-md-2">

