        $('#ProgressImg').hide();
        var obj = $.parseJSON(data);
        table.clear().draw();

        var msr = 0;
        var DeliveryLocationDoc;
        var amount;
        var ProductDeliveryBtn;

        $.each(obj, function (key, value) {
            var PurchaseBtn = '';
            var SaleBillBtn = '';
            var purchaseBtnColor = "";

            if (value.IsInvoiceGenerated == 'Y') purchaseBtnColor = "#008000";
            else if (value.IsInvoiceGenerated == 'P') purchaseBtnColor = "#FFA500";

            if (value.DeliveryStatus == 'N') {
                PurchaseBtn = `<button class="btn btn-secondary disabled">Agency Invoice</button>`;
                SaleBillBtn = `<button class="btn btn-secondary disabled">Sale Invoice</button>`;
            } else {
                SaleBillBtn = `<button class="btn btn-primary btn-sm" onclick="OpenSaleBillModel('${value.SaleOrderId}','${value.PurchaseOrderNoId}')">Sale Invoice</button>`;
                PurchaseBtn = `<button class="btn btn-primary btn-sm" style="background:${purchaseBtnColor} !important;border-color:${purchaseBtnColor} !important; color:white" onclick="OpenPurchaseInvoiceModal('${value.PurchaseOrderNoId}','${value.IsInvoiceGenerated}')">Agency Invoice</button>`;
            }

            let orderDetailBtn = `
                <a onclick="OpenOrderDetailModal('${value.PurchaseOrderNoId}')" title="View Details">
                    <i class="fa fa-eye fa-2x" aria-hidden="true" style="font-size:30px;"></i>
                </a>`;

            let deliveryColor = value.DeliveryStatus == 'Y' ? '#28a745' :
                                value.DeliveryStatus == 'P' ? '#FFA500' : '#6c757d';

            if (RoleId == '55') {
                ProductDeliveryBtn = `<a onclick="OpenProductDeliveryModal('${value.PurchaseOrderId}','${value.PurchaseOrderNoId}', '${value.SaleOrderId}', '${value.DeliveryId}')" title="Product Delivery">
                     <i class="fas fa-truck" style="font-size: 30px; color: ${deliveryColor};"></i>
                 </a>`;
            } else {
                ProductDeliveryBtn = `<a onclick="OpenProductDeliveryModal('${value.PurchaseOrderId}','${value.PurchaseOrderNoId}', '${value.SaleOrderId}', '${value.DeliveryId}')" title="Product Delivery">
                    <span class="material-symbols-outlined">inventory</span>
                </a>`;
            }

            DeliveryLocationDoc = (value.DeliveryAttachement)
                ? `<center><a href="/HWDeliveryDoc/${value.DeliveryAttachement}" target="_blank" data-toggle="tooltip" title="Download file" style="text-align:center; font-size:30px;"><i class="fa fa-download"></i></a></center>`
                : '<center><label class="text-center">-</label></center>';

            if (value.IGST == 'Y') {
                amount = `Basic : ₹${value.Total}<br/>IGST : ₹${value.Sgst + value.Cgst}<br/>TOTAL : ₹${value.GTotal}`;
            } else {
                amount = `Basic : ₹${value.Total}<br/>SGST : ₹${value.Sgst}<br/>CGST : ₹${value.Cgst}<br/>TOTAL : ₹${value.GTotal}`;
            }

            var ViewPurchaseInvoice = `<center><a onclick="OpenPurchaseInvViewModal('${value.PurchaseOrderNoId}')"><i class="fa fa-eye fa-2x" aria-hidden="true" style="font-size:30px;"></i></a></center>`;
            var ViewSaleInvoice = `<center><a onclick="OpenSaleInvViewModal('${value.PurchaseOrderNoId}')"><i class="fa fa-print fa-2x" aria-hidden="true" style="font-size:30px;"></i></a></center>`;
            var AgencyPaymentBtn = `<button onclick="OpenPaymentModal('${value.PurchaseOrderNoId}')" class="btn btn-primary btn-sm">Payment</button>`
            var annextureBtn = `<a onclick="printAnnextur('${value.SaleOrderId}','${value.PurchaseOrderNoId}','${value.PurchaseOrderDate}')" class="img-circle"><center><i class="fa-solid fa-print fa-2x"></i></center></a>`;
            var addlocation = `<a onclick="OpenDeliveryLocationModal('${value.PurchaseOrderNoId}','${value.SaleOrderId}')" class="img-circle"><center><i class="fa-solid fa-location-dot fa-2x"></i></center></a>`;
            msr++;
            var elmntArray = [];
            if (RoleId == '55') {
                 elmntArray = [
                    msr,
                    value.PurchaseOrderNoId + '<br>' + value.PurchaseOrderDate,
                    value.departmentName,
                    value.AgencyName,
                    amount,
                     DeliveryLocationDoc,
                     addlocation,
                     `<center>${orderDetailBtn}</center>`,
                     annextureBtn,
                    `<center>${ProductDeliveryBtn}</center>`,
                    PurchaseBtn,
                    ViewPurchaseInvoice
                ];
            }
            else if (RoleId == '56') {
                 elmntArray = [
                    msr,
                     value.PurchaseOrderNoId + '<br>' + value.PurchaseOrderDate,
                     value.HWSaleOrderNo,
                     value.SaleInvNo,
                    value.departmentName,
                    value.AgencyName,
                    amount,
                    DeliveryLocationDoc,
                    `<center>${orderDetailBtn}</center>`,
                     `<center>${ProductDeliveryBtn}</center>`,
                     annextureBtn,
                    ViewPurchaseInvoice,
                    SaleBillBtn,
                    ViewSaleInvoice,
                    /*AgencyPaymentBtn,*/
                ];
            }
            else if (RoleId == '61') {
                 elmntArray = [
                    msr,
                     value.PurchaseOrderNoId + '<br>' + value.PurchaseOrderDate,
                    value.HWSaleOrderNo,
                    value.departmentName,
                    value.AgencyName,
                     amount,
                     value.AdvanceAmt,
                    DeliveryLocationDoc,
                    `<center>${orderDetailBtn}</center>`,
                    `<center>${ProductDeliveryBtn}</center>`,
                    ViewPurchaseInvoice,
                    ViewSaleInvoice,
                    AgencyPaymentBtn,
                ];
            }

            table.row.add(elmntArray).draw(false);
        });
        table.page(currentPage).draw(false);
        $('.page-content').scrollTop(scrollTop);
    });
}



