    function CalculatePurchaseTotal(input, unitPrice,gtotal,gst) {

        var row = $(input).closest("TR");
        var bqty = row.find('.PBillqty').text()
        var qty = row.find('.purchase_qty').val();

        if (qty > bqty) {
            alert("Quantity can not be greater than Bill Qty");
            row.find('.purchase_qty').val('');
            return;
        }
        //else if (qty<1) {
        //    alert("Quantity can not be less than 1");
        //    row.find('.purchase_qty').val('');
        //    return;
        //}
        var total = qty * unitPrice;
        var gtotal = qty * gtotal;
        var gst = qty * gst;
        row.find('.purchase_totalAmount').html(total.toFixed(2));
        row.find('.Purchasegtotal').html(gtotal.toFixed(2));
        row.find('.purchasegstamount').html(gst.toFixed(2));
        getdataCalculateion();
    }

    function getdataCalculateion() {
       // alert('methd');
