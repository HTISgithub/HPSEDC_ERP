    function SubmitAgencyPayment() {
        if ($('#PurchaseinvoiceDdl').val() == 0) { alert('Please Choose Purchase Invoice'); return };
        if ($('#TransactionApp').val() == '') { alert('Please Enter Transaction Id'); return };
        if ($('#ModePaymentApp').val() == 0) { alert('Please Choose Mode of Payment'); return };
        if ($('#PaymentDateApp').val() == 0) { alert('Please Choose Payment Date'); return };
        if ($('#PaymentAmountApp').val() == '' || $('#PaymentAmountApp').val() == 0) { alert('Please Enter Payment Amount'); return };
        if ($('#GSTTDS1App').val() == '') { alert('Please Enter GST Amount'); return };
        if ($('#TDS1App').val() == '') { alert('Please Enter TDS Amount'); return };
        if ($('#PBG').val() == '') { alert('Please Enter PBG'); return };
        if ($('#Penalty').val() == '') { alert('Please Enter Penalty'); return };
        let narration;
        $('#RemarksApp').val() == '' ? narration = '' : narration = $('#RemarksApp').val();
        var totalpayamt = parseFloat($('#PaymentAmountApp').val()) + parseFloat($('#GSTTDS1App').val()) + parseFloat($('#TDS1App').val());

        if (totalpayamt > parseFloat($('#BalanceApp').val())) {
            alert('Payment Amount Should Not be greater than remmaining balance amount');
            return;
        }
        $.post('/HardwareInvoice/SubmitAgencyPayment',
            {
                'PaymentId': 0,
                'PruchaseInvId': $('#PurchaseinvoiceDdl').val() ,
                'PurchaseOrderNoId': AgencyPurchaseOrderNo,
