    function CalculateTotal(input,unitPrice,admincharge,gst) {
        var row = $(input).closest("TR");
        var pqty = row.find('.salepqty').text();
        var qty = row.find('.qty').val();
        if (qty > pqty) {
            alert('Quantity can not be greater than Purchase Qty');
            row.find('.qty').val('');
            return;
        }
        //var total = qty * (parseFloat(unitPrice) + parseFloat(admincharge));
        var total = qty * (parseFloat(unitPrice));
        var admin = qty * admincharge;
        var Gst = qty * gst;
        var gtotal = total + admin + Gst;
        //var gtotal = total + Gst;
        row.find('.totalAmount').html(total.toFixed(2));
        row.find('.adminsale').html(admin.toFixed(2));
        row.find('.gstsale').html(Gst.toFixed(2));
        row.find('.gtotalsale').html(gtotal.toFixed(2));
        getdataCalculationforsale();

    }

