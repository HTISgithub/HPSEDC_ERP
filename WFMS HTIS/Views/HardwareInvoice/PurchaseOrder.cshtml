                'PaymentDate': $('#PaymentDateApp').val(),
                'GstTds2': $('#GSTTDS1App').val(),
                'Tds1': $('#TDS1App').val(),
                'PaymentAmt': $('#PaymentAmountApp').val(),
                'PBG': $('#PBG').val(),
                'Penalty': $('#Penalty').val(),
            }, function (data) {
                alert(data);
                $('#AgencyPaymentForm')[0].reset();
                AgencypaymentList();
            }
        )
    }

