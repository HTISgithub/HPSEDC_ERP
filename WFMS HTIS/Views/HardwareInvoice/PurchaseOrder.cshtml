    function getdatapuechase() {
        var PurchaseInvDetail = new Array();
        var checkedcount = 0;
        $("#PurchaseTable TBODY TR").each(function () {
            var row = $(this);
            Purchase = {};

            if ($(this).find('input[type="checkbox"]').prop('checked') == true) {
                checkedcount++;
                if (row.find('.purchase_qty').val() == '' || row.find('.purchase_qty').val() == null) {
                    alert('Please Enter Quantity');
                    return;
                }
                else if (row.find('.purchase_qty').val() <1) {
                    alert('Quantity can not be less than 1');
                    return;
                }
                if (row.find('.hsnpurchase').val() == '' || row.find('.hsnpurchase').val() == null) {
                    alert('Please Enter HSN Code');
                    return;
                }
                Purchase.ProductId = row.find('.ProductId1').html();
                Purchase.Quantity = row.find('.purchase_qty').val();
                Purchase.HSNCode = row.find('.hsnpurchase').val();
                Purchase.Rate = row.find('.rate1').html();
                Purchase.GST = row.find('.Gst1').html();
                Purchase.AdminCharge = row.find('.AdminCharge').html();
                Purchase.Total = row.find('.purchase_totalAmount').html();
                //PurchaseInvDetail.Narration = row.find('.Narration').html();
                PurchaseInvDetail.push(Purchase);
            }

        });
        if (checkedcount > PurchaseInvDetail.length) {
            throw new Error("Bill Not Submit");
        }
        else if (PurchaseInvDetail.length > 0) {
            return PurchaseInvDetail;
        }
        else  {
            alert('Please select item details');
            retrun;
        }
    }

    function getdataSale() {
        var SaleInvDetail = [];
        var countcheck = 0;
        var isValid = true;

        saleinvoicetable.rows().every(function () {
            var row = $(this.node());

            if (row.find('.salecheckbox').prop('checked')) {
                countcheck++;
                if (row.find('.qty').val() == '' || row.find('.qty').val() == null) {
                    alert('Please Enter Quantity');
                    isValid = false;
                    return false;
                }
                else if (row.find('.qty').val()<1) {
                    alert('Quantity can not be less than 1');
                    isValid = false;
                    return false;
                }
                if (row.find('.hsnsale').val() == '' || row.find('.hsnsale').val() == null) {
                    alert('Please Enter HSN Code');
                    isValid = false;
                    return false;
                }

                let Sale = {};
                Sale.ProductId = row.find('.productidsale').html();
                Sale.Quantity = row.find('.qty').val();
                Sale.HSNCode = row.find('.hsnsale').val();
                Sale.Rate = row.find('.ratesale').html();
                Sale.GST = row.find('.gstsale').html();
                Sale.AdminCharge = row.find('.adminsale').html();
                Sale.Total = row.find('.totalAmount').html();

                SaleInvDetail.push(Sale);
            }
        });

        if (!isValid) return;
        if (countcheck > SaleInvDetail.length) {
            throw new Error('Bill Not Submit');
        }
        else if (SaleInvDetail.length > 0) {
            return SaleInvDetail;
        }
        else {
            alert('Please select item details');
            return;
        }
    }

    function SubmitPurchaseBill() {

        var narration = "...."
        if ($('#billForm').val() == '0') { alert('Please Select Bill From'); return; }
        if ($('#invoiceNo').val() == '') { alert('Please enter Purchase Invoice No.'); return; }
        if ($('#purchaseBill').val() == '') { alert('Please Upload Purchasse Invoice Document'); return; }
        if ($('#naration').val() != '') { narration = $('#naration').val(); }
        try {
            var purchaseData = getdatapuechase();
            if (!purchaseData) return;
            var data = JSON.stringify(purchaseData);
        }
        catch (e) {
            alert(e.message);
            return;
        }
        $('#loader-overlay').show();

             var formData = new FormData();
            formData.append("RequestDetails", data);
            formData.append("PInvId",0);
            formData.append("InvNo", $("#invoiceNo").val());
            formData.append("SaleOrderNo", $('#workOrderNo').val());

            formData.append("AgencyBillingId", $("#billForm").val());
            formData.append("PurchaseOrderNo", $("#purchaseNo").val());
            formData.append("InvDate", $("#purchaseBillDate").val());
            formData.append("Narration", $('#naration').val());

           formData.append("TotalAmount", $("#AgencyBill").val());
           formData.append("IgstAmount", $('#igst').val());
           formData.append("CgstAmount", $("#cgst").val());
           //formData.append("CgstAmount",0);
           //formData.append("SgstAmount", 0);
           formData.append("SgstAmount", $("#SGST").val());
           formData.append("GrandTotal", $("#Total").val());


           var originalFile = $('#purchaseBill')[0].files[0];
           var agencyName = $('#agencyName').val().trim().replace(/\s+/g, '_');
           var purchaseOrderNo = $('#purchaseNo').val();
           var timestamp = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);

           var fileExtension = originalFile.name.split('.').pop();
           var newFileName = `${agencyName}_${purchaseOrderNo}_${timestamp}.${fileExtension}`;

           var renamedFile = new File([originalFile], newFileName, { type: originalFile.type });

            formData.append("PurchaseBill", renamedFile);


        $.ajax({
            url: '/HardwareInvoice/SubmitPurchaseBill1',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                $('#loader-overlay').hide();
