<style>
    .modal-footer {
        display: block;
    }


    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    label {
        font-weight: 800;
    }

        label[for="IsActive"] {
            position: relative;
            padding-left: 35px;
            cursor: pointer;
            display: inline-block;
            font-size: 18px;
            color: #333;
        }

            /* Create a custom checkbox square for only this specific checkbox */
            label[for="IsActive"]:before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 22px;
                height: 22px;
                border: 2px solid #4CAF50;
                background-color: #fff;
                border-radius: 4px;
                transition: background-color 0.3s, border 0.3s;
            }

    /* Checkbox checked state */
    #IsActive:checked + label[for="IsActive"]:before {
        background-color: #4CAF50;
        border-color: #4CAF50;
    }

    /* Checkmark (visible when checked) */
    #IsActive:checked + label[for="IsActive"]:after {
        content: "✔";
        position: absolute;
        left: 4px;
        top: 0;
        color: white;
        font-size: 16px;
    }

    #IsActive {
        display: none;
    }
</style>
<div class="page-content">
    @*********Page Title************@
    <div class="page-header">
        <h1 style="text-align:center;">
            @ViewBag.PageTitle
            <a class="btn btn-primary pull-right btnAddModal" onclick="OpenAddModel()"><i class="fa fa-plus"> </i>  ADD Product Details</a>
        </h1>
    </div>
    @*********Page End************@

    @*********Page Content************@
    <div class="row">
        <div class="col-md-12">
            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>MainCategory</th>
                                <th>Product Name</th>
                                @*<th>Image</th>*@
                                <th class="editcol actionstatus">Is Active</th>
                                <th class="editcol actionedit">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <!-- Modal -->
    <div class="modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #0f1875; color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <div id="_view">
                        <div class="form-group row">


                            <div class="col-md-6">
                                <label for="Main">Main Category</label><span class="error-message">*</span>
                                <select id="MainCategory" class="form-control clearddl" style="width:180px;">
                                </select>


                            </div>
                            <div class="col-md-6">
                                <label for="Tittle">Product Name</label><span class="error-message">*</span>
                                <input type="text" id="Tittle" class="form-control" placeholder="Product Name">
                            </div>



                        </div>

                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Image">Image</label>
                                <input type="file" name="file" id="Attachment" onchange="showFileName(this)" />
                                @*<p id="fileName"></p>*@
                                @*<img id="imgId" style="display:none; max-width: 90px;" />*@
                            </div>


                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <input type="checkbox" id="IsActive">
                                <label for="IsActive" style=" margin-top: 1rem;">Is Active</label>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <img src="" style=" width: 95px; display:none;" id="imgId" />
                            </div>
                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                        <div class="col-md-8">
                            <div class="modelalert"></div>
                        </div>
                        <div class="col-md-2">
                            <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

<script>
    var vId = 0, accessRights;
    var IsActive = 'Y';

    $(document).ready(function () {
        TableManageDefault.init();
        _HardwareProductCategoryList();
    });

    $('.btnModalSubmit').click(function () {
        _HardwareProductCategorySubmit();
    });

    function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("Add Product Category");
        $('#myModal').modal({
            show: true
        });

        vId = 0;
        IsActive = 'Y';
    }



    function fillForm() {
        $('#ModalProgress').show();
        $('.modelalert').html('Please wait');
        $.post('/HardwareInvoice/_HardwareProductCategoryEdit', {
            'Id': vId,
        }, function (data) {
            $('#ModalProgress').hide();
            $('.modelalert').html('');
            var obj = $.parseJSON(data);
            console.log(obj);
            $('#MainCategory').val(obj[0].MainCatgName).trigger('change');
            $('#Tittle').val(obj[0].Title);

            $('#imgId').css("display", "block");
            $('#imgId').attr("src", "/PCategory/" + obj[0].Attachement);


            $('#fileName').text(obj[0].Attachement);

            if (obj[0].IsActive == 'Y') {
                $('#IsActive').prop('checked', true);
            } else {
                $('#IsActive').prop('checked', false);
            }
            IsActive = 'Y';
        });
    }

    // Function to display the file name and preview the selected image
    function showFileName(input) {
        if (input.files && input.files[0]) {
            var fileName = input.files[0].name;
            $('#fileName').text("Selected file: " + fileName);

            // Display image preview
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#imgId').css("display", "block");
                $('#imgId').attr("src", e.target.result);
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function OpenUpdateModel(Id, atag, status) {

        resetModal();
        resetForm();
        $('.modal-title').html("Update Product Category");
        $('#myModal').modal({
            show: 'false'
        });
        tableRow = $(atag).parents('tr');
        var tableRowColumnsData = $('#myTable').DataTable().row(tableRow).data();

        vId = Id;
        fillForm();
        sr = tableRowColumnsData[0];
        root = '/HardwareInvoice/_HardwareProductCategorySubmit';
        $('.modal-footer').show();

    }


    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('#Tittle').val('');
        $('#MainCategory').val('0');
        $('#Attachment').val('');
        $('.clearddl').val('0').trigger('change');
        $('#IsActive').prop('checked', false);
        $('.modelalert').html('');
    }

    function _HardwareProductCategoryList() {

        $('#ProgressImg').show();
        $.post('/HardwareInvoice/_HardwareProductCategoryList', { 'Id': 0 }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                var imageHtml = '<img src="/PCategory/' + value.Attachement + '" alt="Image" style="width:60px; height:60px;" />';

                msr += 1;
                var btnStatus = '<label><input name="switch-field-1" id=' + value.Id + ' class="ace ace-switch ace-switch-2 chk" onchange="changeActiveStatus(' + value.Id + ')" type="checkbox" ' + (value.IsActive == "Y" ? "checked='checked'" : "") + ' /><span class="lbl"></span></label>';
                var btnEdit = '<a href="#" onclick="OpenUpdateModel(' + value.Id + ', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';

                var elmntArray = [
                    msr,
                    value.MainCatgName,
                    value.Title,
                    //imageHtml,
                    //value.IsActive,
                    btnStatus,
                    btnEdit

                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }
    function changeActiveStatus(Id) {
        var status = 'N';
        if ($('#' + Id).is(':checked')) {
            status = 'Y';
        }
        switcStatus('/HardwareInvoice/_HardwareProductStatusUpdate', Id, status);
    }


    function _HardwareProductCategorySubmit() {

        var WorkOfferAtt = $("#Attachment").get(0);
        var files = WorkOfferAtt.files;

        if ($('#MainCategory').val() == '') {
            $('.modelalert').html('Please Select Main Category');
            return;
        }
        if ($('#Tittle').val() == '') {
            $('.modelalert').html('Please Enter Title');
            return;
        }

        if ($('input[type=checkbox]:checked').length === 0) {
            alert("Please check IsActive");
            return;
        }

        var formData = new FormData();
        $.each(files, function (key, value) {
            formData.append("Attachment", files[key]);
        });

        formData.append("Tittle", $("#Tittle").val());
        formData.append("MainCatgId", $("#MainCategory").val());
        formData.append("IsActive", IsActive);
        formData.append("Id", vId);

        $.ajax({
            type: "POST",
            url: "/HardwareInvoice/_HardwareProductCategorySubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                alert(data);
                if (data.indexOf('Error') > -1) {
                    $('.modelalert').html(data);
                } else {
                    
                    $('#myModal').modal('hide');
                    resetForm();
                    resetModal();
                    _HardwareProductCategoryList();

                    
                }
            }
        });
    }


    PMainCategory_ddl();
    function PMainCategory_ddl() {
        $.post('/HardwareInvoice/PMainCategory_ddl', {
            'Id': 0
        }, function (data) {
            var MainCategory = '<option value="0">-Select-</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                MainCategory += '<option value="' + value.Id + '">' + value.MainCatgName + '</option>';
            });
            $('#MainCategory').html(MainCategory);
        });

        $('#MainCategory').select2({
            dropdownParent: $('#myModal')
        });
    }

</script>

