
@using System.Data
@{
    ViewBag.Title = "Add Brand";
    ViewBag.PageTitle = "Add Brand";
    commonFunctions comfun = new commonFunctions();
}

@******************Breadcrumb Start**************@

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>

        <li class="active">@ViewBag.PageTitle</li>
    </ul>
</div>
@******************Breadcrumb End**************@
<style>
    .modal-footer {
        display: block;
    }


    body {
        font-family: "Jost", sans-serif;
    }


    table {
        border-radius: 5px;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    label {
        font-weight: 800;
    }

        label[for="IsActive"] {
            position: relative;
            padding-left: 35px;
            cursor: pointer;
            display: inline-block;
            font-size: 18px;
            color: #333;
        }

            /* Create a custom checkbox square for only this specific checkbox */
            label[for="IsActive"]:before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 22px;
                height: 22px;
                border: 2px solid #4CAF50;
                background-color: #fff;
                border-radius: 4px;
                transition: background-color 0.3s, border 0.3s;
            }

    /* Checkbox checked state */
    #IsActive:checked + label[for="IsActive"]:before {
        background-color: #4CAF50;
        border-color: #4CAF50;
    }

    /* Checkmark (visible when checked) */
    #IsActive:checked + label[for="IsActive"]:after {
        content: "✔";
        position: absolute;
        left: 4px;
        top: 0;
        color: white;
        font-size: 16px;
    }

    #IsActive {
        display: none;
    }
</style>
<div class="page-content">
    @*********Page Title************@
    <div class="page-header">
        <h1>
            @ViewBag.PageTitle
            <a class="btn btn-primary pull-right btnAddModal" onclick="OpenAddModel()"><i class="fa fa-plus"> </i>  ADD BrandName</a>
        </h1>
    </div>
    @*********Page End************@

    @*********Page Content************@
    <div class="row">
        <div class="col-md-12">
            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>Brand Name</th>
                                @*<th>Description</th>*@
                                <th class="editcol actionstatus">Is Active</th>
                                <th class="editcol actionedit">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <!-- Modal -->
    <div class="modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #0f1875; color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <div id="_view">
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Tittle">Brand Name</label><span class="error-message">*</span>
                                <input type="text" id="CompanyName" class="form-control" style="width: 578px; height: 28px" placeholder="Brand Name" name="Tittle">
                            </div>
                        </div>
                        @*<div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Description">Description</label>
                                <textarea id="Description" class="form-control cleartxt" style="width: 578px; height: 50px" placeholder="Please Enter Description Here"></textarea>
                            </div>
                        </div>*@
                        <div class="form-group row">

                            <div class="col-lg-6 col-md-3 col-sm-6">

                                <input type="checkbox" id="IsActive">
                                <label for="IsActive" style=" margin-top: 1rem;">Is Active</label>
                            </div>


                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                        <div class="col-md-8">
                            <div class="modelalert"></div>
                        </div>
                        <div class="col-md-2">
                            <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<script>
    var vId = 0;
    var IsActive = 'Y';

    $(document).ready(function () {
        TableManageDefault.init();
        _AddCompanyList();
    });

    $('.btnModalSubmit').click(function () {
        _AddCompanySubmit();
    });

    function OpenAddModel() {
        resetModal();
        resetForm();
        $('.modal-title').html("Add Brand Name");
        $('#myModal').modal({
            show: true
        });

        vId = 0;
        IsActive = 'Y';
    }

    function fillForm() {
        $('#ModalProgress').show();
        $('.modelalert').html('Please wait');
        $.post('/HardwareInvoice/_AddCompanyEdit', {
            'Id': vId,
        }, function (data) {
            $('#ModalProgress').hide();
            $('.modelalert').html('');
            var obj = $.parseJSON(data);
            console.log(obj);
            $('#CompanyName').val(obj[0].CompanyName);
            $('#Description').val(obj[0].Description);


            if (obj[0].IsActive == 'Y') {
                $('#IsActive').prop('checked', true);
            } else {
                $('#IsActive').prop('checked', false);
            }
            IsActive = 'Y';
        });
    }

    function OpenUpdateModel(Id, atag, status) {

        resetModal();
        resetForm();
        $('.modal-title').html("Update Company");
        $('#myModal').modal({
            show: 'false'
        });
        tableRow = $(atag).parents('tr');
        var tableRowColumnsData = $('#myTable').DataTable().row(tableRow).data();

        vId = Id;
        fillForm();
        sr = tableRowColumnsData[0];
        root = '/HardwareInvoice/_AddCompanySubmit';
        $('.modal-footer').show();

    }


    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('#Tittle').val('');
        $('#Description').val('');
        $('#IsActive').prop('checked', false);
        $('.modelalert').html('');
    }

    function _AddCompanyList() {
        $('#ProgressImg').show();
        $.post('/HardwareInvoice/_AddCompanyList',
            { 'Id': 0 },
            function (data) {
                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var table = $('#myTable').DataTable();
                table.clear().draw();
                var msr = 0;
                $.each(obj, function (key, value) {

                    msr += 1;
                    var btnStatus = '<label><input name="switch-field-1" id=' + value.Id + ' class="ace ace-switch ace-switch-2 chk" onchange="changeActiveStatus(' + value.Id + ')" type="checkbox" ' + (value.IsActive == "Y" ? "checked='checked'" : "") + ' /><span class="lbl"></span></label>';
                    var btnEdit = '<a href="#" onclick="OpenUpdateModel(' + value.Id + ', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';

                    var elmntArray = [
                        msr,
                        value.CompanyName,
                        //value.Description,
                        btnStatus,
                        btnEdit

                    ];
                    table.row.add(elmntArray).draw(false);
                });
            });
    }
    function changeActiveStatus(Id) {
        var status = 'N';
        if ($('#' + Id).is(':checked')) {
            status = 'Y';
        }
        switcStatus('/HardwareInvoice/_CompanyStatusUpdate', Id, status);
    }


    function _AddCompanySubmit() {

        if ($('#CompanyName').val() == '') {
            $('.modelalert').html('Please Enter Title');
            return;
        }
       
        if ($('input[type=checkbox]:checked').length === 0) {
            alert("Please check IsActive");
            return;
        }

        var formData = new FormData();

        formData.append("CompanyName", $("#CompanyName").val());
        formData.append("Description", $("#Description").val());
        formData.append("IsActive", IsActive);
        formData.append("Id", vId);

        $.ajax({
            type: "POST",
            url: "/HardwareInvoice/_AddCompanySubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                if (data.indexOf('Error') > -1) {
                    $('.modelalert').html(data);
                }

                else {
                    $('#myModal').modal('hide');
                    alert(data);
                    resetForm();
                    _AddCompanyList();
                }
            }
        });
    }
</script>

