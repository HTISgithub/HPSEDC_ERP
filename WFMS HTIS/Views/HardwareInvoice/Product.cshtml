@using System.Data
@{ // string siteUrl = System.Configuration.ConfigurationManager.AppSettings["SiteUrl"];
    ViewBag.Title = "Add Product";
    ViewBag.PageTitle = "Add Product";
    commonFunctions comfun = new commonFunctions(); }

@*******Breadcrumb Start*****@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />


<style>
    body {
        margin: 0;
        padding: 0;
        font-family: "Jost", sans-serif;
    }

    .page-header {
        margin: 0 0 12px;
        border-bottom: 1px dotted #E2E2E2;
        padding-bottom: 16px;
        padding-top: 7px;
        border: none;
    }

    table {
        border-radius: 5px;
    }

    h2 {
        font-family: "Jost", sans-serif !important;
        font-weight: 700;
    }

    h1 {
        font-family: "Jost", sans-serif !important;
    }

    th {
        background-color: #0f1875;
        border-radius: 5px;
        color: white;
        font-size: 15px
    }

    label {
        font-weight: 500;
    }

    button {
        font-family: "Jost", sans-serif !important;
    }

    label[for="IsActive"] {
        position: relative;
        padding-left: 35px;
        cursor: pointer;
        display: inline-block;
        font-size: 18px;
        color: #333;
    }

        /* Create a custom checkbox square for only this specific checkbox */
        label[for="IsActive"]:before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 22px;
            height: 22px;
            border: 2px solid #4CAF50;
            background-color: #fff;
            border-radius: 4px;
            transition: background-color 0.3s, border 0.3s;
        }

    /* Checkbox checked state */
    #IsActive:checked + label[for="IsActive"]:before {
        background-color: #4CAF50;
        border-color: #4CAF50;
    }

    /* Checkmark (visible when checked) */
    #IsActive:checked + label[for="IsActive"]:after {
        content: "✔";
        position: absolute;
        left: 4px;
        top: 0;
        color: white;
        font-size: 16px;
    }

    div.dt-buttons {
        position: relative;
        float: left;
        display: none;
    }

    .modal-content {
        border-top-left-radius: 16px !important;
        border-top-right-radius: 16px !important;
    }

    .modal-header {
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
    }

    .modal-footer {
        border-bottom-left-radius: 15px !important;
        border-bottom-right-radius: 15px !important;
    }

    #IsActive {
        display: none;
    }
</style>
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="#">Master</a>
        </li>

        <li class="active">@ViewBag.PageTitle</li>
    </ul>

</div>
@*******Breadcrumb End*****@


<div class="page-content">
    @****Page Title*****@

    <div class="page-header">
        <h1 style="text-align: center; font-weight: 500; margin-top: -42px; ">
            @ViewBag.PageTitle
            @*<a class="btn btn-primary pull-left btnAddModal" onclick="OpenAddModel()"><i class="fa fa-plus"> </i> Add Product</a>*@
        </h1>
        <a class="btn btn-primary pull-left btnAddModal" onclick="OpenAddModel()" style="">
            <i class="fa fa-plus"></i> ADD Product
        </a>
    </div>

    @****Page End*****@

    @****Page Content*****@
    <div class="row" style=" margin-top: -87px; ">
        &nbsp;
        <div class="col-md-12">
            <div align="left" id="Zones">
                <div class="dt-responsive">
                    <table class="table table-striped table-bordered" id="myTable">
                        <thead>
                            <tr>
                                <th class="widthsr">Sr.No.</th>
                                <th>Main Category Name</th>
                                <th>Product Name</th>
                                <th>Brand Name</th>
                                <th>Model No.</th>
                                <th>Price</th>
                                <th>G.Total</th>
                                <th>Specifications</th>
                                @*
                                    <th>Image</th>
                                    <th>Current Stock</th>*@
                                <th class="editcol actionstatus">Is Active</th>
                                
                                    <th class="editcol actionedit">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #00476a !important; color: white; ">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <div id="_view">
                        <div class="form-group row">

                            <div class="col-lg-4 col-md-4 col-sm-4">
                                <label for="Main">Main Category</label><span class="error-message">*</span>
                                <select id="MainCategory" class="form-control clearddl" style="width:180px;" >
                                </select>


                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-4">
                                <label for="Category">Product Name</label><span class="error-message">*</span>
                                <select id="CategoryId" class="form-control clearddl" style="width:180px;">
                                    @*
                                        <option value="0">--Select--</option>*@
                                </select>


                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-4">
                                <label for="cName" class="form-label" style="">Brand Name</label><span class="error-message">*</span>
                                <select id="cName" class="form-control clearddl" style="width:180px;">
                                </select>
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Model">Model No.</label><span class="error-message">*</span>
                                <input type="text" id="modelno" class="form-control cleartxt" placeholder="Model No." name="Mobile_No">


                            </div>
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="HSN">HSN Code</label>
                                <input type="text" id="HSN" class="form-control cleartxt" placeholder="HSN Code" name="Price" value="0" readonly>

                            </div>


                        </div>


                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Price">Price</label><span class="error-message">*</span>
                                <input type="text" id="pPrice" class="form-control cleartxt" placeholder="Price" name="Price" onchange="calculateAdminCharge()">

                            </div>

                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="HPSEDCCHARGE">HPSEDC Charges(%)</label><span class="error-message">*</span>
                                <input type="text" id="hcharge" class="form-control cleartxt" placeholder="HPSEDC Charges" onchange="calculateAdminCharge()">


                            </div>


                        </div>
                        <div class="form-group row">

                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="GST">GST(%)</label><span class="error-message">*</span>
                                <input type="text" id="GST" class="form-control cleartxt" placeholder="GST Charges" name="Mobile_No" onchange="calculateAdminCharge()">


                            </div>


                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Price">Grand Total</label>
                                <input type="text" id="gtotal" class="form-control cleartxt" placeholder="Grand Total" name="Price" >

                            </div>


                        </div>
                        <div class="form-grop row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Current">Current Stock</label>
                                <input id="currentStock" class="form-control " value="0" readonly>


                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="Dept">Specification</label><span class="error-message">*</span>

                                <textarea id="Specification" class="form-control cleartxt" name="DeptOfficeText" style="width:57rem" placeholder="Describe Product Specification here..."></textarea>
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-3 col-sm-6">
                                <label for="EmailId">Product Image</label>
                                <input type="file" id="Attachment" class="form-control cleartxt" name="Attachment" style="height:35px">


                            </div>

                            <div class="col-lg-6 col-md-3 col-sm-6" style="">
                                <img src="" style=" width: 95px; display:none;" id="imgId" />
                            </div>

                            <div class="col-lg-6 col-md-3 col-sm-6">

                                <input type="checkbox" id="IsActive">
                                <label for="IsActive" style=" margin-top: 4rem;">Is Active</label>



                            </div>

                        </div>






                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-2"> <img src="~/images/ajax-loader.gif" id="ModalProgress" /></div>
                    <div class="col-md-8">
                        <div class="modelalert"></div>
                    </div>
                    <div class="col-md-2">
                        <input type="button" class="btnModalSubmit btn btn-primary" value="Submit" />
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
<script>
    var mDesignationId = 0, mStateId = 0, mDistrictId = 0, mCityId = 0, OfficeId = 0, accessRights;
    var vId = 0;
    var mdll = 0;
    var mdll2 = 0;
    var sr = 0;

    var IsActive = 'Y';
    var tableRow;

    $(document).ready(function () {
        TableManageDefault.init();

        ProductList();

    });


    $('.btnModalSubmit').click(function () {

        ProductSubmit();
    });

    $('.modal-footer').show();

    function OpenAddModel() {
        resetModal();
        resetForm();
        PiMainCategory_ddl3();
        //PiProductCategory_ddl();
        $('.modal-title').html("Add Product");
        $('#myModal').modal({
            show: 'false'
        });
        IsActive = 'Y';
        root = '/HardwareInvoice/Product';
    }


    function resetModal() {
        $('.btnModalSubmit').removeAttr("disabled");
        $('#ModalProgress').hide();
        $('.modelalert').html('');
    }

    function resetForm() {
        $('.cleartxt').val('');
        $('.clearddl').val('0').trigger('change');

        $('.clearchk').val('');
    }

    function OpenUpdateModel(Id, atag, status) {

        resetModal();
        resetForm();
        PiMainCategory_ddl3();
        //PiProductCategory_ddl();
        $('.modal-title').html("Edit Product");
        $('#myModal').modal({
            show: 'false'
        });
        tableRow = $(atag).parents('tr');
        var tableRowColumnsData = $('#myTable').DataTable().row(tableRow).data();

        vId = Id;
        //PiProductCategory_ddl();
        fillForm();

        sr = tableRowColumnsData[0];
        root = '/HardwareInvoice/ProductSubmit';
        $('.modal-footer').show();

    }

    function changeActiveStatus(Id) {
        var status = 'N';
        if ($('#' + Id).is(':checked')) {
            status = 'Y';
        }
        switcStatus('/HardwareInvoice/ProductStatusUpdate', Id, status);
    }

    function ProductSubmit() {
        var WorkOfferAtt = $("#Attachment").get(0);
        var files = WorkOfferAtt.files;

        // Validation checks
        if ($('#MainCategory').val() == '0') {
            $('.modelalert').html('Please Select MainCategory');
            return;
        }

        if ($('#CategoryId').val() == '0') {
            $('.modelalert').html('Please Select Product Name');
            return;
        }
        if ($('#cName').val() == '0') {
            $('.modelalert').html('Please Select Company');
            return;
        }


        if ($('#pPrice').val() == '') {
            $('.modelalert').html('Please Enter Price');
            return;
        }

        if ($('#hcharge').val() == '') {
            $('.modelalert').html('Please Enter HPSEDC Charge');
            return;
        }
        if ($('#GST').val() == '') {
            $('.modelalert').html('Please Enter GST');
            return;
        }
        if ($('#Specification').val() == '') {
            $('.modelalert').html('Please Enter Specifications');
            return;
        }

        var IsActive = 'N';

        if ($('#IsActive').is(':checked')) {
            IsActive = 'Y';
        }

        var formData = new FormData();
        $.each(files, function (key, value) {
            formData.append("Attachment", files[key]);
        });
        formData.append("MainCategoryId", $("#MainCategory").val());
        formData.append("Category", $("#CategoryId").val());
        formData.append("Specification", $("#Specification").val());
        formData.append("HpsedcCharge", $("#hcharge").val());
        formData.append("Gst", $("#GST").val());
        formData.append("GrandTotal", $("#gtotal").val());
        formData.append("CompanyID", $("#cName").val());
        formData.append("ProductPrice", $("#pPrice").val());
        formData.append("CurrentStock", $("#currentStock").val());
        formData.append("modelno", $("#modelno").val());
        formData.append("HSNCode", $("#HSN").val());
        formData.append("IsActive", IsActive);
        formData.append("ProductId", vId);

        $.ajax({
            type: "POST",
            url: "/HardwareInvoice/ProductSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                alert(data);
                //alert("Record is inserted Successfully!")
                if (data.indexOf('Error') > -1) {
                    $('.modelalert').html(data);
                } else {

                    $('#myModal').modal('hide');
                   // $('.modelalert').html('');
                    resetModal();
                    resetForm();
                    ProductList();
                }
               
            }
        });
    }

    function fillForm() {
        $('#ModalProgress').show();
        $('.modelalert').html('Please wait');
        $.post('/HardwareInvoice/Product_Edit', {
            'Id': vId,
        }, function (data) {
            $('#ModalProgress').hide();
            $('.modelalert').html('');
            var obj = $.parseJSON(data);
            console.log(obj);
            $('#MainCategory').val(obj[0].MainCatgName).change();
            $('#cName').val(obj[0].CompanyName).trigger('change');
            $('#Specification').val(obj[0].Sepcification);
            $('#hcharge').val(obj[0].HPSEDCCharges);
            $('#gtotal').val(obj[0].GrandTotal);
            $('#currentStock').val(obj[0].CurrentStorck);
            $('#pPrice').val(obj[0].ProductPrice);
            $('#modelno').val(obj[0].ModelNo);
            $('#GST').val(obj[0].Gst);

            setTimeout(function () {
                $('#CategoryId').val(obj[0].TitleId).trigger('change');
            }, 1000);
            $('#imgId').css("display", "block");
            $('#imgId').attr("src", "/ProductImages/" + obj[0].ImageFile);

            if (obj[0].IsActive == 'Y') {
                $('#IsActive').prop('checked', true);
            }
            else {
                $('#IsActive').prop('checked', false);
            }
          
        });
    }

    function ProductList() {
        $('#ProgressImg').show();
        $.post('/HardwareInvoice/Product_List', { 'Id': 0 }, function (data) {
            $('#ProgressImg').hide();
            var obj = $.parseJSON(data);
            var table = $('#myTable').DataTable();
            table.clear().draw();
            var msr = 0;
            $.each(obj, function (key, value) {
                var imageHtml = '<img src="/ProductImages/' + value.ImageFile + '" alt="Image" style="width:60px; height:60px;" />';

                msr += 1;
                var btnStatus = '<label><input name="switch-field-1" id=' + value.Id + ' class="ace ace-switch ace-switch-2 chk" onchange="changeActiveStatus(' + value.Id + ')" type="checkbox" ' + (value.IsActive == "Y" ? "checked='checked'" : "") + ' /><span class="lbl"></span></label>';
                var btnEdit = '<a href="#" onclick="OpenUpdateModel(' + value.Id + ', this)" class="img-circle"><i class="fa fa-pencil-square fa-2x"></i></a>';

                var elmntArray = [
                    msr,
                    value.MainCatgName,
                    value.Title,
                    value.CompanyName,
                    value.ModelNo,
                    value.ProductPrice,
                    value.GrandTotal,
                    value.Sepcification,
                    // imageHtml,
                    //value.CurrentStorck,
                    btnStatus,
                    btnEdit

                ];
                table.row.add(elmntArray).draw(false);
            });
        });
    }

    
    function PiMainCategory_ddl3() {
        $.post('/HardwareInvoice/PiMainCategory_ddl3', {
            'Id': 0
        }, function (data) {
            var MainCategory = '<option value="0">-Select-</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                MainCategory += '<option value="' + value.Id + '">' + value.MainCatgName + '</option>';
            });
            $('#MainCategory').html(MainCategory);
        });

        $('#MainCategory').select2({
            dropdownParent: $('#myModal')
        });
    }

    $('#MainCategory').off('change').on('change', function () {
        PiProductCategory_ddl();
    });


    PiCompany_ddl();
    function PiCompany_ddl() {
        $.post('/HardwareInvoice/ProductCompany_ddl', { 'Id': 0 }, function (data) {
            var cName = '<option value="0">Select Company</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                cName += '<option value="' + value.Id + '">' + value.CompanyName + '</option>';
            });
            $('#cName').html(cName);
        });
        $('#cName').select2({
            dropdownParent: $('#myModal')
        });
    }



    
    function PiProductCategory_ddl() {
        
        $.post('/HardwareInvoice/PIPCategory_ddl', { 'Id': 0, 'MainCatgId': $('#MainCategory').val() }, function (data) {
            var CategoryId = '<option value="0">--Select Category--</option>';
            var obj = $.parseJSON(data);
            $('#ProgressImg').hide();
            $.each(obj, function (key, value) {
                CategoryId += '<option value="' + value.Id + '">' + value.Title + '</option>';
            });
            $('#CategoryId').html(CategoryId);
        });
        $('#CategoryId').select2({
            dropdownParent: $('#myModal')
        });
    }


  
    document.getElementById("pPrice").addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            calculateAdminCharge();
        }
    });



    function calculateAdminCharge() {
        var TotalPrice = parseFloat(document.getElementById("pPrice").value);
        var gstAmount = parseFloat(document.getElementById("GST").value);
        var hpsedcPercentage = parseFloat(document.getElementById("hcharge").value);


        var hpsedcCharge = TotalPrice * hpsedcPercentage / 100;
        var priceAfterHpsedc = TotalPrice + hpsedcCharge;
        var gstCharge = priceAfterHpsedc * gstAmount / 100;
        var GrandTotal = priceAfterHpsedc + gstCharge;
        //$("#gtotal").val(GrandTotal);
        $("#gtotal").val(Math.round(GrandTotal));

    }

</script>

