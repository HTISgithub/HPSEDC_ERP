    function getAddressdata() {
        var AddressDetail = [];
        var isValid = true;
        let Locationtable = $('#DeliveryLocationTableNew').DataTable();
        Locationtable.rows().every(function () {
            var row = $(this.node());

            if (row.find('.Pocheck1').prop('checked')) {

                var DeliveryQtyval = row.find('.qty').val();

                if (DeliveryQtyval === '0' || DeliveryQtyval === '') {
                    alert('No of Deliverd Qty can not be 0 or blank');
                    isValid = false;
                    return false;
                }

                var ItemData = {};
                ItemData.ItemDetailsId = row.find('.OrderDetailsId').html();
                ItemData.SaleOrderId = saledeliveryId ;

                ItemData.ProductId = row.find('.ProductId').html();
                ItemData.DeliveryQuantity = DeliveryQtyval;
                ItemData.DeliveredQty = 0;

                ItemData.ConsigneeName = $('#ConsigneeName1').val();
                ItemData.ConsigneeContactNo = $('#ContactNumber1').val();
                ItemData.DistrictId = $('#dlldist').val();
                ItemData.consigneeAddress = $('#consigneeAddress1').val();

                AddressDetail.push(ItemData);
            }
        });

        if (!isValid) {
            return 'failed';
        }

        if (AddressDetail.length == 0) {
            return 'notSelected';
        }

        return AddressDetail;

    }


    function checkQtyOnInput(inputElement) {
        var row = $(inputElement).closest("tr");
        let deliveryqty = parseInt(row.find('.qty').val()) || 0;
        let availableqty = parseInt(row.find('.availableqty').text());

        //console.log("Delivery:", deliveryqty);
        //console.log("Available:", availableqty);

        if (deliveryqty > availableqty) {
            alert('❌ Delivery Qty should not be greater than Available Qty!');
            row.find('.qty').val('');
        }
    }

