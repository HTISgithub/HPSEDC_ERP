                //DeliveryLocationTableNew.clear().draw();
                var msr = 0;

                $.each(obj, function (key, value) {

                    msr += 1;
                    let AvalibleQty =`<span class="availableqty"> ${value.OrderQty - value.DeliveryQty}</span>`;
                    var checkbox = `<input type="checkbox" class="Pocheck1"/>`;
                    var textbox = `<input type="text"  class="qty" oninput="checkQtyOnInput(this)"/>`;

