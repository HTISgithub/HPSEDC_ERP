    function _SaleOrderSubmit() {

        var data = JSON.stringify(getdata());


        var billingAddress;
        if ($("#DeptId").val() == "0") {
            alert("Please select Department");
            return;
        }
        if ($("#BillingId1").val() == "") {
            alert("Please Enter Billing Address");
            return;
        }
        if ($('#RefferenceNo').val() == "") {
            alert("Please Enter Reffernce Number");
            return;
        }
        if ($('#tblPurchase tbody tr').length == 0) {
            alert("Please Add Sale Item Detail");
            return;
        }
        if ($('#Attachement')[0].files.length === 0) {
            alert("Please Upload Department Document");
            return;
        }
        if ($('#DeliveryDocument')[0].files.length === 0) {
            alert("Please Upload Delivery Location Document");
            return;
        }
        if ($("#BillingId1").val() == '0') {
            billingAddress = $('#billingAddress').val();
        }
        else {
            billingAddress = $("#BillingId1 option:selected").text();
        }

        $('#loader-overlay').show();

        var attachmentFiles = $("#Attachement").get(0).files[0];
        var reffernceNo = $('#RefferenceNo').val().trim().replace(/\s+/g, '_');
        var deptId = $('#DeptId').val();
        var timestamp = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);

        var attachmentfileExtension = attachmentFiles.name.split('.').pop();
        var newAttachmentFileName = `SaleOrder_attachment_${deptId}_${reffernceNo}_${timestamp}.${attachmentfileExtension}`;
        var renamedattachedFile = new File([attachmentFiles], newAttachmentFileName, { type: attachmentFiles.type });

        var deliveryDocumentFiles = $("#DeliveryDocument").get(0).files[0];

        var deliveryDocfileExtension = deliveryDocumentFiles.name.split('.').pop();
        var newDeliveryDocName = `SaleOrder_deliveryDoc_${deptId}_${reffernceNo}_${timestamp}.${deliveryDocfileExtension}`;
        var renamedDeliveryDocFile = new File([deliveryDocumentFiles], newDeliveryDocName, { type: deliveryDocumentFiles.type });

        var formData = new FormData();


        formData.append("Attachement", renamedattachedFile);
        formData.append("DeliveryDocument", renamedDeliveryDocFile);



        formData.append("RequestDetails", data);
        formData.append("SaleOrderId", SaleOrderId);
        formData.append("SaleOrderNo", 0);
        formData.append("SaleOrderNoText", 0);
        formData.append("OrderDate", $("#OrderDate").val());

        formData.append("DeptId", $("#DeptId").val());
        formData.append("BillingAddressId", $("#BillingId1").val());
        formData.append("BillingAddressText", billingAddress);
        formData.append("ReferenceNo", $('#RefferenceNo').val());
        formData.append("DeliveryDate", $("#DeliveryDate").val());
        formData.append("Total", $("#TotalPrice").val());
        formData.append("Gst", $("#GST1").val());
        formData.append("Cgst", 0);
        formData.append("Sgst", 0);

        formData.append("PaymentAmt", 0);
        formData.append("Balance", 0);
        formData.append("IsPaymentRequired", IsActive1);
        formData.append("AdminCharge", $("#AdminCharge1").val());
        formData.append("Gtotal", $("#GrandTotal").val());


        $.ajax({
            type: "POST",
            url: "/HardwareInvoice/_SaleOrderSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
              $('#loader-overlay').hide();
