        var DeliverToData = row.find('#deliverTo').val();
        if (DeliverToData == "" && files.length == 0) {
            alert('Please Enter Deliver To Data and Select File to Upload');
        }
        else if (DeliverToData == "") {
            alert('Please Enter Deliver To Data');
        }
        else if (files.length == 0) {
            alert('Please Upload File');
        }
        else {
            var formData = new FormData();
            $.each(files, function (key, value) {
                formData.append("Attachment", files[key]);
            });
            formData.append("OrderDetailsid", OrderDetailsId);
            formData.append("DeliveryQty", DeliveryQty);
            formData.append("DeliveryTo", DeliverToData);
            $.ajax({
                type: "POST",
                url: "/HardwareInvoice/ProductDeliverySubmit",
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    alert(data);
                },

            });
        }
    }


