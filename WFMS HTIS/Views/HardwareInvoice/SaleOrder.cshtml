    function _HardwareAddressLocationSubmit() {

        if ($('#ConsigneeName1').val() == '') { alert('Please Enter Consignee Name !'); return; }
        if ($('#dlldist').val() == '0') { alert('Please Select District Name !'); return; }
        if ($('#consigneeAddress1').val() == '') { alert('Please Enter Address!'); return; }

        if (!$('.Pocheck1').is(':checked')) {
            alert('Please check the box !');
            return;
        }

        var rawData = getAddressdata();

        if (rawData === 'failed') {
            console.log('in if condition');
            return;
        }
        else if (rawData == 'notSelected') {
            alert('Please Enter Deliverd Qty !');
            return;
        }

        var data = JSON.stringify(rawData);

        var formData = new FormData();
        formData.append("OrderDeliveryId", 0); //$('#chalanddl').val();
        formData.append("AddressDetailData", data);

        $.ajax({
            type: "POST",
            url: "/HardwareInvoice/_HardwareAddressLocationSubmit",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                //if (data.includes("Successfully") || data.includes("successfully")) {
                //    ResetData();
                //}
                alert(data);
                //$('#ddlAgency').val("0").trigger('change');
                $('.Pocheck1').prop('checked', false);
                HardwareDeliveryAddressItemWise_List(saledeliveryId);
                HardwareDeliveryLocationList1(saledeliveryId);

            }
        });

    }


    function HardwareDeliveryLocationList1(SaleOrderId) {

        $('#ProgressImg').show();
        $.post('/HardwareInvoice/HardwareDeliveryLocationList',
            {
                'SaleOrderId': SaleOrderId,
                'PurchaseOrderId': 0

            },
            function (data) {

                $('#ProgressImg').hide();
                var obj = $.parseJSON(data);
                var DeliveryLocationTableNew1 = $('#DeliveryLocationTableNew1').DataTable(
                    {
                        destroy: true,
                        scrollY: "150px",
                        scrollX: true,
                        //scrollCollapse: true,
                        //paging: false
                    });

                DeliveryLocationTableNew1.clear().draw();
                var msr = 0;

                $.each(obj, function (key, value) {
                    var Deletebtn = '<div style="text-align:center;">' + '<a onclick="AddressconfirmDelete($(this),\'' + value.OrderDetailsId + '\')">' +
                        '<i class="fa fa-trash-o fa-2x" style="color:red;"></i>' + '</a></div>';
                    msr += 1;
                    var elmntArray = [
                        msr,
                        value.ProductName,
                        value.DeliveryQty,
                        value.ConsigneeName,
                        value.ConsigneeContactNo,
                        value.consigneeAddress,
                        Deletebtn,
                    ];
                    DeliveryLocationTableNew1.row.add(elmntArray).draw(false);
                });
            });
    }

