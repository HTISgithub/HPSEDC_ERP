                        checkbox,
                        value.OrderDetailsId,
                        value.ProductName,
                        value.OrderQty,
                        AvalibleQty,
                        //value.RestQty,
                        textbox

                    ];
                    Locationtable.row.add(elmntArray).draw(false);
                });
            });
